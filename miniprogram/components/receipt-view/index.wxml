<view wx:if="{{model}}" class="wrap {{model.style}}" style="{{model.style === 'card' || model.style === 'festive' ? 'background:' + model.color : ''}}">
  <view class="paper" style="{{model.style === 'longevity' || model.style === 'guofeng' ? '--rc:' + model.color : ''}}">
    <view wx:if="{{model.style === 'longevity'}}" class="wm" style="color:{{model.color}}">寿</view>
    <view wx:if="{{model.style === 'longevity'}}" class="band top" style="background:{{model.color}}"></view>
    <view wx:if="{{model.style === 'longevity'}}" class="band bottom" style="background:{{model.color}}"></view>
    <view wx:if="{{model.style === 'festive'}}" class="gold"></view>
    <view wx:if="{{model.style === 'ticket'}}" class="edge top" style="background:{{model.color}}"></view>

    <view class="title {{model.style === 'business' ? 'hd' : ''}}" style="{{model.style === 'business' ? 'background:' + model.color + ';color:#fff' : 'color:' + (model.style === 'simple' || model.style === 'elegant' ? '#333' : model.color)}}">{{model.title}}</view>
    <view wx:if="{{model.style === 'simple'}}" class="bar" style="background:{{model.color}}"></view>
    <view wx:if="{{model.style === 'elegant'}}" class="dbl"><view></view><view></view></view>

    <view class="amount">￥{{model.amount}}</view>
    <view class="paid">{{model.amountLabel}}</view>

    <view class="rows">
      <view class="row" wx:for="{{model.rows}}" wx:key="k">
        <text class="lbl">{{item.label}}</text>
        <text class="val">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{model.footer}}" class="footer">{{model.footer}}</view>

    <view wx:if="{{model.appCode}}" class="app-code">
      <image class="app-code-img" src="{{model.appCode}}" mode="aspectFit" show-menu-by-longpress />
      <view class="app-code-tip">{{model.appCodeTip}}</view>
    </view>

    <view wx:if="{{model.showStamp}}" class="stamp">
      <view class="stamp-name">{{model.stampText}}</view>
      <view class="stamp-text {{model.stampMain.length <= 1 ? 'one' : ''}}">{{model.stampMain}}</view>
    </view>

    <view wx:if="{{model.style === 'ticket'}}" class="edge bottom" style="background:{{model.color}}"></view>
  </view>
</view>
