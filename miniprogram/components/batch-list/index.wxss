.row { border: 2rpx solid #eee; border-radius: var(--r-s); padding: 18rpx; margin-bottom: 18rpx; }
.row-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.no { color: var(--text-2); font-size: 26rpx; }
.tag { margin-left: 10rpx; }
.del { color: var(--danger); font-size: 26rpx; }
.line { display: flex; margin-bottom: 12rpx; }
.line .amt, .line .remark { margin-left: 12rpx; }
.name { flex: 3; }
.amt { flex: 2; }
.rel { flex: 2; }
.rel-val { color: var(--text); }
.rel-val.ph { color: var(--text-3); }
.remark { flex: 4; }
.chips { margin-bottom: -2rpx; }
.add { color: var(--link); font-size: 28rpx; padding: 8rpx 0 16rpx; }
.total { text-align: right; font-size: 30rpx; color: var(--text); }
.total .num { font-weight: 700; color: #FF9F1C; }
.total .money { font-weight: 700; }
.head-r { display: flex; align-items: center; }
.head-r .del { margin-left: 20rpx; }
/* 转账+现金：每人支付方式用全局 .seg.seg-sm */
.total.split { font-size: 26rpx; color: var(--text-2); margin-top: 6rpx; }
