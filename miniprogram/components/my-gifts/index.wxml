<!-- 我的随礼记录（宾客页与往来页共用）：全部 / 已入簿 / 待确认 / 未收到 / 有变动，分页加载（v3.85.1） -->
<view class="mg">
  <view class="mg-seg-wrap">
    <scroll-view class="mg-seg" scroll-x enable-flex show-scrollbar="{{false}}" scroll-into-view="{{segTo}}" scroll-with-animation bindscroll="onSegScroll">
      <view id="mt-{{item.k}}" class="mg-seg-item {{tab === item.k ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="k" data-k="{{item.k}}" bindtap="onTab"><text class="mg-pill">{{item.t}}<text class="mg-dot" wx:if="{{item.dot}}"></text></text></view>
    </scroll-view>
    <view class="mg-seg-fade" wx:if="{{segFade}}"><text>›</text></view>
  </view>
  <view class="mg-sub" wx:if="{{tab === 'rejected'}}">近 30 天内、用当前微信登记的记录</view>
  <view class="mg-sub" wx:if="{{tab === 'changed'}}">近 30 天内主家修改、作废、申请更正的记录；申请更正需要你同意才生效</view>

  <view class="card mg-item" wx:for="{{rows}}" wx:key="_id" data-id="{{item._id}}" data-st="{{item.status}}" bindtap="onCard">
    <view class="mg-top">
      <text class="mg-shop ell">{{item.accountName || '主家'}}<text class="muted" wx:if="{{item.themeName}}"> · {{item.themeName}}</text><text class="mg-new" wx:if="{{item.isNew}}">新</text></text>
      <text class="mg-money {{item.status === 'void' || item.status === 'cancelled' ? 'mg-gray' : ''}} {{item.status === 'void' ? 'mg-strike' : ''}}">￥{{item.amountStr}}</text>
    </view>
    <view class="muted">{{item.status === 'paid' || item.status === 'void' || item.status === 'rejected' ? item.timeStr : item.regStr}} · 随礼人 {{item.payerName}}<text class="mg-amended" wx:if="{{item.amended}}"> · 已更正</text></view>
    <view class="mg-st {{item.status === 'paid' ? '' : (item.status === 'transferred' || item.status === 'pending' ? 'warn' : (item.status === 'cancelled' ? '' : 'bad'))}} {{item.funeral ? 'fun' : ''}}" wx:if="{{item.status !== 'paid'}}">{{item.stText}}<text wx:if="{{item.status === 'rejected' || item.status === 'void'}}">（{{item.timeStr}}）</text><text class="mg-more">{{openId === item._id ? '收起 ▴' : '详情 ▾'}}</text></view>

    <!-- 已更正的修改经过 -->
    <view class="mg-tl mg-chg" wx:for="{{item.changes}}" wx:for-item="t" wx:key="atStr" wx:if="{{item.status === 'paid'}}"><text class="mg-tl-t">{{t.atStr}}</text>{{t.text}}</view>

    <!-- 主家申请更正：同意后才生效 -->
    <view class="mg-corr" wx:if="{{item.corr}}" catchtap="noop">
      <view class="mg-st warn">主家申请{{item.corr.what}}</view>
      <view class="mg-reason">理由：{{item.corr.reason}}</view>
      <view class="muted mg-exp">{{item.corr.atStr}} 提出，{{item.corr.expireStr}} 前未处理自动失效，期间记录保持原样</view>
      <view class="mg-ops">
        <button class="btn btn-primary btn-sm" data-id="{{item._id}}" data-d="agree" catchtap="onCorrReply">同意更正</button>
        <button class="btn btn-outline btn-sm mg-op2" data-id="{{item._id}}" data-d="decline" catchtap="onCorrReply">拒绝</button>
      </view>
    </view>

    <!-- 未收到：原因、申诉、重新登记 -->
    <block wx:if="{{item.status === 'rejected'}}">
      <view class="mg-reason" wx:if="{{item.reasonText}}">原因：{{item.reasonText}}</view>
      <view class="mg-appeal" wx:if="{{item.canAppeal}}">
        <button class="btn btn-primary btn-sm" data-id="{{item._id}}" catchtap="onAppealOpen">我确实转了，请再核对</button>
      </view>
      <view class="mg-ops">
        <button class="btn btn-outline btn-sm" data-aid="{{item.aid}}" catchtap="onRegister">重新登记</button>
        <button class="btn btn-outline btn-sm mg-op2" open-type="share" data-sharetitle="{{item.shareTitle}}" catchtap="noop">分享给主家</button>
      </view>
    </block>

    <view class="mg-link" wx:if="{{item.status === 'paid'}}"><text class="mg-resub" wx:if="{{item.own}}" data-id="{{item._id}}" catchtap="onResub">开启变更提醒</text>查看回执 ›</view>

    <view class="mg-detail" wx:if="{{openId === item._id && item.status !== 'paid'}}" catchtap="noop">
      <view class="mg-hint">{{item.hint}}</view>
      <view class="mg-tl" wx:for="{{item.timeline}}" wx:for-item="t" wx:key="atStr"><text class="mg-tl-t">{{t.atStr}}</text>{{t.text}}</view>
      <button class="btn btn-outline btn-sm" wx:if="{{item.status === 'cancelled'}}" data-aid="{{item.aid}}" bindtap="onRegister">重新登记</button>
    </view>
  </view>

  <view class="muted center mg-more-tip" wx:if="{{moreBusy}}">加载中…</view>
  <view class="muted center mg-more-tip" wx:elif="{{more}}">上滑加载更多</view>

  <!-- 主家删除礼簿 / 注销后保留给我的凭证：只有我自己能看到，可随时删除，不能再操作 -->
  <block wx:if="{{vouchers.length}}">
    <view class="section-title mg-title">主家已删除礼簿，这是你保留的凭证（{{vouchers.length}}）</view>
    <view class="mg-sub">只含主家称呼、礼簿名、日期、金额、状态和修改记录，只有你自己能看到，会长期保留，你可以随时删除</view>
    <view class="card mg-item" wx:for="{{vouchers}}" wx:key="_id" data-id="{{item._id}}" bindtap="onToggle">
      <view class="mg-top">
        <text class="mg-shop ell">{{item.accountName || '主家'}}<text class="muted" wx:if="{{item.themeName}}"> · {{item.themeName}}</text></text>
        <text class="mg-money {{item.status === 'void' ? 'mg-gray mg-strike' : ''}}">￥{{item.amountStr}}</text>
      </view>
      <view class="muted">{{item.payerName}} · {{item.timeStr}}</view>
      <view class="mg-st {{item.status === 'paid' ? '' : 'bad'}} {{item.funeral ? 'fun' : ''}}">{{item.stText}}<text class="mg-more">{{openId === item._id ? '收起 ▴' : '经过 ▾'}}</text></view>
      <view class="mg-detail" wx:if="{{openId === item._id}}" catchtap="noop">
        <view class="mg-tl" wx:for="{{item.timeline}}" wx:for-item="t" wx:key="atStr"><text class="mg-tl-t">{{t.atStr}}</text>{{t.text}}</view>
        <view class="mg-ops"><button class="btn btn-outline btn-sm" data-id="{{item._id}}" catchtap="onVoucherDel">删除这份凭证</button></view>
      </view>
    </view>
  </block>

  <!-- 申请再核对弹层 -->
  <view class="mask {{inTab ? 'mg-tab-mask' : ''}}" wx:if="{{appeal}}" catchtouchmove="noop" bindtap="onAppealClose">
    <view class="sheet {{inTab ? 'mg-tab-sheet' : ''}}" catchtap="noop">
      <view class="sheet-title">申请主家再核对</view>
      <view class="muted mg-ap-sub">{{appeal.name}} ￥{{appeal.amountStr}}。每笔只能申请一次，主家会在「待确认」看到你的说明，也可点「分享给主家」。</view>
      <textarea class="mg-ap-input" cursor-spacing="140" maxlength="50" placeholder="说明（选填，50 字内），如：转账时间、转账备注" value="{{appeal.note}}" bindinput="onAppealNote" />
      <input class="mg-ap-ref" cursor-spacing="100" maxlength="6" placeholder="微信转账单号后几位（选填）" value="{{appeal.ref}}" bindinput="onAppealRef" />
      <view class="sheet-btns">
        <button class="btn btn-plain" bindtap="onAppealClose">取消</button>
        <button class="btn btn-primary" loading="{{appeal.busy}}" bindtap="onAppealSubmit">提交申请</button>
      </view>
    </view>
  </view>

  <view class="card net-err" wx:if="{{!loading && loadErr}}" bindtap="onRetryLoad">
    <view class="ne-title">随礼记录没加载出来</view>
    <view class="ne-sub">{{loadErr}}，请检查网络后重试</view>
    <view class="ne-btn">点此重试</view>
  </view>
  <view class="muted center mg-empty" wx:elif="{{!loading && empty}}">{{emptyText}}</view>
  <loading show="{{loading && !rows.length && !vouchers.length}}" rows="3" />
</view>
