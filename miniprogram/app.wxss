/* app.wxss — 全局样式 */
/* 主题色：喜事等为中国红，白事素灰（页面根节点按礼簿类型覆盖，见 utils/theme.js） */
page {
  --primary: #C8161D;
  --primary-soft: rgba(200, 22, 29, .1);
  background: #F4F5F7;
  font-size: 28rpx;
  color: #333;
}
.container { padding: 24rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}
.btn-primary[disabled] { opacity: .5; }
.btn-plain {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 12rpx;
  font-size: 30rpx;
}
.muted { color: #999; font-size: 24rpx; }
.money { color: #FA5151; font-weight: 600; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }

/* 自定义底部菜单占位（tab 页） */
.tab-page { padding-bottom: calc(50px + env(safe-area-inset-bottom)); }
