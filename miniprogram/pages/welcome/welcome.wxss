page { background: #fff; }
.page { position: relative; min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fff; }
.skip { position: absolute; top: 24rpx; right: 24rpx; z-index: 2; padding: 10rpx 28rpx; border-radius: 999rpx; background: var(--fill); color: var(--text-2); font-size: 26rpx; }

.swiper { height: 760rpx; }
.slide { display: flex; flex-direction: column; align-items: center; padding: 160rpx 48rpx 0; text-align: center; }
.icon-circle {
  width: 200rpx; height: 200rpx; border-radius: 50%; background: var(--primary);
  display: flex; align-items: center; justify-content: center; margin-bottom: 56rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .12);
}
.icon { width: 96rpx; height: 96rpx; }
.title { font-size: 44rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; }
.sub { font-size: 28rpx; color: #888; line-height: 1.6; }

/* 指示点（不用 gap，用 margin） */
.dots { display: flex; justify-content: center; margin: 8rpx 0 56rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: #ddd; margin: 0 8rpx; }
.dot.on { width: 36rpx; background: var(--primary); }

.ops { padding: 0 48rpx; }
.ops .later { margin-top: 24rpx; }
