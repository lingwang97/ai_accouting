<view class="container tab-page" style="{{themeStyle}}">
  <view class="card center" wx:if="{{!loggedIn}}">
    <view class="muted">人情往来仅本人可见，请先登录</view>
    <button class="btn-primary" style="margin-top:24rpx" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <!-- 亲友办事提醒：一行提示条（无提醒时不显示），点开底部弹层；只在「收礼往来」显示 -->
    <view class="tip-bar" wx:if="{{tab === 'people' && (reminds.length || doneList.length)}}" bindtap="onOpenRemind">
      <image class="tip-icon" src="/assets/icons/bell-r.svg" />
      <text class="tip-text ell {{hotCount ? 'hot' : ''}}">{{remindTip}}</text>
      <text class="tip-go">查看 ›</text>
    </view>

    <view class="seg">
      <view class="seg-item {{tab === 'people' ? 'on' : ''}}" data-t="recv" bindtap="onTab">收礼往来</view>
      <view class="seg-item {{tab === 'out' ? 'on' : ''}}" data-t="out" bindtap="onTab">送出的礼</view>
      <view class="seg-item {{tab === 'receipts' ? 'on' : ''}}" data-t="receipts" bindtap="onTab">随礼回执</view>
    </view>

    <view class="search-row">
      <input class="search" placeholder="{{tab === 'people' ? '输入姓名查往来' : (tab === 'receipts' ? '搜索主家 / 礼簿' : '搜索对方姓名')}}" value="{{keyword}}"
             bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search" />
      <view class="bell-btn" hover-class="btn-hover" wx:if="{{tab === 'people'}}" bindtap="onOpenRemind">
        <image class="bell-img" src="/assets/icons/bell-r.svg" />
        <view class="bell-dot" wx:if="{{hotCount}}"></view>
      </view>
      <view class="btn btn-primary add-btn" hover-class="btn-hover" wx:if="{{tab !== 'receipts'}}" bindtap="onAddGift">＋ 记送礼</view>
    </view>

    <loading show="{{loading && (tab === 'people' ? !shownPeople.length : (tab === 'receipts' ? !shownReceipts.length : !outList.length))}}" rows="4" />

    <!-- 收礼往来：按人（收送对比；逐笔在人详情里看） -->
    <view class="card out-sum" wx:if="{{tab === 'people' && (hasPeople || inTotal)}}">共收到 {{inTotal}} 笔 · <text class="money">￥{{inSum}}</text></view>
    <view class="sub-row" wx:if="{{tab === 'people'}}">
      <view class="pf-chips">
        <view class="chip {{pFilter === item.v ? 'on' : ''}}" wx:for="{{pFilters}}" wx:key="v" data-v="{{item.v}}" bindtap="onPFilter">{{item.t}}</view>
      </view>
    </view>

    <!-- 按人：收送对比 -->
    <block wx:if="{{tab === 'people'}}">
      <view class="muted small pad-s" wx:if="{{truncated}}">记录较多（超过 3000 条），下方名单的往来统计只含其中 3000 条；上方合计为全部</view>
      <view class="muted small pad-s" wx:elif="{{morePeople > 0 && !keyword}}">名单只显示往来最多的 300 人（另有 {{morePeople}} 人可输入姓名查询）；上方合计为全部</view>
      <view class="card person" wx:for="{{shownPeople}}" wx:key="key" data-key="{{item.key}}" bindtap="onPerson">
        <view class="p-top">
          <text class="p-name">{{item.label}}<text class="muted" wx:if="{{item.dup && item.relation}}"> · {{item.relation}}</text></text>
          <text class="bal {{item.balance > 0 ? 'owe' : (item.balance < 0 ? 'given' : '')}}">
            {{item.balance > 0 ? '宜回礼 ￥' + item.balanceStr : (item.balance < 0 ? '多送 ￥' + item.balanceStr : '已持平')}}
          </text>
        </view>
        <view class="muted">收礼 {{item.inCount}} 次 ￥{{item.inSumStr}} · 送礼 {{item.outCount}} 次 ￥{{item.outSumStr}}</view>
      </view>
      <view class="muted center pad" wx:if="{{!loading && shownPeople.length === 0}}">
        {{keyword ? '名单中没有「' + keyword + '」，按回车直接查询' : (pFilter !== 'all' && hasPeople ? '没有符合条件的往来人' : '暂无往来记录。宾客随礼入簿后会自动出现在这里，也可点「记送礼」登记你送出的礼')}}
      </view>
    </block>

    <!-- 随礼回执：扫码随礼、主家确认后的电子回执 -->
    <block wx:elif="{{tab === 'receipts'}}">
      <view class="card gift" wx:for="{{shownReceipts}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOpenReceipt">
        <view class="p-top">
          <text class="p-name">{{item.accountName || '主家'}}<text class="muted" wx:if="{{item.themeName}}"> · {{item.themeName}}</text></text>
          <text class="money">￥{{item.amountStr}}</text>
        </view>
        <view class="muted">{{item.timeStr}} · 随礼人 {{item.payerName}}<text class="link-r"> 查看回执 ›</text></view>
      </view>
      <view class="muted center pad" wx:if="{{!loading && shownReceipts.length === 0}}">{{keyword ? '没有找到「' + keyword + '」' : '扫码随礼、主家确认收到后，电子回执会出现在这里'}}</view>
    </block>

    <!-- 我送出的礼 -->
    <block wx:else>
      <view class="card out-sum">共送出 {{outTotal}} 笔 · <text class="money">￥{{outSum}}</text></view>
      <view class="card gift" wx:for="{{outList}}" wx:key="_id" data-idx="{{index}}" bindtap="onEditGift">
        <view class="p-top">
          <text class="p-name">{{item.toName}}<text class="muted" wx:if="{{item.relation}}"> · {{item.relation}}</text><text class="auto-tag" wx:if="{{item.auto}}">扫码随礼</text></text>
          <text class="money">￥{{item.amountStr}}</text>
        </view>
        <view class="muted">{{item.date}} · {{item.typeLabel}}<text wx:if="{{item.event}}"> · {{item.event}}</text></view>
      </view>
      <view class="muted center pad" wx:if="{{!loading && outList.length === 0}}">还没有送礼记录，点「记送礼」登记</view>
      <view class="muted center pad" wx:if="{{outList.length > 0 && outList.length < outTotal}}">上拉加载更多</view>
    </block>
  </block>

  <!-- 亲友办事提醒弹层 -->
  <view class="mask tab-mask" wx:if="{{remindShow}}" catchtouchmove="noop" bindtap="onCloseRemind">
    <view class="sheet tab-sheet" catchtap="noop">
      <view class="rm-head">
        <text class="sheet-title">亲友办事提醒<text class="muted" wx:if="{{reminds.length}}">（{{reminds.length}}）</text></text>
        <text class="link" bindtap="onAddRemind">＋ 加提醒</text>
      </view>
      <scroll-view scroll-y class="rm-scroll" wx:if="{{reminds.length}}">
        <view class="rm-row {{item.hot ? 'hot' : ''}} {{item.past ? 'past' : ''}}" wx:for="{{reminds}}" wx:key="_id" data-idx="{{index}}" bindtap="onRemind">
          <text class="rm-name">{{item.name}} · {{item.event || item.typeLabel}}</text>
          <text class="rm-date">{{item.dateStr}} · {{item.leftStr}}<text wx:if="{{item.remindStr && !item.past}}"> · {{item.remindStr}} 提醒</text></text>
        </view>
      </scroll-view>
      <view class="rm-empty" wx:else>
        <view class="muted">记下亲友办事的日期，到时提醒你回礼</view>
        <view class="btn btn-primary rm-add" hover-class="btn-hover" bindtap="onAddRemind">＋ 加提醒</view>
      </view>
      <!-- 最近已处理：点错了可撤回 -->
      <block wx:if="{{doneList.length}}">
        <view class="rm-done-head" bindtap="onToggleDone">最近已处理（{{doneList.length}}）<text class="muted">{{doneOpen ? '收起 ▴' : '展开 ▾'}}</text></view>
        <scroll-view scroll-y class="rm-scroll rm-done-scroll" wx:if="{{doneOpen}}">
          <view class="rm-row past" wx:for="{{doneList}}" wx:key="_id" data-idx="{{index}}" bindtap="onUndoDone">
            <text class="rm-name">{{item.name}} · {{item.event || item.typeLabel}}</text>
            <text class="rm-date">{{item.dateStr}} · 点此撤回</text>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>
</view>
