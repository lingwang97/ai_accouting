.book-tip { margin: 0 8rpx 20rpx; line-height: 1.6; }
.book-name { color: #333; font-weight: 600; }
.field { margin-bottom: 28rpx; }
.label { display: block; color: #666; margin-bottom: 12rpx; }
.input { border: 2rpx solid #e5e5e5; border-radius: 12rpx; padding: 18rpx 20rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 14rpx; }
.chip { padding: 10rpx 28rpx; border-radius: 999rpx; background: #f2f3f5; color: #666; font-size: 28rpx; }
.chip.on { background: var(--primary); color: #fff; }
.done { margin-top: 36rpx; }
.done-item {
  display: flex; justify-content: space-between; background: #fff; border-radius: 12rpx;
  padding: 22rpx 24rpx; margin-bottom: 12rpx; font-size: 30rpx;
}
.batch-switch { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; }
