.page { padding: 24rpx; }

/* ===== 工作台 ===== */
.role-line { font-size: 24rpx; color: #888; margin: 0 8rpx 16rpx; }
.warn-card {
  background: #FFF7E6; color: #D46B08; font-size: 26rpx; line-height: 1.6;
  border: 2rpx solid #FFC069; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 20rpx;
}

.book-card {
  background: var(--primary); color: #fff; border-radius: var(--r-l); padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .12); margin-bottom: 24rpx;
}
.bc-top { display: flex; justify-content: space-between; align-items: flex-start; }
.bc-title { flex: 1; min-width: 0; }
.bc-name { font-size: 34rpx; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.bc-meta { font-size: 22rpx; opacity: .85; margin-top: 6rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 切换礼簿：大一点的胶囊按钮，易点 */
.bc-switch-btn {
  flex-shrink: 0; height: 64rpx; line-height: 64rpx; padding: 0 26rpx; border-radius: 32rpx; margin-left: 16rpx; white-space: nowrap;
  background: rgba(255, 255, 255, .22); border: 2rpx solid rgba(255, 255, 255, .6); font-size: 26rpx; font-weight: 600;
}
.bc-switch-hover { background: rgba(255, 255, 255, .35); }
.bc-label { font-size: 24rpx; opacity: .8; margin-top: 28rpx; }
.bc-sum { font-size: 72rpx; font-weight: 700; margin: 4rpx 0 16rpx; letter-spacing: 1rpx; white-space: nowrap; }
/* 金额位数多时缩小字号，避免撑破卡片 */
.bc-sum.long { font-size: 60rpx; }
.bc-sum.xlong { font-size: 48rpx; letter-spacing: 0; }
.bc-foot { display: flex; justify-content: space-between; font-size: 24rpx; opacity: .9; }

.tip-bar {
  display: flex; align-items: center; background: #fff; border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-bottom: 24rpx; border: 2rpx solid var(--primary-soft);
}
.tip-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; margin-right: 12rpx; }
.tip-text { flex: 1; font-size: 26rpx; color: #333; margin-right: 12rpx; }
.tip-go { font-size: 26rpx; color: var(--primary); white-space: nowrap; }
/* 使用说明小卡片 */
.guide-tip .tip-text { color: var(--primary); }
.guide-close { flex-shrink: 0; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; margin: -12rpx -12rpx -12rpx 0; color: #bbb; font-size: 28rpx; }

/* 不用 flex gap（部分旧版 iOS 微信不支持，会塌成一列）：两端对齐 + 下边距 */
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 4rpx; }
.g-item {
  width: calc(50% - 10rpx); margin-bottom: 20rpx; box-sizing: border-box; background: #fff; border-radius: 20rpx;
  padding: 28rpx; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .04);
}
.g-hover { opacity: .8; }
.g-icon {
  position: relative; width: 80rpx; height: 80rpx; border-radius: 20rpx; background: var(--primary);
  display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx;
}
.g-icon image { width: 44rpx; height: 44rpx; }
.g-badge {
  position: absolute; top: -12rpx; right: -16rpx; min-width: 36rpx; height: 36rpx; line-height: 36rpx;
  padding: 0 8rpx; border-radius: 18rpx; background: var(--danger); color: #fff; font-size: 22rpx; text-align: center;
  box-sizing: border-box; border: 3rpx solid #fff;
}
.g-title { font-size: 32rpx; font-weight: 600; color: #333; }
.g-sub { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; }
.g-sub.hot { color: var(--danger); font-weight: 600; }
.g-sub.ok { color: var(--success); }

.links { display: flex; justify-content: space-around; padding: 28rpx 8rpx; }
.link-item { display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: var(--text-2); }
.link-item image { width: 48rpx; height: 48rpx; margin-bottom: 10rpx; }


/* ===== 首页（宾客） ===== */
.hero { text-align: center; padding: 48rpx 0 24rpx; }
.hero-title { font-size: 52rpx; font-weight: 700; }
.hero-sub { color: #888; margin-top: 12rpx; }

.scan-wrap { display: flex; justify-content: center; padding: 40rpx 0 56rpx; }
.scan-btn {
  width: 400rpx; height: 400rpx; border-radius: 50%; background: var(--primary);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, .18);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.scan-btn-hover { transform: scale(.96); opacity: .9; }
.scan-icon { position: relative; width: 140rpx; height: 140rpx; }
.corner { position: absolute; width: 36rpx; height: 36rpx; border: 0 solid #fff; }
.tl { top: 0; left: 0; border-top-width: 8rpx; border-left-width: 8rpx; border-top-left-radius: 12rpx; }
.tr { top: 0; right: 0; border-top-width: 8rpx; border-right-width: 8rpx; border-top-right-radius: 12rpx; }
.bl { bottom: 0; left: 0; border-bottom-width: 8rpx; border-left-width: 8rpx; border-bottom-left-radius: 12rpx; }
.br { bottom: 0; right: 0; border-bottom-width: 8rpx; border-right-width: 8rpx; border-bottom-right-radius: 12rpx; }
.scan-line {
  position: absolute; left: 16rpx; right: 16rpx; top: 66rpx;
  height: 6rpx; border-radius: 3rpx; background: #fff;
  animation: sweep 1.8s ease-in-out infinite;
}
@keyframes sweep {
  0%, 100% { transform: translateY(-44rpx); opacity: .4; }
  50% { transform: translateY(44rpx); opacity: 1; }
}
.scan-text { color: #fff; font-size: 36rpx; font-weight: 600; margin-top: 28rpx; }

.steps .step { display: flex; align-items: center; padding: 14rpx 0; color: #555; }
.num {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  border-radius: 50%; background: var(--primary-soft); color: var(--primary);
  font-size: 24rpx; font-weight: 600; margin-right: 20rpx;
}
.my-receipts { text-align: center; color: var(--link); font-size: 28rpx; padding: 8rpx 0 28rpx; }
.host-entry { display: flex; align-items: center; justify-content: space-between; }
.he-title { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.he-btn { margin-left: 20rpx; flex-shrink: 0; }

/* ===== 骨架屏 ===== */
.sk { background: linear-gradient(90deg, #ECECEC 25%, #F5F5F5 50%, #ECECEC 75%); background-size: 400% 100%; animation: sk 1.4s ease infinite; border-radius: 12rpx; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
.sk-book { height: 300rpx; border-radius: 24rpx; margin-bottom: 24rpx; }
.sk-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; margin-bottom: 20rpx; }
.sk-line { height: 30rpx; margin-bottom: 12rpx; }
.sk-line.short { width: 60%; height: 24rpx; }
.sk-bar { height: 140rpx; border-radius: 16rpx; }
.role-line.ro { color: var(--primary); font-weight: 600; }
