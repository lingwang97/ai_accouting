<view class="container" style="{{themeStyle}}">
  <view class="tip muted">到期在「往来」提醒你；订阅后当天 9 点再发微信通知</view>
  <view class="card">
    <view class="field">
      <text class="label">对方姓名 *</text>
      <input class="input" placeholder="谁家办事" maxlength="20" value="{{name}}" data-k="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">事由类型</text>
      <view class="chips">
        <view class="chip {{eventType === item.type ? 'on' : ''}}" wx:for="{{scenes}}" wx:key="type" data-t="{{item.type}}" bindtap="onType">{{item.label}}</view>
      </view>
    </view>
    <view class="field">
      <text class="label">事由</text>
      <input class="input" placeholder="选填，如：儿子结婚" maxlength="20" value="{{event}}" data-k="event" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">办事日期 *</text>
      <picker mode="date" value="{{date}}" start="{{today}}" bindchange="onDate"><view class="input">{{date || '请选择'}}</view></picker>
    </view>
    <view class="field">
      <text class="label">提醒时间 *</text>
      <view class="chips" wx:if="{{presets.length}}">
        <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{presets}}" wx:key="t" data-i="{{index}}" bindtap="onPreset">{{item.t}}</view>
      </view>
      <view class="time-row">
        <picker class="tr-day" mode="date" value="{{remindDay}}" start="{{today}}" bindchange="onRemindDay"><view class="input">{{remindDay || '选择日期'}}</view></picker>
        <picker class="tr-time" mode="time" value="{{remindTime}}" bindchange="onRemindTime"><view class="input">{{remindTime}}</view></picker>
      </view>
      <view class="muted small">到这个时间（5 分钟内）发送微信通知，并在「往来」顶部提醒</view>
    </view>
    <view class="field">
      <text class="label">备注</text>
      <input class="input" placeholder="选填，如：上次随我 ￥600" maxlength="50" value="{{note}}" data-k="note" bindinput="onInput" />
    </view>
  </view>

  <button class="btn-primary" loading="{{saving}}" bindtap="onSave">保存提醒</button>
  <button wx:if="{{_id}}" class="btn-danger btn-del" bindtap="onDelete">删除</button>
</view>
