<!-- 双码展示（v3.86.0 起先转账再登记）：上收款码（扫一扫转账，备注写姓名），下礼簿码（扫码登记） -->
<view class="screen" wx:if="{{account}}" style="background:{{primary}}">
  <view class="s-name">{{account.accountName}}</view>
  <view class="s-book" wx:if="{{bookName}}">{{bookName}}</view>
  <!-- 先转账、再登记（v3.86.0）：上块收款码，下块礼簿码；两块不同底色，白事素灰 -->
  <view class="s-card">
    <view class="s-blk a {{funeral ? 'fun' : ''}}">
      <view class="s-step">第 1 步：扫收款码转账<text class="s-step-sub">（备注写姓名）</text></view>
      <image wx:if="{{payCodeUrl}}" class="s-qr" src="{{payCodeUrl}}" mode="aspectFit" data-url="{{payCodeUrl}}" bindtap="onPreview" />
      <view class="muted s-tip" wx:elif="{{offline}}">收款码没保存到本机，联网后可显示</view>
    </view>
    <view class="s-blk b {{funeral ? 'fun' : ''}}">
      <view class="s-step">第 2 步：扫{{org ? '场次码' : '礼簿码'}}登记<text class="s-step-sub">（填姓名和金额）</text></view>
      <image wx:if="{{qrUrl}}" class="s-qr" src="{{qrUrl}}" mode="aspectFit" data-url="{{qrUrl}}" bindtap="onPreview" />
      <view wx:elif="{{errMsg}}" class="warn">{{errMsg}}</view>
      <view wx:else class="muted s-loading">生成中…</view>
    </view>
    <view class="muted s-tip">先转账再登记；还没转的，登记后按提示转账，转完回小程序点「我已完成转账」</view>
  </view>
  <!-- 网络不佳时显示的是本机保存的礼簿码（v3.66.0）；点一下重新加载 -->
  <view class="s-offline" wx:if="{{offline && offChecking}}">正在更新，先显示本机保存的礼簿码（{{offlineAt}}）</view>
  <view class="s-offline" wx:elif="{{offline}}" bindtap="onRetry">网络不佳，显示的是本机保存的礼簿码（{{offlineAt}}）。宾客手机有网络即可扫码随礼 · 点此重新加载</view>
  <view class="s-ops" wx:if="{{!offline}}">
    <view class="s-op" bindtap="onMakeCard">生成{{org ? '场次' : '礼簿'}}台卡</view>
    <view class="s-op" bindtap="onSave">保存{{org ? '场次码' : '礼簿码'}}</view>
    <button class="s-op s-share" hover-class="none" open-type="share">分享给宾客</button>
  </view>
  <view class="s-hint">屏幕已调至最亮，离开本页自动恢复</view>
  <view class="try s-try" wx:if="{{showTry && !offline}}" bindtap="onTry">自己试一下（模拟宾客随礼）›</view>
</view>

<!-- 加载失败：点击重试 -->
<view class="card center" wx:if="{{!account && !loading && errMsg}}" bindtap="onRetry">
  <view class="warn">{{errMsg}}</view>
  <view class="muted">点击重试</view>
</view>

<loading show="{{loading && !account}}" type="overlay" />

<!-- 台卡离屏画布 -->
<canvas type="2d" id="card" class="card-canvas"></canvas>
