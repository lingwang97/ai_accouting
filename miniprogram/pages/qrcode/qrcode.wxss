.center { text-align: center; }
.qrcode-card { padding: 40rpx 28rpx; }
.title { font-size: 36rpx; font-weight: 700; }
.qr { width: 420rpx; height: 420rpx; margin: 20rpx auto; }
.warn { color: var(--danger); margin: 16rpx 0; font-size: 26rpx; }
.tip { margin: 16rpx 0; }
.paycode { width: 320rpx; height: 320rpx; }
.btns { display: flex; }
.btns button:not(:last-child) { margin-right: 20rpx; }
.btns button { flex: 1; }
.btn-card { margin-top: 24rpx; }

/* 亮屏双码 */
.screen { min-height: 100vh; padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; text-align: center; }
.s-name { color: #fff; font-size: 44rpx; font-weight: 700; margin: 8rpx 0 28rpx; }
.s-card { background: #fff; border-radius: 24rpx; padding: 32rpx 24rpx; }
.s-step { display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 600; color: #333; }
.s-no {
  width: 44rpx; height: 44rpx; line-height: 44rpx; border-radius: 50%;
  color: #fff; font-size: 28rpx; margin-right: 14rpx;
}
.s-qr { width: 440rpx; height: 440rpx; margin: 20rpx auto 8rpx; display: block; }
.s-loading { padding: 160rpx 0; }
.s-divider { border-top: 2rpx dashed #ddd; margin: 24rpx 0; }
.s-tip { margin-top: 8rpx; }
.s-ops { display: flex; margin-top: 28rpx; }
.s-ops .s-op:not(:last-child) { margin-right: 16rpx; }
.s-op {
  flex: 1; margin: 0; padding: 0; line-height: 80rpx; font-size: 26rpx; white-space: nowrap; min-width: 0; border-radius: 12rpx;
  background: rgba(255, 255, 255, .2); color: #fff; border: 2rpx solid rgba(255, 255, 255, .6);
}
.s-share::after { border: none; }
button.s-op:not([size=mini]) { width: auto; font-weight: normal; }
.s-hint { color: rgba(255, 255, 255, .8); font-size: 22rpx; margin-top: 20rpx; }

/* 台卡画布放到屏幕外 */
.card-canvas { position: fixed; left: -2000px; top: 0; width: 750px; height: 1240px; }

.try { text-align: center; color: var(--link); font-size: 26rpx; padding: 28rpx 0 8rpx; }
.s-try { color: rgba(255, 255, 255, .9); }
.s-book { color: rgba(255, 255, 255, .85); font-size: 28rpx; margin: -16rpx 0 24rpx; }
.s-offline { margin-top: 24rpx; padding: 14rpx 20rpx; border-radius: 12rpx; background: rgba(255, 255, 255, .92); color: #C25E00; font-size: 24rpx; line-height: 1.6; text-align: center; }
