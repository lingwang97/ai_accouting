<view class="container" style="{{themeStyle}}">
  <!-- 回执样式：电子回执 / 打印小票（两页互相切换，带上当前礼簿） -->
  <view class="seg">
    <view class="seg-item {{'print' === 'receipt' ? 'on' : ''}}" data-t="receipt" bindtap="onStyleTab">电子回执</view>
    <view class="seg-item {{'print' === 'print' ? 'on' : ''}}" data-t="print" bindtap="onStyleTab">打印小票</view>
  </view>
  <!-- 样式跟礼簿走：每本礼簿各自一套 -->
  <view class="card book-bar">
    <text class="muted">设置礼簿</text>
    <picker range="{{books}}" range-key="name" value="{{bookIdx}}" bindchange="onBook">
      <view class="book-pick">{{books[bookIdx].name}} ▾</view>
    </picker>
  </view>
  <!-- 实时预览 -->
  <view class="card center">
    <view class="section-title">小票预览</view>
    <view class="paper">
      <view wx:for="{{previewLines}}" wx:key="index"
            class="p-line {{item.big ? 'big' : ''}} {{item.tall ? 'tall' : ''}} {{item.bold ? 'bold' : ''}} {{item.right ? 'right' : ''}} {{item.center ? 'center' : ''}}">{{item.t}}</view>
    </view>
  </view>

  <!-- 内容设置 -->
  <view class="card">
    <view class="section-title">内容</view>
    <view class="row"><text class="lbl">标题</text>
      <input class="input flex1" value="{{title}}" maxlength="30" bindinput="onTitle" /></view>
    <view class="row"><text class="lbl">致谢语</text>
      <input class="input flex1" value="{{thanks}}" maxlength="40" placeholder="如：谢谢惠顾" bindinput="onThanks" /></view>
    <view class="row"><text class="lbl">分隔线</text>
      <switch checked="{{showDivider}}" bindchange="onDivider" color="{{primary}}" /></view>
    <view class="row"><text class="lbl">推广语</text>
      <text class="muted flex1">底部打印"微信搜索「慧礼记」"（白事不打印）</text>
      <switch checked="{{promo}}" bindchange="onPromo" color="{{primary}}" /></view>
    <view class="row"><text class="lbl">页脚</text>
      <input class="input flex1" value="{{footer}}" maxlength="30" placeholder="可选，一行，如：电话 138xxxx" bindinput="onFooter" /></view>
    <view class="row"><text class="lbl">标题对齐</text>
      <view class="chips">
        <view class="chip {{titleAlign === 'center' ? 'on' : ''}}" data-v="center" bindtap="onTitleAlign">居中</view>
        <view class="chip {{titleAlign === 'left' ? 'on' : ''}}" data-v="left" bindtap="onTitleAlign">靠左</view>
      </view></view>
    <view class="row"><text class="lbl">标题加粗</text>
      <switch checked="{{titleBold}}" bindchange="onTitleBold" color="{{primary}}" /></view>
    <view class="row"><text class="lbl">记账人</text>
      <text class="muted flex1">标题下打印"记账：某某"（主家称呼始终打印）</text>
      <switch checked="{{showHandler}}" bindchange="onHandler" color="{{primary}}" /></view>
    <view class="row"><text class="lbl">金额字号</text>
      <view class="chips">
        <view class="chip {{amountSize === 'double' ? 'on' : ''}}" data-v="double" bindtap="onAmountSize">特大</view>
        <view class="chip {{amountSize === 'tall' ? 'on' : ''}}" data-v="tall" bindtap="onAmountSize">加高</view>
        <view class="chip {{amountSize === 'normal' ? 'on' : ''}}" data-v="normal" bindtap="onAmountSize">正常</view>
      </view></view>
    <view class="row"><text class="lbl">二维码</text>
      <text class="muted flex1">致谢语下打印二维码，扫码可查看电子回执（白事默认关）</text>
      <switch checked="{{qr}}" bindchange="onQr" color="{{primary}}" /></view>
    <block wx:if="{{qr}}">
      <view class="row"><text class="lbl">打印方式</text>
        <view class="chips">
          <view class="chip {{qrMode === 'native' ? 'on' : ''}}" data-v="native" bindtap="onQrMode">原生指令（快）</view>
          <view class="chip {{qrMode === 'image' ? 'on' : ''}}" data-v="image" bindtap="onQrMode">图片方式（兼容，稍慢）</view>
        </view></view>
      <view class="row"><text class="lbl"></text>
        <view class="btn btn-outline btn-sm" bindtap="onQrTest">{{qrTesting ? "打印中…" : "打印测试码"}}</view>
        <text class="muted flex1" style="margin-left:16rpx">测试码打不出或是乱码，请改用图片方式</text></view>
      <view class="row"><text class="lbl"></text>
        <view class="btn btn-outline btn-sm" bindtap="onQrCheck">{{qrChecking ? "检测中…" : "检测二维码链接"}}</view>
        <text class="muted flex1" style="margin-left:16rpx">真实小票没有二维码时先点这里看原因（只检测，不打印）</text></view>
    </block>
    <view class="row"><text class="lbl">纸宽</text>
      <view class="chips">
        <view class="chip {{paperWidth === 32 ? 'on' : ''}}" data-w="32" bindtap="onWidth">58mm(32列)</view>
        <view class="chip {{paperWidth === 48 ? 'on' : ''}}" data-w="48" bindtap="onWidth">80mm(48列)</view>
      </view>
    </view>
  </view>

  <!-- 上下留白：打印前后走纸行数，每行约 3mm；没有切刀的机器靠下留白手撕 -->
  <view class="card">
    <view class="section-title">上下留白（行）</view>
    <view class="row"><text class="lbl">上方</text>
      <view class="chips">
        <view wx:for="{{topOpts}}" wx:key="*this" class="chip {{feedTop === item ? 'on' : ''}}" data-n="{{item}}" bindtap="onFeedTop">{{item}}</view>
      </view></view>
    <view class="row"><text class="lbl">下方</text>
      <view class="chips">
        <view wx:for="{{bottomOpts}}" wx:key="*this" class="chip {{feedBottom === item ? 'on' : ''}}" data-n="{{item}}" bindtap="onFeedBottom">{{item}}</view>
      </view></view>
    <view class="muted">下方留白太少撕纸时容易撕坏字；默认上 1 行、下 5 行</view>
  </view>

  <!-- 字段排版 -->
  <view class="card">
    <view class="section-title">打印字段（已启用，可排序/移除）</view>
    <view class="field-row" wx:for="{{fieldItems}}" wx:key="f">
      <text>{{item.label}}</text>
      <view class="ops">
        <text class="op" data-f="{{item.f}}" data-dir="up" bindtap="onMove">↑</text>
        <text class="op" data-f="{{item.f}}" data-dir="down" bindtap="onMove">↓</text>
        <text class="op danger" data-f="{{item.f}}" bindtap="onRemoveField">移除</text>
      </view>
    </view>

    <view class="section-title" style="margin-top:28rpx">可添加字段</view>
    <view class="chips">
      <view class="chip" wx:for="{{disabledItems}}" wx:key="f" data-f="{{item.f}}" bindtap="onAddField">＋ {{item.label}}</view>
    </view>
    <view class="muted" wx:if="{{disabledItems.length === 0}}">全部字段已启用</view>
  </view>

  <button class="btn-primary" loading="{{saving}}" bindtap="onSave">保存模板</button>
  <loading show="{{pageLoading}}" type="overlay" />
</view>
