.center { text-align: center; }
.paper {
  background: #fff; border: 2rpx solid #eee;
  padding: 24rpx; margin: 0 auto;
  font-family: "Courier New", monospace;
  font-size: 24rpx; line-height: 1.7;
  text-align: left; white-space: pre-wrap;
  max-width: 480rpx;
}
.p-line.big { font-size: 34rpx; font-weight: 700; }
.p-line.tall { font-size: 28rpx; font-weight: 700; }
.p-line.bold { font-weight: 700; }
.p-line.sided { display: flex; }
.p-line .p-body { flex: 1; min-width: 0; }
.p-line.right .p-body { text-align: right; }
.p-line.center .p-body { text-align: center; }
.p-line .p-side { flex-shrink: 0; color: #888; }
.p-line.band { white-space: nowrap; overflow: hidden; text-align: center; color: #666; font-weight: 400; font-size: 22rpx; border-top: 2rpx dotted #ddd; border-bottom: 2rpx dotted #ddd; }
.p-note { margin-top: 12rpx; font-size: 22rpx; }
.p-line.right { text-align: right; }
.p-line.center { text-align: center; }
.row { display: flex; align-items: center; margin-bottom: 20rpx; }
.lbl { width: 140rpx; flex-shrink: 0; color: var(--text-2); }
.flex1 { flex: 1; }
.field-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; border-bottom: 2rpx solid #f5f5f5;
}
.ops { display: flex; }
.ops .op:not(:last-child) { margin-right: 24rpx; }
.op { color: var(--link); padding: 0 8rpx; }
.op.danger { color: var(--danger); }

.book-bar { display: flex; justify-content: space-between; align-items: center; }
.book-pick { font-weight: 600; color: var(--text); }

/* 电子回执 / 打印小票 切换 */
.seg { margin-bottom: 24rpx; }
.chip.disabled { opacity: 0.45; }

/* 测试按钮在上、说明另起一行（窄屏 / 大字体不挤成一窄列） */
.row.wrap { flex-wrap: wrap; }
.qr-note { width: calc(100% - 140rpx); margin: 10rpx 0 0 140rpx; line-height: 1.5; }
/* 礼簿名过长省略 */
.book-bar picker { flex: 1; min-width: 0; margin-left: 20rpx; text-align: right; }
.book-bar .book-pick { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 80mm（48 列）预览：放宽宽度、缩小字号，尽量不折行 */
.paper.wide { max-width: 100%; font-size: 20rpx; }
