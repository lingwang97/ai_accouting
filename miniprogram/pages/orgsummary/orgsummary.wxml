<view class="container" style="{{themeStyle}}">
  <view class="card head">
    <view class="h-top">
      <picker range="{{months}}" value="{{monthIdx}}" bindchange="onMonth">
        <view class="month">{{months[monthIdx]}} ▾</view>
      </picker>
      <text class="muted">{{list.length}} 场</text>
    </view>
    <view class="h-sum money">￥{{total.sumStr}}</view>
    <view class="muted">{{total.count}} 份<text wx:if="{{total.pending}}" class="hot"> · {{total.pending}} 份待确认</text></view>
  </view>

  <view class="seg">
    <view class="seg-item {{tab === 'books' ? 'on' : ''}}" data-t="books" bindtap="onTab">按场次</view>
    <view class="seg-item {{tab === 'staff' ? 'on' : ''}}" data-t="staff" bindtap="onTab">按礼台人员</view>
  </view>

  <block wx:if="{{tab === 'books'}}">
    <view class="card row-card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOpen">
      <view class="r-top">
        <text class="r-name">{{item.hostName || item.name}}</text>
        <text class="money">￥{{item.sumStr}}</text>
      </view>
      <view class="muted">{{item.date || '未设日期'}} · {{item.typeLabel}}<text wx:if="{{item.hostName}}"> · {{item.name}}</text><text wx:if="{{item.archived}}"> · 已归档</text></view>
      <view class="muted">{{item.count}} 份 · 微信 ￥{{item.wechatStr}} · 现金 ￥{{item.cashStr}}<text wx:if="{{item.pending}}" class="hot"> · {{item.pending}} 份待确认</text></view>
      <view class="muted small" wx:if="{{item.dutyText}}">礼台：{{item.dutyText}}</view>
      <view class="muted small" wx:if="{{item.staffText}}">登记 / 确认：{{item.staffText}}</view>
    </view>
    <view class="muted center pad" wx:if="{{!loading && list.length === 0}}">该月份没有场次（按礼簿的办事日期统计）</view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="st-row" wx:for="{{staff}}" wx:key="name">
        <text>{{item.name}}</text>
        <text><text class="muted">{{item.count}} 份 · </text><text class="money">￥{{item.sumStr}}</text></text>
      </view>
      <view class="muted center" wx:if="{{!loading && staff.length === 0}}">暂无已入簿的礼金</view>
      <view class="muted small tip">按"确认收到 / 礼台记账"的人统计，便于和各礼台核对现金</view>
    </view>
  </block>
</view>
