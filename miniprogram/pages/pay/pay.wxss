.center { text-align: center; }
.shop { font-size: 48rpx; font-weight: 700; margin: 8rpx 0; }
.field:last-child { margin-bottom: 0; }
.amount-row { display: flex; align-items: center; }
.yen { font-size: 44rpx; color: var(--text); margin-right: 8rpx; }
.input.amount { font-size: 44rpx; font-weight: 600; }
.pay-amount { font-size: 64rpx; margin: 8rpx 0; }
.success, .waiting { padding: 48rpx 28rpx; }
.ok { font-size: 88rpx; }
.ok-title { font-size: 40rpx; font-weight: 700; margin: 12rpx 0; }
.paycode { width: 420rpx; height: 420rpx; margin: 20rpx auto; }
.tip { margin-top: 16rpx; }
/* 登记页隐私说明入口（v3.84.2）：小字居中，可换行；链接上下扩大点击区但不撑高行 */
.pv-note { margin-top: 20rpx; padding: 0 16rpx; text-align: center; font-size: 24rpx; line-height: 1.6; color: var(--text-3); word-break: break-all; }
.pv-link { display: inline-block; color: var(--link); padding: 16rpx 4rpx; margin: -16rpx 0; }
.btn-link { color: var(--text-3); font-size: 28rpx; margin-top: 16rpx; }

/* 步骤条 */
.steps { display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.st { font-size: 24rpx; color: #bbb; padding: 6rpx 16rpx; border-radius: 999rpx; background: #fff; }
.st.on { color: #fff; background: var(--primary); }
.st.done { color: var(--primary); }
.st-line { width: 40rpx; height: 2rpx; background: #ddd; margin: 0 8rpx; }

/* 等待动画 */
.spinner {
  width: 80rpx; height: 80rpx; margin: 0 auto 16rpx;
  border: 6rpx solid #e5e5e5; border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.btn-save { margin: 20rpx 0 8rpx; }
.chips + .amount-row { margin-top: 14rpx; }
.success-head.plain .ok-title { color: var(--text); }
.scan-icon { font-size: 80rpx; }
.link-fold { color: var(--link); font-size: 26rpx; padding-top: 8rpx; }
/* 展开收款码：做成整行按钮，不在现场的宾客也容易找到 */
.fold-btn { margin-top: 20rpx; padding: 18rpx 0; border-radius: var(--r-s); border: 2rpx solid var(--primary); color: var(--primary); font-size: 28rpx; }
.fold-btn.open { border-color: var(--border); color: var(--text-3); }
.success-head { padding: 28rpx; }
.btn-receipt { margin-top: 28rpx; }
.offscreen { position: fixed; left: -2000px; top: 0; width: 750px; height: 1400px; }
.big-amount { font-size: 72rpx; margin: 8rpx 0; }
.saved-tip { color: var(--primary); font-size: 28rpx; margin: 16rpx 0 4rpx; }
.cash-tip { color: var(--warn); font-size: 30rpx; font-weight: 600; margin: 16rpx 0; }
.batch-switch { display: flex; justify-content: space-between; align-items: center; }
.batch-switch switch { margin-left: 24rpx; }
.pay-method { margin-top: 28rpx; }
.items { font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; }
.host-cta { margin: 24rpx 0; padding: 22rpx 24rpx; background: var(--primary-soft); color: var(--primary); border-radius: var(--r-s); font-size: 26rpx; line-height: 1.6; text-align: center; }
/* 转账步骤：一行三步（不用 gap，用 margin） */
.step-row { display: flex; justify-content: center; margin: 12rpx 0 20rpx; }
.sr-item { flex: 1; font-size: 26rpx; color: #333; background: #F7F7F7; border-radius: 10rpx; padding: 14rpx 6rpx; text-align: center; min-width: 0; word-break: break-all; }
.sr-item:not(:last-child) { margin-right: 12rpx; }
.sr-num { color: var(--primary); font-weight: 600; margin-right: 4rpx; }

/* 转账了吗？两个大按钮（v3.86.0）：不用 gap；小屏 / 大字体下文字换行，按钮随内容增高 */
.ask-title { font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx; }
.ask-row { display: flex; align-items: stretch; }
.ask-btn { flex: 1; min-width: 0; min-height: 132rpx; box-sizing: border-box; padding: 20rpx 12rpx; text-align: center; border: 2rpx solid var(--border); border-radius: var(--r-s); color: var(--text-2, #555); background: #fff; display: flex; flex-direction: column; justify-content: center; }
.ask-btn + .ask-btn { margin-left: 16rpx; }
.ask-btn.on { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); }
.ask-main { font-size: 32rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.ask-sub { font-size: 24rpx; line-height: 1.4; margin-top: 4rpx; word-break: break-all; }
.ask-tip { margin-top: 16rpx; font-size: 26rpx; line-height: 1.6; }
.pf-hint { color: var(--primary); font-size: 26rpx; line-height: 1.6; margin-bottom: 12rpx; }
.pc-try { font-size: 24rpx; margin-top: 8rpx; }
/* 转账步骤：「我已完成转账」固定底栏，页面底部留出位置（含安全区） */
.container.has-bar { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
.pay-bar-tip { text-align: center; font-size: 26rpx; color: var(--text-3); margin-bottom: 12rpx; }
.pay-bar button.btn-primary:not([size=mini]) { width: 100%; margin: 0; }

/* 底部低调求助入口：原生 button 去掉默认样式，高度 80rpx 便于点击，不占主流程 */
.help-row { text-align: center; padding: 8rpx 0 0; }
button.help-link:not([size=mini]) { display: inline-block; width: auto; margin: 0; padding: 0 24rpx; background: transparent; border: none; border-radius: 0; font-size: 24rpx; line-height: 80rpx; height: 80rpx; min-height: 0; color: var(--text-3); }
button.help-link::after { border: none; }
.retry-btn { display: inline-block; margin-top: 20rpx; padding: 10rpx 40rpx; border-radius: 40rpx; border: 2rpx solid var(--primary, #C8161D); color: var(--primary, #C8161D); font-size: 28rpx; }
