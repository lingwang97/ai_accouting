.center { text-align: center; }
.shop { font-size: 48rpx; font-weight: 700; margin: 8rpx 0; }
.field { margin-bottom: 28rpx; }
.field:last-child { margin-bottom: 0; }
.label { display: block; color: #666; margin-bottom: 12rpx; }
.input {
  border: 2rpx solid #e5e5e5; border-radius: 12rpx;
  padding: 20rpx;
}
.amount-row { display: flex; align-items: center; }
.yen { font-size: 44rpx; color: #333; margin-right: 8rpx; }
.input.amount { font-size: 44rpx; font-weight: 600; }
.pay-amount { font-size: 64rpx; margin: 8rpx 0; }
.success, .waiting { padding: 48rpx 28rpx; }
.ok { font-size: 88rpx; }
.ok-title { font-size: 40rpx; font-weight: 700; margin: 12rpx 0; }
.paycode { width: 420rpx; height: 420rpx; margin: 20rpx auto; }
.tip { margin-top: 16rpx; }
.btn-link { background: none; color: #999; font-size: 28rpx; margin-top: 16rpx; }
.btn-link::after { border: none; }

/* 步骤条 */
.steps { display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.st { font-size: 24rpx; color: #bbb; padding: 6rpx 16rpx; border-radius: 999rpx; background: #fff; }
.st.on { color: #fff; background: #07C160; }
.st.done { color: #07C160; }
.st-line { width: 40rpx; height: 2rpx; background: #ddd; margin: 0 8rpx; }

/* 等待动画 */
.spinner {
  width: 80rpx; height: 80rpx; margin: 0 auto 16rpx;
  border: 6rpx solid #e5e5e5; border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.pay-ways { text-align: left; font-size: 24rpx; color: #666; line-height: 1.7; margin: 16rpx 0; padding: 16rpx 20rpx; background: #F7F7F7; border-radius: 12rpx; }
.btn-save { margin: 8rpx 0 16rpx; }
