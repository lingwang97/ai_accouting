.center { text-align: center; }
.shop { font-size: 48rpx; font-weight: 700; margin: 8rpx 0; }
.field { margin-bottom: 28rpx; }
.field:last-child { margin-bottom: 0; }
.label { display: block; color: #666; margin-bottom: 12rpx; }
.input {
  border: 2rpx solid #e5e5e5; border-radius: 12rpx;
  padding: 20rpx;
}
.amount-row { display: flex; align-items: center; }
.yen { font-size: 44rpx; color: #333; margin-right: 8rpx; }
.input.amount { font-size: 44rpx; font-weight: 600; }
.pay-amount { font-size: 64rpx; margin: 8rpx 0; }
.success, .waiting { padding: 48rpx 28rpx; }
.ok { font-size: 88rpx; }
.ok-title { font-size: 40rpx; font-weight: 700; margin: 12rpx 0; }
.paycode { width: 420rpx; height: 420rpx; margin: 20rpx auto; }
.tip { margin-top: 16rpx; }
.btn-link { background: none; color: #999; font-size: 28rpx; margin-top: 16rpx; }
.btn-link::after { border: none; }

/* 步骤条 */
.steps { display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.st { font-size: 24rpx; color: #bbb; padding: 6rpx 16rpx; border-radius: 999rpx; background: #fff; }
.st.on { color: #fff; background: var(--primary); }
.st.done { color: var(--primary); }
.st-line { width: 40rpx; height: 2rpx; background: #ddd; margin: 0 8rpx; }

/* 等待动画 */
.spinner {
  width: 80rpx; height: 80rpx; margin: 0 auto 16rpx;
  border: 6rpx solid #e5e5e5; border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.pay-ways { text-align: left; font-size: 24rpx; color: #666; line-height: 1.7; margin: 16rpx 0; padding: 16rpx 20rpx; background: #F7F7F7; border-radius: 12rpx; }
.btn-save { margin: 20rpx 0 8rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 14rpx; }
.chip { padding: 8rpx 26rpx; border-radius: 999rpx; background: #f2f3f5; color: #666; font-size: 26rpx; }
.chip.on { background: var(--primary); color: #fff; }
.success-head.plain .ok-title { color: #333; }
.scan-icon { font-size: 80rpx; }
.scan-steps { text-align: left; font-size: 28rpx; color: #333; line-height: 2; margin: 8rpx 0 20rpx; }
.scan-steps .em { color: var(--primary); font-weight: 600; }
.link-fold { color: #576B95; font-size: 26rpx; padding-top: 8rpx; }
.success-head { padding: 28rpx; }
.btn-receipt { margin-top: 28rpx; }
.offscreen { position: fixed; left: -2000px; top: 0; width: 750px; height: 1400px; }
.big-amount { font-size: 72rpx; margin: 8rpx 0; }
.saved-tip { color: var(--primary); font-size: 28rpx; margin: 16rpx 0 4rpx; }
.cash-tip { color: #FF9F1C; font-size: 30rpx; font-weight: 600; margin: 16rpx 0; }
.batch-switch { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; }
.pay-method { margin-top: 28rpx; }
.items { font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; }
.host-cta { margin: 24rpx 0; padding: 22rpx 24rpx; background: var(--primary-soft); color: var(--primary); border-radius: 12rpx; font-size: 26rpx; line-height: 1.6; text-align: center; }
