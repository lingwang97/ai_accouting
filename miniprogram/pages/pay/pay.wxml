<view class="container {{step === 'transfer' ? 'has-bar' : ''}}" style="{{themeStyle}}">
  <!-- 读取主家信息期间（扫码冷启动常要 1～2 秒）：显示加载中，不留白屏 -->
  <loading show="{{!account && !loadErr}}" rows="3" />
  <!-- 加载失败 -->
  <view class="card center" wx:if="{{loadErr}}" bindtap="onRetryLoad">
        <view class="muted">{{loadErr}}</view>
    <view class="retry-btn" wx:if="{{loadErrNet}}">点此重试</view>
  </view>

  <block wx:elif="{{account}}">
    <!-- 步骤条 -->
    <!-- 先转账后登记（选了「已转账，现在登记」）：1 转账（已完成）→ 2 登记 → 3 入簿 -->
    <view class="steps" wx:if="{{paidFirst === true && payMethod !== 'cash'}}">
      <view class="st done">1 转账</view>
      <view class="st-line"></view>
      <view class="st {{step === 'form' ? 'on' : 'done'}}">2 登记</view>
      <view class="st-line"></view>
      <view class="st {{step === 'waiting' ? 'on' : (step === 'success' || step === 'failed' ? 'done' : '')}}">3 入簿</view>
    </view>
    <view class="steps" wx:else>
      <view class="st {{step === 'form' ? 'on' : 'done'}}">1 登记</view>
      <view class="st-line"></view>
      <view class="st {{step === 'transfer' ? 'on' : (step === 'form' ? '' : 'done')}}">2 转账</view>
      <view class="st-line"></view>
      <view class="st {{step === 'waiting' ? 'on' : (step === 'success' || step === 'failed' ? 'done' : '')}}">3 入簿</view>
    </view>

    <!-- 主家与礼簿 -->
    <view class="card center">
      <view class="muted">向主家</view>
      <view class="shop" style="color:var(--primary)">{{account.accountName}}</view>
      <view class="muted" wx:if="{{account.book && account.book.name}}">{{account.book.name}}<text wx:if="{{account.book.date}}"> · {{account.book.date}}</text></view>
    </view>

    <!-- 第 1 步：填写 -->
    <block wx:if="{{step === 'form'}}">
      <!-- 转账了吗？（v3.86.0）：现场先转后登更不容易忘；现金随礼不涉及转账，不显示 -->
      <view class="card ask-card" wx:if="{{payMethod !== 'cash'}}">
        <view class="ask-title">转账了吗？</view>
        <view class="ask-row">
          <view class="ask-btn {{paidFirst === true ? 'on' : ''}}" data-v="1" bindtap="onPaidFirst">
            <view class="ask-main">已转账，现在登记</view>
            <view class="ask-sub">已扫收款码转过账</view>
          </view>
          <view class="ask-btn {{paidFirst === false ? 'on' : ''}}" data-v="0" bindtap="onPaidFirst">
            <view class="ask-main">还没转，先登记</view>
            <view class="ask-sub">登记后再扫码转账</view>
          </view>
        </view>
        <view class="muted ask-tip" wx:if="{{paidFirst === true}}">请填写刚才转账的金额。提交后等主家核对到账，不用再回来点按钮</view>
        <view class="muted ask-tip" wx:elif="{{paidFirst === false}}">登记后按提示转账，转完回来点「我已完成转账」</view>
        <view class="ask-tip ask-need" wx:else>请先选择一项：已扫收款码转过账的选左边，还没转的选右边</view>
      </view>
      <view class="card batch-switch">
        <view>
          <view>批次录入</view>
          <view class="muted">多人一起登记，每人单独入簿，按合计转一笔</view>
        </view>
        <switch checked="{{batchMode}}" bindchange="onBatchMode" color="{{primary}}" />
      </view>
      <view class="card">
        <block wx:if="{{batchMode}}">
          <view class="muted pf-hint" wx:if="{{paidFirst === true && payMethod !== 'cash'}}">请按刚才转账的金额填写，各人合计要和转账一致（现金部分另交礼台）</view>
          <batch-list first-label="本人" quick="{{account.quickAmounts || []}}" mixed="{{payMethod === 'mixed'}}" bindchange="onBatchChange" />
        </block>
        <block wx:else>
          <view class="field">
            <text class="label">{{who}} *</text>
            <input class="input" placeholder="请输入您的姓名（必填）" maxlength="20" value="{{payerName}}" bindinput="onName" confirm-type="next" bindconfirm="onNameNext" />
          </view>
          <view class="field">
            <text class="label">与主家关系</text>
            <view class="chips">
              <view class="chip {{relation === item ? 'on' : ''}}" wx:for="{{relations}}" wx:key="*this" data-r="{{item}}" bindtap="onRelation">{{item}}</view>
            </view>
          </view>
          <view class="field">
            <text class="label">{{isFuneral ? '奠仪' : '礼金'}} *</text>
            <view class="muted pf-hint" wx:if="{{paidFirst === true && payMethod !== 'cash'}}">请填写刚才转账的金额</view>
            <view class="chips" wx:if="{{account.quickAmounts && account.quickAmounts.length}}">
              <view class="chip {{amount == item ? 'on' : ''}}" wx:for="{{account.quickAmounts}}" wx:key="*this" data-v="{{item}}" bindtap="onQuick">{{item}}</view>
            </view>
            <view class="amount-row">
              <text class="yen">￥</text>
              <input class="input amount" type="digit" maxlength="11" placeholder="其他金额" value="{{amount}}" bindinput="onAmount" focus="{{amountFocus}}" bindblur="onAmountBlur" />
            </view>
          </view>
          <view class="field">
            <text class="label">礼品/备注</text>
            <input class="input" placeholder="选填，如：另送花篮一对" maxlength="50" value="{{remark}}" bindinput="onRemark" />
          </view>
        </block>
        <view class="field pay-method">
          <text class="label">随礼方式</text>
          <view class="chips">
            <view class="chip {{payMethod === 'wechat' ? 'on' : ''}}" data-m="wechat" bindtap="onPayMethod">微信转账</view>
            <view class="chip {{payMethod === 'cash' ? 'on' : ''}}" data-m="cash" bindtap="onPayMethod">{{isFuneral ? "" : "💵 "}}现金</view>
            <view class="chip {{payMethod === 'mixed' ? 'on' : ''}}" wx:if="{{batchMode}}" data-m="mixed" bindtap="onPayMethod">转账+现金</view>
          </view>
          <view class="muted" wx:if="{{payMethod === 'cash'}}">现金请当面交给主家或礼台，无需扫码转账</view>
        </view>
      </view>
      <!-- 没选「已转账 / 还没转」时按钮置灰，点了弹窗提示先选（v3.86.10） -->
      <button class="btn-primary {{payMethod !== 'cash' && paidFirst === null ? 'btn-dim' : ''}}" loading="{{submitting}}" bindtap="onConfirmTransfer">{{payMethod === 'cash' ? '确认' + act + '（现金）' : (paidFirst === true ? '确认' + act + '（已转账）' : '确认' + act)}}</button>
      <!-- 隐私说明入口（v3.84.2）：只说明用途并给出链接，不把提交当作对隐私说明的认可 -->
      <view class="pv-note">填写的姓名与{{isFuneral ? '奠仪' : '礼金'}}仅用于主家记账，详见<text class="pv-link" bindtap="goPrivacy">《隐私说明》</text></view>
    </block>

    <!-- 第 2 步：扫收款码转账 -->
    <block wx:if="{{step === 'transfer'}}">
      <view class="card center">
        <view class="muted">请转账</view>
        <view class="pay-amount money big-amount">￥{{record.payStr}}</view>
        <view class="cash-tip" wx:if="{{record.mixed}}">另有现金 ￥{{record.cashStr}}，请当面交给礼台（共 ￥{{record.amountStr}}）</view>
        <view class="muted">{{who}}：{{record.payerName}}</view>
        <view class="muted items" wx:if="{{record.itemsStr}}">{{record.itemsStr}}</view>
      </view>
      <!-- 在现场：用微信扫一扫扫主家屏幕 / 台卡上的收款码 -->
      <view class="card center" wx:if="{{onsite}}">
        <view class="scan-icon" wx:if="{{!isFuneral}}">📷</view>
        <view class="section-title">请用微信「扫一扫」转账给主家</view>
        <view class="step-row">
          <view class="sr-item"><text class="sr-num">①</text>扫一扫</view>
          <view class="sr-item"><text class="sr-num">②</text>扫台卡收款码</view>
          <view class="sr-item"><text class="sr-num">③</text>回来点完成</view>
        </view>
        <view class="fold-btn {{showFallback ? 'open' : ''}}" bindtap="onToggleFallback">{{showFallback ? '收起收款码' : '看不到 / 扫不到礼台收款码？点这里显示'}}</view>
      </view>

      <!-- 不在现场（或在现场看不到收款码）：存相册后用扫一扫识别 -->
      <view class="card center" wx:if="{{!onsite || showFallback}}">
        <view class="section-title">向主家收款码转账 ￥{{record.payStr}}</view>
        <image wx:if="{{payCodeUrl}}" class="paycode" src="{{payCodeUrl}}" mode="aspectFit" bindtap="onPreviewPayCode" />
        <view wx:else class="muted">收款码加载失败，请联系主家</view>
        <view class="saved-tip" wx:if="{{codeSaved}}">✓ 收款码已存入相册</view>
        <button wx:if="{{payCodeUrl && !codeSaved}}" class="btn-primary btn-save" bindtap="onSavePayCode">保存收款码到相册</button>
        <view class="step-row">
          <view class="sr-item"><text class="sr-num">①</text>扫一扫</view>
          <view class="sr-item"><text class="sr-num">②</text>相册选收款码</view>
          <view class="sr-item"><text class="sr-num">③</text>回来点完成</view>
        </view>
        <view class="link-fold" wx:if="{{codeSaved}}" bindtap="onSavePayCode">没找到？重新保存</view>
        <view class="muted">用微信扫一扫识别相册里的收款码，转账给主家</view>
        <view class="muted pc-try" wx:if="{{payCodeUrl}}">也可以点大图，长按试试识别</view>
        <view class="link-fold" wx:if="{{!onsite}}" bindtap="onSwitchOnsite">在现场？直接扫主家屏幕或台卡上的收款码</view>
      </view>
      <button class="btn-text btn-link" bindtap="onCancel">取消本次{{act}}</button>
      <!-- 固定在底部（v3.86.0）：转完账回来不用翻页找按钮 -->
      <view class="bottom-bar pay-bar">
        <view class="pay-bar-tip">转完账请回来点这里</view>
        <button class="btn-primary" loading="{{submitting}}" bindtap="onTransferred">我已完成转账</button>
      </view>
      <!-- 占位：与底栏同内容、同高度（含系统大字体与安全区），隐藏不可点，页面滚到底时「取消本次」不会被底栏盖住（v3.86.1） -->
      <view class="bottom-bar pay-bar pay-bar-ph">
        <view class="pay-bar-tip">转完账请回来点这里</view>
        <button class="btn-primary" disabled>我已完成转账</button>
      </view>
    </block>

    <!-- 第 3 步：等待收款方确认 -->
    <block wx:if="{{step === 'waiting'}}">
      <view class="card center waiting">
        <view class="spinner" wx:if="{{!pollTimeout}}"></view>
        <view class="ok-title">{{pollTimeout ? '主家还没确认' : '等待主家确认收到…'}}</view>
        <view class="muted">{{record.payerName}} · ￥{{record.amountStr}}<text wx:if="{{record.payMethod === 'cash'}}"> · 现金</text></view>
        <view class="muted items" wx:if="{{record.itemsStr}}">{{record.itemsStr}}</view>
        <view class="cash-tip" wx:if="{{record.payMethod === 'cash'}}">请将现金 ￥{{record.amountStr}} 当面交给主家或礼台</view>
        <view class="cash-tip" wx:if="{{record.mixed}}">转账 ￥{{record.payStr}} 已完成，请将现金 ￥{{record.cashStr}} 当面交给礼台</view>
        <view class="muted tip" wx:if="{{!pollTimeout}}">主家确认后本页自动显示回执，也可先离开，稍后在首页「我的随礼记录」查看</view>
        <view class="muted tip" wx:else>已暂停自动查询。可先离开，稍后在「我的随礼记录」查看，或点「刷新状态」</view>
      </view>
      <button class="btn-outline" bindtap="onRefresh">刷新状态</button>
    </block>

    <!-- 成功：展示宾客留存的随礼回执 -->
    <block wx:if="{{step === 'success'}}">
      <view class="card center success-head" wx:if="{{!isFuneral}}">
        <view class="ok">✅</view>
        <view class="ok-title">随礼成功，已记入礼簿</view>
      </view>
      <!-- 白事：素色、不用"成功"等字眼 -->
      <view class="card center success-head plain" wx:else>
        <view class="ok-title">奠仪已登记</view>
        <view class="muted">主家已收到，谨致谢意</view>
      </view>
      <receipt-view wx:if="{{receiptModel}}" model="{{receiptModel}}" />
      <view wx:else class="card center">
        <view class="pay-amount money">￥{{record.amountStr}}</view>
        <view class="muted">{{who}}：{{record.payerName}} · 主家：{{account.accountName}}</view>
      </view>
      <button wx:if="{{receiptModel}}" class="btn-primary btn-receipt" loading="{{savingReceipt}}" bindtap="onSaveReceipt">保存回执到相册</button>
      <view class="host-cta" wx:if="{{!isFuneral}}" bindtap="goHostEntry">我家也要办事？免费创建电子礼簿，宾客扫码随礼自动记账 ›</view>
      <ad-slot slot="paySuccess" book-type="{{account.book.type || 'other'}}" />
    </block>

    <!-- 失败 -->
    <block wx:if="{{step === 'failed'}}">
      <view class="card center success">
        <view class="ok" wx:if="{{!isFuneral}}">❌</view>
        <view class="ok-title">主家未确认收到</view>
        <view class="muted">{{failReason}}</view>
      </view>
      <button class="btn-primary" bindtap="onRetry">重新{{act}}</button>
    </block>
  </block>
  <!-- 低调的求助入口：宾客无需登录；文案中性（白事同样适用） -->
  <view class="help-row" wx:if="{{loadErr || account}}">
    <button class="help-link" open-type="contact" show-message-card="{{true}}" send-message-title="随礼页求助" send-message-path="/pages/index/index" hover-class="none">遇到问题？联系客服</button>
    <button class="help-link" hover-class="none" bindtap="goFaq">常见问题</button>
  </view>
  <canvas type="2d" id="receiptCanvas" class="offscreen"></canvas>
</view>
