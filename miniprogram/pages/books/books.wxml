<view class="page" style="{{themeStyle}}">
  <view class="book-tip muted">宾客扫礼簿码随礼时记入「当前礼簿」；办新的事（满月、乔迁…）新建一本，各自统计、导出。</view>

  <!-- 当前礼簿 -->
  <view class="cur-card" wx:if="{{current}}">
    <view class="cc-top">
      <text class="cc-tag">当前礼簿</text>
      <text class="cc-type">{{current.typeLabel}}<text wx:if="{{current.date}}"> · {{current.date}}</text></text>
    </view>
    <view class="cc-name">{{current.title}}</view>
    <view class="cc-sum">￥{{current.sumStr}}</view>
    <view class="cc-count">{{current.count}} 份<text wx:if="{{current.location}}"> · {{current.location}}</text></view>
    <view class="cc-ops">
      <view class="cc-op" data-id="{{current._id}}" bindtap="onDetail">统计</view>
      <view class="cc-op" wx:if="{{!restricted}}" data-id="{{current._id}}" bindtap="onEdit">编辑</view>
      <view class="cc-op" data-id="{{current._id}}" bindtap="onExport">导出</view>
    </view>
  </view>

  <!-- 其他礼簿 -->
  <view class="group-title" wx:if="{{list.length}}">{{orgMode ? '其他场次' : '其他礼簿'}}</view>
  <view class="card book" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onDetail">
    <view class="b-top">
      <text class="b-name">{{item.title}}</text>
      <text class="tag {{item.type}}">{{item.typeLabel}}</text>
    </view>
    <view class="muted">{{item.date || '未设日期'}}<text wx:if="{{item.location}}"> · {{item.location}}</text></view>
    <view class="b-foot">
      <text><text class="money">￥{{item.sumStr}}</text><text class="muted"> · {{item.count}} 份</text></text>
      <view class="b-ops">
        <view class="op-btn" wx:if="{{!restricted}}" data-id="{{item._id}}" catchtap="onSetActive">设为当前</view>
        <view class="op-btn" data-id="{{item._id}}" catchtap="onExport">导出</view>
        <view class="op-link" wx:if="{{!restricted}}" data-id="{{item._id}}" catchtap="onEdit">编辑</view>
        <view class="op-link gray" wx:if="{{!restricted}}" data-id="{{item._id}}" data-archived="{{false}}" catchtap="onArchive">归档</view>
      </view>
    </view>
  </view>

  <view class="muted center pad" wx:if="{{!loading && !current && list.length === 0}}">还没有礼簿</view>

  <!-- 已归档 -->
  <view class="fold" wx:if="{{archived.length > 0}}" bindtap="onToggleArchived">
    {{showArchived ? '收起' : '查看'}}已归档礼簿（{{archived.length}}） {{showArchived ? '▴' : '▾'}}
  </view>
  <block wx:if="{{showArchived}}">
    <view class="card book archived" wx:for="{{archived}}" wx:key="_id" data-id="{{item._id}}" bindtap="onDetail">
      <view class="b-top">
        <text class="b-name">{{item.title}}</text>
        <text class="tag">{{item.typeLabel}} · 已归档</text>
      </view>
      <view class="b-foot">
        <text><text class="money">￥{{item.sumStr}}</text><text class="muted"> · {{item.count}} 份</text></text>
        <view class="b-ops">
          <view class="op-btn" data-id="{{item._id}}" catchtap="onExport">导出</view>
          <view class="op-link" wx:if="{{!restricted}}" data-id="{{item._id}}" data-archived="{{true}}" catchtap="onArchive">取消归档</view>
        </view>
      </view>
    </view>
  </block>

  <view class="more-export" bindtap="goExportMore">按日期范围导出 / 一键备份 ›</view>

  <!-- 底部并排：新建礼簿｜礼簿共享（共享给家人只读查看） -->
  <view class="bottom-bar" wx:if="{{!restricted}}">
    <view class="bb-btn solid" hover-class="bb-hover" bindtap="onAdd"><text class="bb-plus">＋</text>新建{{orgMode ? '场次' : '礼簿'}}</view>
    <view class="bb-btn outline" hover-class="bb-hover" bindtap="goShare"><image class="bb-icon" src="/assets/icons/people-{{iconKey}}.svg" />礼簿共享</view>
  </view>
</view>
