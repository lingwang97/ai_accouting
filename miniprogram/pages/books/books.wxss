.page { padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom)); }
.book-tip { margin: 0 8rpx 20rpx; line-height: 1.6; }

/* 当前礼簿 */
.cur-card {
  background: var(--primary); color: #fff; border-radius: var(--r-l); padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .12); margin-bottom: 28rpx;
}
.cc-top { display: flex; justify-content: space-between; align-items: center; }
.cc-tag { font-size: 22rpx; background: rgba(255, 255, 255, .22); border-radius: 999rpx; padding: 4rpx 16rpx; }
.cc-type { font-size: 24rpx; opacity: .85; }
.cc-name { font-size: 36rpx; font-weight: 700; margin-top: 20rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cc-sum { font-size: 64rpx; font-weight: 700; margin-top: 12rpx; }
.cc-count { font-size: 24rpx; opacity: .85; }
.cc-ops { display: flex; margin-top: 28rpx; }
.cc-ops .cc-op:not(:last-child) { margin-right: 16rpx; }
.cc-op {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: var(--r-s); font-size: 28rpx;
  background: rgba(255, 255, 255, .18); border: 2rpx solid rgba(255, 255, 255, .5);
}

/* 其他礼簿 */
.group-title { font-size: 24rpx; color: var(--text-3); margin: 8rpx 12rpx 12rpx; }
.book.archived { opacity: .75; }
.b-top { display: flex; align-items: center; margin-bottom: 8rpx; }
.b-name { font-size: 32rpx; font-weight: 600; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 事由标签：基于全局 .tag；喜事跟主题色，寿宴乔迁金色，白事/已归档素色 */
.b-top .tag { margin-left: 12rpx; background: var(--fill); color: var(--text-2); }
.b-top .tag.wedding, .b-top .tag.baby, .b-top .tag.other { background: var(--primary-soft); color: var(--primary); }
.b-top .tag.birthday, .b-top .tag.house { background: #B8860B1A; color: #B8860B; }
.b-top .tag.funeral { background: #3333331A; color: var(--text); }
.b-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-top: 16rpx; }
.b-foot > text { white-space: nowrap; margin-right: 16rpx; }
.b-ops { display: flex; align-items: center; flex-wrap: wrap; margin-left: auto; }
.b-ops .btn:not(:first-child), .b-ops .op-link { margin-left: 20rpx; }
.b-ops .btn { border-radius: 999rpx; }
.op-link { font-size: 24rpx; color: var(--link); }
.op-link.gray { color: var(--text-3); }

.fold { text-align: center; color: var(--link); font-size: 26rpx; padding: 16rpx 0 24rpx; }
.more-export { text-align: center; color: var(--text-3); font-size: 24rpx; padding: 8rpx 0 24rpx; }
.center { text-align: center; }
.pad { padding: 60rpx 0; }

/* 底部并排大按钮（全局 .bottom-bar + .btn-lg）：各占一半，新建实心、共享描边 */
.bottom-bar { display: flex; }
.bottom-bar .btn { flex: 1; border-radius: var(--r-m); }
.bottom-bar .btn:not(:last-child) { margin-right: 20rpx; }
.bb-plus { font-size: 34rpx; line-height: 1; }
.bb-icon { width: 36rpx; height: 36rpx; }
.bb-plus, .bb-icon { margin-right: 10rpx; }
.op-link.danger { color: var(--danger); }
