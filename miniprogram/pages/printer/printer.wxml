<view class="container" style="{{themeStyle}}">
  <view class="card">
    <view class="section-title">已保存打印机</view>
    <block wx:if="{{savedDevice}}">
      <view class="dev-row">
        <view>
          <view class="dev-name">{{savedDevice.name}}</view>
          <view class="muted">{{connected ? '已连接' : '未连接'}}</view>
        </view>
        <view class="dev-actions">
          <button wx:if="{{!connected}}" class="btn-plain sm" bindtap="onTest">连接并测试</button>
          <button wx:else class="btn-plain sm" bindtap="onDisconnect">断开</button>
        </view>
      </view>
    </block>
    <view wx:else class="muted">暂无，请在下方扫描添加</view>
    <button class="btn-primary" style="margin-top:24rpx" loading="{{testing}}" bindtap="onTest">打印测试页</button>
  </view>

  <view class="card">
    <view class="section-title scan-head">
      <text>附近的蓝牙设备</text>
      <text class="link" bindtap="toggleShowAll">{{showAll ? '只看打印机' : '显示全部设备'}}</text>
    </view>
    <block wx:if="{{discovering}}">
      <view class="dev-row" wx:for="{{devices}}" wx:key="deviceId">
        <view>
          <view class="dev-name">{{item.name}}</view>
          <view class="muted">{{item.deviceId}}</view>
        </view>
        <button class="btn-plain sm" data-id="{{item.deviceId}}" bindtap="onConnect">连接</button>
      </view>
      <view class="muted center pad">搜索中…（确认打印机已开机）</view>
      <button class="btn-plain" bindtap="onStopScan">停止搜索</button>
    </block>
    <block wx:else>
      <button class="btn-primary" bindtap="onScan">扫描蓝牙打印机</button>
      <view class="muted pad">支持 BLE 蓝牙热敏打印机（芯烨/汉印/佳博等）。如搜不到，点右上"显示全部设备"。</view>
    </block>
  </view>
</view>
