.login { padding-top: 100rpx; text-align: center; }

/* 印章：墨色双线方框，略微倾斜 */
.seal {
  width: 150rpx; height: 150rpx; margin: 0 auto;
  border: 6rpx solid #3A3A3A; border-radius: 16rpx;
  padding: 8rpx; box-sizing: border-box;
  transform: rotate(-6deg);
}
.seal-inner {
  width: 100%; height: 100%; box-sizing: border-box;
  border: 2rpx solid #3A3A3A; border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 84rpx; font-weight: 700; color: #3A3A3A;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}

.title { font-size: 48rpx; font-weight: 700; letter-spacing: 8rpx; color: #333; margin: 36rpx 0 8rpx; }
.slogan { font-size: 26rpx; color: #888; letter-spacing: 4rpx; }

.points { display: flex; justify-content: center; margin-top: 40rpx; }
.points .point:not(:last-child) { margin-right: 36rpx; }
.point { font-size: 26rpx; color: #555; }
.tick { color: var(--primary); font-weight: 700; margin-right: 8rpx; }

.form { margin-top: 56rpx; }
.avatar-btn { background: none; padding: 0; width: 140rpx; height: 140rpx; margin: 0 auto 8rpx; }
.avatar-btn::after { border: none; }
.avatar { width: 140rpx; height: 140rpx; border-radius: 50%; background: #eee; }
.avatar-tip { margin-bottom: 28rpx; }
.input {
  border: 2rpx solid #e5e5e5; border-radius: 12rpx;
  padding: 20rpx; margin-bottom: 32rpx; text-align: center;
}
