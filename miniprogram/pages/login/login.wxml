<view class="container login">
  <view class="logo">🧧</view>
  <view class="title">慧礼记</view>
  <view class="muted">记录礼尚往来，留存电子礼簿</view>

  <view class="card form">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatar || '/assets/avatar-default.png'}}" mode="aspectFill" />
    </button>
    <input class="input" type="nickname" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmit">登录 / 注册</button>
  </view>
</view>
