<view class="container login" style="{{themeStyle}}">
  <!-- 印章式标识：中性墨色，喜事、白事都适用 -->
  <view class="seal">
    <view class="seal-inner">礼</view>
  </view>
  <view class="title">慧礼记</view>
  <view class="slogan">礼尚往来 · 笔笔有据</view>

  <view class="points">
    <view class="point"><text class="tick">✓</text>电子礼簿</view>
    <view class="point"><text class="tick">✓</text>往来查询</view>
    <view class="point"><text class="tick">✓</text>回执留存</view>
  </view>

  <view class="card form">
    <!-- 未同意《隐私说明》前，头像 / 昵称不触发微信隐私接口：先弹同意提示（v3.84.0） -->
    <button wx:if="{{agreed}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatar || '/assets/avatar-default.png'}}" mode="aspectFill" binderror="onAvatarError" />
    </button>
    <button wx:else class="avatar-btn" bindtap="onNeedAgree">
      <image class="avatar" src="{{avatar || '/assets/avatar-default.png'}}" mode="aspectFill" binderror="onAvatarError" />
    </button>
    <view class="muted avatar-tip">点击设置头像</view>
    <view class="nick-wrap">
      <input class="input" type="{{agreed ? 'nickname' : 'text'}}" disabled="{{!agreed}}" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" bindnicknamereview="onNicknameReview" />
      <view class="nick-mask" wx:if="{{!agreed}}" bindtap="onNeedAgree"></view>
    </view>
    <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmit">登录 / 注册</button>
    <view class="agree-row">
      <view class="agree-hit" bindtap="toggleAgree" role="checkbox" aria-checked="{{agreed}}">
        <view class="ck {{agreed ? 'on' : ''}}"><text wx:if="{{agreed}}">✓</text></view>
        <text class="agree-txt">我已阅读并同意</text>
      </view>
      <text class="agree-link" catchtap="goPrivacy">《隐私说明》</text>
    </view>
  </view>
</view>
