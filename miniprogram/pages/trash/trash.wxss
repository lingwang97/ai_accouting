.intro { line-height: 1.7; }
.i-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.i-name { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-right: 16rpx; }
.tag { flex-shrink: 0; font-size: 22rpx; color: var(--text-3); background: var(--fill); border-radius: 6rpx; padding: 2rpx 12rpx; }
/* 底部：剩余天数在左，两个按钮大小一致在右（不用 gap，用 margin） */
.i-foot { display: flex; align-items: center; margin-top: 20rpx; padding-top: 16rpx; border-top: 2rpx solid #f5f5f5; }
.left { flex: 1; font-size: 24rpx; color: var(--text-3); }
.left.soon { color: var(--danger); }
button.t-op:not([size=mini]) { width: 160rpx; padding: 0; margin-left: 16rpx; }
