<view class="container" style="{{themeStyle}}">
  <view class="card muted intro">删除的礼簿和它的全部礼金记录会在这里保留一段时间，期间可以恢复，到期自动永久删除。<block wx:if="{{days}}">之后删除的礼簿保留 {{days}} 天（可在「我的 → 高级功能」修改），已经在这里的按各自剩余天数到期。</block></view>

  <view class="card item" wx:for="{{list}}" wx:key="_id">
    <view class="i-top">
      <text class="i-name">{{item.title}}</text>
      <text class="tag">{{item.typeLabel}}</text>
    </view>
    <view class="muted">{{item.count}} 份 · ￥{{item.sumStr}} · {{item.deletedStr}} 删除</view>
    <view class="i-foot">
      <text class="left {{item.leftDays <= 3 ? 'soon' : ''}}">{{item.busyText || ('还剩 ' + item.leftDays + ' 天')}}</text>
      <button class="btn btn-sm btn-danger t-op" disabled="{{busy}}" data-i="{{index}}" bindtap="onPurge">彻底删除</button>
      <button class="btn btn-sm btn-primary t-op" disabled="{{busy}}" data-i="{{index}}" bindtap="onRestore">恢复</button>
    </view>
  </view>

  <loading show="{{loading && !list.length}}" rows="3" />
  <view class="empty" wx:if="{{!loading && list.length === 0}}">回收站是空的</view>
</view>
