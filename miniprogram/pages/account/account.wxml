<view class="container" style="{{themeStyle}}">
  <!-- 主家：记账人提交的收款码，采用后才生效 -->
  <view class="card review" wx:for="{{reviews}}" wx:key="target">
    <view class="section-title">待确认的收款码 · {{item.name}}</view>
    <view class="muted">记账人「{{item.by}}」提交了新收款码。请核对是你本人的收款码，采用后宾客转账到新码。</view>
    <view class="rv-imgs">
      <view class="rv-col">
        <image class="rv-img" src="{{item.curUrl}}" mode="aspectFit" data-url="{{item.curUrl}}" bindtap="onPreview" />
        <view class="muted small">当前</view>
      </view>
      <view class="rv-col">
        <image class="rv-img new" src="{{item.url}}" mode="aspectFit" data-url="{{item.url}}" bindtap="onPreview" />
        <view class="muted small">新提交</view>
      </view>
    </view>
    <view class="btn-row">
      <view class="btn btn-outline" hover-class="btn-hover" data-idx="{{index}}" data-ok="{{false}}" bindtap="onDecide">驳回</view>
      <view class="btn btn-primary" hover-class="btn-hover" data-idx="{{index}}" data-ok="{{true}}" bindtap="onDecide">采用</view>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{!codeOnly}}">
      <view class="section-title">主家称呼</view>
      <input class="input" placeholder="建议真实姓名,如：张三" maxlength="20" value="{{accountName}}" bindinput="onNameInput" />
    </block>
    <view class="muted" wx:else>你可为「{{accountName}}」上传新收款码，主家确认后生效，确认前仍用原码。</view>

    <view class="section-title" style="margin-top:28rpx">微信个人收款码</view>
    <view class="paycode-box" bindtap="onChoosePayCode">
      <image wx:if="{{payCodeUrl}}" class="paycode" src="{{payCodeUrl}}" mode="aspectFit" />
      <view wx:else class="paycode-empty">
        <text style="font-size:64rpx">＋</text>
        <text class="muted">点击上传收款码截图</text>
      </view>
    </view>
    <view class="muted">在微信「二维码收款」页保存收款码后上传；宾客扫此码转账随礼</view>
    <view class="pending-note" wx:if="{{pendingNote}}">新收款码待主家确认后生效</view>
  </view>

  <view class="card" wx:if="{{!codeOnly}}">
    <view class="section-title">快捷礼金</view>
    <input class="input" placeholder="用逗号分隔，如：100,200,300,500,600,800,1000,1500,2000" value="{{quickText}}" bindinput="onQuickInput" />
    <view class="muted" style="margin-top:12rpx">宾客随礼时可一键选择<text class="link-inline" wx:if="{{quickText}}" bindtap="onClearQuick">清空</text></view>
  </view>

  <button class="btn-primary" loading="{{saving || uploading}}" bindtap="onSave">{{codeOnly ? '提交主家确认' : '保存'}}</button>
  <view class="clear-form" wx:if="{{!codeOnly}}" bindtap="onClearForm">清空重填</view>
  <loading show="{{pageLoading}}" type="overlay" />
</view>
<privacy-popup />
