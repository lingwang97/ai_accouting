<view class="container" style="{{themeStyle}}">
  <!-- 主家：记账人提交的收款码，采用后才生效 -->
  <view class="card review" wx:for="{{reviews}}" wx:key="target">
    <view class="section-title">待确认的收款码 · {{item.name}}</view>
    <view class="muted">记账人「{{item.by}}」提交了新的收款码。请核对是否为你本人的微信收款码，采用后宾客随礼转到新收款码。</view>
    <view class="rv-imgs">
      <view class="rv-col">
        <image class="rv-img" src="{{item.curUrl}}" mode="aspectFit" data-url="{{item.curUrl}}" bindtap="onPreview" />
        <view class="muted small">当前</view>
      </view>
      <view class="rv-col">
        <image class="rv-img new" src="{{item.url}}" mode="aspectFit" data-url="{{item.url}}" bindtap="onPreview" />
        <view class="muted small">新提交</view>
      </view>
    </view>
    <view class="rv-ops">
      <view class="rv-btn" data-idx="{{index}}" data-ok="{{false}}" bindtap="onDecide">驳回</view>
      <view class="rv-btn solid" data-idx="{{index}}" data-ok="{{true}}" bindtap="onDecide">采用</view>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{!codeOnly}}">
      <view class="section-title">主家称呼</view>
      <input class="input" placeholder="建议真实姓名,如：张三" value="{{accountName}}" bindinput="onNameInput" />
    </block>
    <view class="muted" wx:else>你只负责部分礼簿：可以为「{{accountName}}」上传新的收款码，主家确认采用后才生效，确认前宾客仍转到原收款码。</view>

    <view class="section-title" style="margin-top:28rpx">微信个人收款码</view>
    <view class="paycode-box" bindtap="onChoosePayCode">
      <image wx:if="{{payCodeUrl}}" class="paycode" src="{{payCodeUrl}}" mode="aspectFit" />
      <view wx:else class="paycode-empty">
        <text style="font-size:64rpx">＋</text>
        <text class="muted">点击上传收款码截图</text>
      </view>
    </view>
    <view class="muted">在微信"收付款"页截图"二维码收款"后上传；宾客向此码转账随礼</view>
    <view class="pending-note" wx:if="{{pendingNote}}">已提交的新收款码待主家确认，确认前宾客仍转到原收款码</view>
  </view>

  <view class="card" wx:if="{{!codeOnly}}">
    <view class="section-title">快捷礼金</view>
    <input class="input" placeholder="用逗号分隔，如：200,500,600,800,1000,1888" value="{{quickText}}" bindinput="onQuickInput" />
    <view class="muted" style="margin-top:12rpx">宾客随礼时可一键选择，清空后不显示快捷金额<text class="link-inline" wx:if="{{quickText}}" bindtap="onClearQuick">清空</text>；礼簿名称请到「我的 → 礼簿管理」设置；主题色请到「我的 → 外观设置」</view>
  </view>

  <button class="btn-primary" loading="{{saving || uploading}}" bindtap="onSave">{{codeOnly ? '提交主家确认' : '保存'}}</button>
  <view class="clear-form" wx:if="{{!codeOnly}}" bindtap="onClearForm">清空重填</view>
</view>
