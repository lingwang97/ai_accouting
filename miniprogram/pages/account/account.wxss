.input {
  border: 2rpx solid #e5e5e5; border-radius: 12rpx;
  padding: 20rpx; margin-bottom: 8rpx;
}
.paycode-box {
  width: 360rpx; height: 360rpx; margin: 20rpx auto;
  border: 2rpx dashed #ccc; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.paycode { width: 100%; height: 100%; }
.paycode-empty { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.colors { display: flex; gap: 24rpx; margin: 20rpx 0; }
.color-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 4rpx solid transparent;
}
.color-dot.on { border-color: #333; }
