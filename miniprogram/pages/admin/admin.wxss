.center { text-align: center; }
.row { display: flex; align-items: center; margin-top: 16rpx; }
.row switch, .row .btn { margin-left: 16rpx; flex-shrink: 0; }
/* 原生 button 的 margin 选择器权重更高，需同样写法才有间距 */
.row button.btn:not([size=mini]) { margin-left: 16rpx; }
.row > text:first-child { flex: 1; min-width: 0; }
.row .days { margin: 0 16rpx; }
.row.between { justify-content: space-between; margin-top: 0; }
.label { margin-top: 28rpx; }
.status { margin-top: 28rpx; line-height: 1.6; }
.save { margin-top: 24rpx; }
.plan { padding: 12rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.plan-name { font-weight: 600; }
.small { font-size: 22rpx; }
.tip { margin-top: 16rpx; line-height: 1.6; }
.input { font-size: 26rpx; }
.picker { min-width: 200rpx; }
.days { width: 140rpx; }
.idx-sum { margin-top: 20rpx; font-size: 26rpx; color: #333; }
.idx-row { display: flex; justify-content: space-between; font-size: 24rpx; padding: 10rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.idx-row .ok, .idx-row .bad { margin-left: 16rpx; }
.idx-row .ok { color: var(--success); text-align: right; }
.idx-row .bad { color: var(--danger); text-align: right; }
.flex1 { flex: 1; }
.host { padding: 16rpx 20rpx; border: 2rpx solid #eee; border-radius: 12rpx; margin-top: 12rpx; }
.host.on { border-color: var(--primary); background: var(--primary-soft); }
/* 数据清除 */
.danger-title { color: var(--danger); }
/* 折叠标题行（默认收起，点击展开） */
.fold { display: flex; align-items: center; background: #fff; border-radius: var(--r-m); padding: 26rpx 28rpx; margin-bottom: 24rpx; }
.fold-main { flex: 1; min-width: 0; }
.fold-title { font-size: 30rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.fold-sum { margin-top: 6rpx; font-size: 24rpx; color: var(--text-3); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.fold-sum.warn { color: var(--warn); }
.fold-sum.bad { color: var(--danger); }
.fold-arrow { margin-left: 16rpx; color: var(--text-3); font-size: 28rpx; flex-shrink: 0; }
.danger-fold .fold-title { color: var(--danger); }
.fold + .card { margin-top: -12rpx; }
.pv-head { margin-top: 24rpx; font-weight: 600; }
.backup-st { margin-left: 16rpx; }
.book-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-right: 16rpx; }
.log { padding: 14rpx 0; border-bottom: 2rpx solid #f5f5f5; font-size: 26rpx; }
.divider-line { height: 2rpx; background: #f0f0f0; margin: 28rpx 0 16rpx; }
/* 上线前检查（v3.72.2） */
.todo-bar { background: #FFF4E5; border: 2rpx solid #FFD8A8; border-radius: var(--r-m); padding: 22rpx 28rpx; margin-bottom: 24rpx; }
.todo-main { font-size: 30rpx; font-weight: 600; color: #B35C00; }
.todo-sub { margin-top: 6rpx; font-size: 24rpx; color: #B35C00; }
.pf-sum { margin-top: 20rpx; font-size: 26rpx; }
.pf-sum.bad, .pf-text.bad, .pf-mark.bad { color: var(--danger); }
.pf-sum.warn, .pf-text.warn, .pf-mark.warn { color: var(--warn); }
.pf-sum.ok, .pf-text.ok, .pf-mark.ok { color: var(--success); }
.pf-mark.manual, .pf-text.manual { color: var(--text-3); }
.pf-group { margin-top: 28rpx; font-size: 26rpx; font-weight: 600; color: var(--text-2, #555); }
.pf-row { display: flex; align-items: flex-start; padding: 14rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.pf-mark { width: 40rpx; flex-shrink: 0; font-size: 28rpx; font-weight: 600; }
.pf-body { flex: 1; min-width: 0; }
.pf-label { font-size: 26rpx; word-break: break-all; }
.pf-label.done { color: var(--text-3); }
.pf-text { margin-top: 4rpx; font-size: 24rpx; word-break: break-all; }
.pf-fix { margin-top: 4rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.5; word-break: break-all; }
.pf-box { width: 34rpx; height: 34rpx; flex-shrink: 0; margin: 2rpx 18rpx 0 0; border: 2rpx solid #ccc; border-radius: 6rpx; text-align: center; line-height: 32rpx; font-size: 24rpx; color: #fff; }
.pf-box.on { background: var(--primary); border-color: var(--primary); }
