<view class="container" style="{{themeStyle}}">
  <view class="card center muted" wx:if="{{loaded && !warmup}}">无管理员权限，或加载失败</view>

  <block wx:if="{{warmup}}">
    <view class="section-title">预热（减少云函数冷启动）</view>
    <view class="card">
      <view class="row between">
        <view>
          <view>启用预热</view>
          <view class="muted">定时唤醒常用云函数，打开小程序更快</view>
        </view>
        <switch checked="{{warmup.enabled}}" bindchange="onEnabled" color="{{primary}}" />
      </view>

      <block wx:if="{{warmup.enabled}}">
        <view class="label">模式</view>
        <view class="chips">
          <view class="chip {{warmup.mode === 'always' ? 'on' : ''}}" data-v="always" bindtap="onMode">始终预热</view>
          <view class="chip {{warmup.mode === 'paid' ? 'on' : ''}}" data-v="paid" bindtap="onMode">仅有付费用户时</view>
        </view>

        <view class="label">间隔</view>
        <view class="chips">
          <view class="chip {{warmup.intervalMin === item ? 'on' : ''}}" wx:for="{{intervals}}" wx:key="*this" data-v="{{item}}" bindtap="onInterval">{{item}} 分钟</view>
        </view>

        <view class="label">预热的云函数</view>
        <view class="chips">
          <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{funcs}}" wx:key="name" data-i="{{index}}" bindtap="onFunc">{{item.label}}</view>
        </view>
      </block>

      <view class="status muted">上次运行：{{statusText}}</view>
      <button class="btn-primary save" loading="{{saving}}" bindtap="onSaveWarmup">保存预热设置</button>
    </view>

    <view class="section-title">广告位（流量主）</view>
    <view class="card" wx:if="{{ads}}">
      <view class="row between">
        <view>
          <view>展示广告</view>
          <view class="muted small">需先在小程序后台开通流量主，并创建 Banner 广告单元</view>
        </view>
        <switch checked="{{ads.enabled}}" bindchange="onAdsEnabled" color="{{primary}}" />
      </view>
      <view class="label">广告单元 ID</view>
      <input class="input" placeholder="adunit-xxxxxxxx" value="{{ads.bannerUnit}}" bindinput="onAdsUnit" />
      <view class="label">展示位置</view>
      <view class="chips">
        <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{adSlots}}" wx:key="key" data-i="{{index}}" bindtap="onAdSlot">{{item.label}}</view>
      </view>
      <view class="row between" style="margin-top:24rpx">
        <view>白事礼簿相关页面不展示</view>
        <switch checked="{{ads.hideFuneral}}" bindchange="onAdsFuneral" color="{{primary}}" />
      </view>
      <view class="row between" style="margin-top:16rpx">
        <view>付费套餐用户不展示</view>
        <switch checked="{{ads.paidHide}}" bindchange="onAdsPaid" color="{{primary}}" />
      </view>
      <button class="btn-primary save" bindtap="onSaveAds">保存广告设置</button>
    </view>

    <view class="section-title">上线前检查</view>
    <view class="card">
      <view class="muted small tip">检查往来人标识密钥、必需集合和 AppSecret 配置。缺失的集合可一键创建；索引请用下方「数据库索引」。</view>
      <button class="btn-primary save" loading="{{pfLoading}}" bindtap="onPreflight">检查</button>
      <block wx:if="{{pf}}">
        <view class="idx-row"><text>往来人标识密钥</text><text class="{{pf.keyOk ? 'ok' : 'bad'}}">{{pf.keyText}}</text></view>
        <view class="idx-row"><text>必需集合（{{pf.total}} 个）</text><text class="{{pf.colsOk ? 'ok' : 'bad'}}">{{pf.colsOk ? '已齐全' : '缺 ' + pf.missing.length + ' 个：' + pf.missing.join('、')}}</text></view>
        <view class="idx-row"><text>WX_APPSECRET（system）</text><text class="{{pf.appSecret ? 'ok' : 'bad'}}">{{pf.appSecret ? '已配置' : '未配置，无法建索引'}}</text></view>
        <view class="idx-row"><text>小程序版本</text><text>{{pf.version}}</text></view>
        <button wx:if="{{!pf.colsOk}}" class="btn-primary save" loading="{{pfLoading}}" data-fix="1" bindtap="onPreflight">一键创建缺失集合</button>
        <view class="muted small tip">手动确认（云函数查不到集合权限）：在云开发控制台把下列集合都设为「所有用户不可读写」，其中 sys_config 存放密钥，尤其不能放开：{{pf.permCols}}。</view>
      </block>
    </view>

    <view class="section-title">数据库索引</view>
    <view class="card">
      <view class="muted small tip">一键创建查询索引（已存在的会跳过）。首次使用需在云函数 system 的环境变量添加 WX_APPSECRET。</view>
      <button class="btn-primary save" loading="{{indexing}}" bindtap="onIndexes">一键创建 / 检查索引</button>
      <view class="idx-sum" wx:if="{{indexSummary}}">{{indexSummary}}</view>
      <view class="idx-row" wx:for="{{indexResults}}" wx:key="name">
        <text>{{item.col}} · {{item.name}}</text>
        <text class="{{item.ok ? 'ok' : 'bad'}}">{{item.ok ? (item.existed ? '已存在' : '已创建') : item.msg}}</text>
      </view>
    </view>

    <view class="section-title">套餐与订阅（预留）</view>
    <view class="card">
      <view class="plan" wx:for="{{plans}}" wx:key="key">
        <view class="plan-name">{{item.name}} <text class="muted">（{{item.key}}）</text></view>
        <view class="muted small">{{item.featuresText}}</view>
      </view>
      <view class="muted small tip">目前所有功能对免费版开放，不做限制；套餐定义可在云数据库 settings 集合的 plans 记录中修改。</view>

      <view class="label">手动开通 / 延期</view>
      <view class="row" style="margin-top:0">
        <input class="input flex1" placeholder="搜索主家称呼 / 机构名称" value="{{hostKeyword}}" bindinput="onHostKeyword" bindconfirm="onFindHosts" />
        <button class="btn btn-outline" bindtap="onFindHosts">搜索</button>
      </view>
      <view class="host {{hostIdx === index ? 'on' : ''}}" wx:for="{{hosts}}" wx:key="ownerOpenid" data-i="{{index}}" bindtap="onPickHost">
        <view>{{item.accountName}}<text class="muted small" wx:if="{{item.orgName}}"> · {{item.orgName}}</text></view>
        <view class="muted small">{{item.planName}}<text wx:if="{{item.expiresStr}}">，到期 {{item.expiresStr}}</text></view>
      </view>
      <view class="muted small" style="margin:12rpx 0">也可直接填 openid（对方在「我的」长按版本号查看）</view>
      <input class="input" placeholder="主家 openid" value="{{subOpenid}}" bindinput="onSubOpenid" />
      <view class="row">
        <picker range="{{plans}}" range-key="name" value="{{planIdx}}" bindchange="onPlan">
          <view class="input picker">{{plans[planIdx].name}} ▾</view>
        </picker>
        <input class="input days" type="number" placeholder="天数" value="{{subDays}}" bindinput="onSubDays" />
        <text class="muted">天</text>
      </view>
      <button class="btn-outline save" bindtap="onSetPlan">确定</button>
    </view>

    <!-- 数据清除：不可恢复，均需预览、输入名称确认，并记操作日志 -->
    <view class="section-title danger-title">数据清除（不可恢复）</view>
    <view class="card">
      <view class="seg">
        <view class="seg-item {{purgeTab === 'account' ? 'on' : ''}}" data-t="account" bindtap="onPurgeTab">按账户</view>
        <view class="seg-item {{purgeTab === 'book' ? 'on' : ''}}" data-t="book" bindtap="onPurgeTab">按礼簿</view>
        <view class="seg-item {{purgeTab === 'orphan' ? 'on' : ''}}" data-t="orphan" bindtap="onPurgeTab">无主数据</view>
        <view class="seg-item {{purgeTab === 'logs' ? 'on' : ''}}" data-t="logs" bindtap="onPurgeTab">日志</view>
        <view class="seg-item {{purgeTab === 'wipe' ? 'on' : ''}}" wx:if="{{!launched}}" data-t="wipe" bindtap="onPurgeTab">全部</view>
      </view>

      <!-- 按账户 -->
      <block wx:if="{{purgeTab === 'account'}}">
        <view class="muted small tip">先在上方「手动开通」搜索并选中主家，或直接填 openid，再点「预览」。</view>
        <input class="input" placeholder="要清除的账户 openid" value="{{purgeOpenid || subOpenid}}" bindinput="onPurgeOpenid" />
        <view class="row between">
          <text>同时删除他作为宾客在别人礼簿里的随礼</text>
          <switch checked="{{purgeGuest}}" bindchange="onPurgeGuest" color="{{primary}}" />
        </view>
        <view class="muted small">默认不删：那些随礼属于别的主家的礼簿，删了对方账会对不上</view>
        <button class="btn-outline save" bindtap="onPurgePreview">预览将删除的数据</button>
        <block wx:if="{{purgePv}}">
          <view class="pv-head">「{{purgePv.name || '未命名'}}」<text class="muted small" wx:if="{{purgePv.orgName}}"> · {{purgePv.orgName}}</text></view>
          <view class="idx-row" wx:for="{{purgePv.rows}}" wx:key="label"><text>{{item.label}}</text><text>{{item.count}}</text></view>
          <view class="muted small" wx:if="{{!purgePv.rows.length}}">没有可删除的数据</view>
          <view class="muted small" wx:if="{{purgePv.guestRecordsCount}}">他在别人礼簿里另有 {{purgePv.guestRecordsCount}} 条随礼（保留）</view>
          <view class="row">
            <button class="btn btn-sm btn-outline" loading="{{backingUp}}" bindtap="onPurgeBackup">先备份</button>
            <text class="muted small backup-st">{{purgeBackup ? '已备份 ✓（7 天内可下载）' : ''}}</text>
          </view>
          <view class="row between">
            <text>{{purgeBackup ? '已备份' : '不需要备份'}}</text>
            <switch checked="{{purgeBackedUp}}" bindchange="onPurgeBackedUp" color="{{primary}}" />
          </view>
          <button class="btn-danger save" disabled="{{!purgeBackedUp || !purgePv.rows.length}}" loading="{{purging}}" bindtap="onPurgeRun">清除该账户数据</button>
        </block>
      </block>

      <!-- 按礼簿 -->
      <block wx:if="{{purgeTab === 'book'}}">
        <view class="row" style="margin-top:20rpx">
          <input class="input flex1" placeholder="礼簿名称 / 主家称呼 / 礼簿 id" value="{{bookKeyword}}" bindinput="onBookKeyword" bindconfirm="onBookSearch" />
          <button class="btn btn-outline" bindtap="onBookSearch">搜索</button>
        </view>
        <view class="host" wx:for="{{purgeBooks}}" wx:key="_id">
          <view class="row between">
            <view class="book-name">{{item.hostName ? item.hostName + ' · ' : ''}}{{item.name}}<text class="muted small"> · {{item.accountName}}</text></view>
            <view class="link danger" data-i="{{index}}" bindtap="onPurgeBook">删除</view>
          </view>
          <view class="muted small">{{item.date || '未设日期'}} · 礼金 {{item.count}} 条<text wx:if="{{item.archived}}"> · 已归档</text></view>
        </view>
      </block>

      <!-- 无主数据 -->
      <block wx:if="{{purgeTab === 'orphan'}}">
        <view class="muted small tip">已注销账户残留的礼簿、礼金、导出文件，已不存在的主家的人员关系，过期 30 天以上的邀请卡等。</view>
        <button class="btn-outline save" loading="{{orphanLoading}}" bindtap="onOrphanPreview">扫描</button>
        <block wx:if="{{orphanRows}}">
          <view class="idx-row" wx:for="{{orphanRows}}" wx:key="label"><text>{{item.label}}</text><text>{{item.count}}</text></view>
          <view class="muted small" wx:if="{{!orphanRows.length}}">没有无主数据</view>
          <button wx:if="{{orphanRows.length}}" class="btn-danger save" loading="{{purging}}" bindtap="onOrphanPurge">全部清理</button>
        </block>
      </block>

      <!-- 操作日志 -->
      <!-- 清除全部测试数据：上线前一次性使用，标记正式上线后永久消失 -->
      <block wx:if="{{purgeTab === 'wipe' && !launched}}">
        <view class="muted small tip">清除所有账户的礼簿、礼金、主家信息、用户、记账人、邀请、送礼、提醒、导出文件等测试数据；保留系统设置（管理员、预热、广告、模板）与操作日志。仅限正式上线前使用。</view>
        <view class="row between">
          <text>保留管理员自己的数据</text>
          <switch checked="{{wipeKeepAdmins}}" bindchange="onWipeKeep" color="{{primary}}" />
        </view>
        <button class="btn-outline save" bindtap="onWipePreview">预览将删除的数据</button>
        <block wx:if="{{wipeRows}}">
          <view class="idx-row" wx:for="{{wipeRows}}" wx:key="label"><text>{{item.label}}</text><text>{{item.count}}</text></view>
          <view class="muted small" wx:if="{{!wipeRows.length}}">没有可清除的数据</view>
          <button wx:if="{{wipeRows.length}}" class="btn-danger save" loading="{{wiping}}" bindtap="onWipeAll">清除全部测试数据</button>
        </block>
        <view class="divider-line"></view>
        <view class="muted small">测试数据清理完成、准备正式上线时：</view>
        <button class="btn-outline save" bindtap="onMarkLaunched">标记正式上线（永久关闭此功能）</button>
      </block>

      <block wx:if="{{purgeTab === 'logs'}}">
        <view class="log" wx:for="{{logs}}" wx:key="_id">
          <view>{{item.title}}</view>
          <view class="muted small">{{item.timeStr}} · {{item.detail}}</view>
        </view>
        <view class="muted small" wx:if="{{!logs.length}}">暂无清除记录</view>
      </block>
    </view>
  </block>
  <loading show="{{!loaded}}" type="overlay" />
</view>
