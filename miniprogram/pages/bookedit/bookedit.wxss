.input { border: 2rpx solid #e5e5e5; border-radius: 12rpx; padding: 18rpx 20rpx; }
.picker { color: #333; }
.gap { margin-top: 32rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 10rpx 30rpx; border-radius: 999rpx; background: #f2f3f5; color: #666; font-size: 28rpx; }
.chip.on { background: #07C160; color: #fff; }
