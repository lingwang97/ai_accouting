.picker { color: var(--text); }
.gap { margin-top: 32rpx; }
.paycode { width: 320rpx; height: 320rpx; display: block; margin: 0 auto 16rpx; }
.pc-ops { display: flex; align-items: center; }
.pc-ops .link { margin-left: 24rpx; }
.pc-btn { flex: 1; }

.load-fail { margin: 24rpx 0; padding: 20rpx; border-radius: 12rpx; background: rgba(250, 81, 81, 0.1); color: var(--danger); font-size: 26rpx; text-align: center; }
