.intro { line-height: 1.7; }
.row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.row .avatar { margin-right: 20rpx; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.name { flex: 1; font-size: 30rpx; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 姓名、说明过长省略，按钮不换行 */
.name > view, .b-info > view { overflow: hidden; text-overflow: ellipsis; }
.small { font-size: 22rpx; }
.name .tag { margin-left: 12rpx; }
.hint { text-align: center; margin: 16rpx 0 32rpx; line-height: 1.6; }
.transfer { margin-top: 16rpx; }
.btn-leave { margin-top: 32rpx; font-size: 28rpx; }
.pick-head { display: flex; justify-content: space-between; margin: 24rpx 0 8rpx; }
.center { text-align: center; }
.cancel { margin-top: 20rpx; }
.book-row { display: flex; align-items: center; padding: 18rpx 8rpx; border-bottom: 2rpx solid #f5f5f5; }
.book-row .check { margin-right: 20rpx; }
.check {
  width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; border: 2rpx solid #ccc;
  text-align: center; color: #fff; font-size: 24rpx; flex-shrink: 0;
}
.check.on { background: var(--primary); border-color: var(--primary); }
.b-info { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.stay-row { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; }
.stay-row switch { margin-left: 20rpx; }
.transfer-desc { background: #F7F7F7; border-radius: var(--r-s); padding: 16rpx 20rpx; font-size: 26rpx; color: #555; margin: 20rpx 0; line-height: 1.6; }
.chips { margin-top: 12rpx; }
.ed-list { max-height: 38vh; margin: 8rpx 0 16rpx; } /* 按屏幕高度，小屏不至于把「保存」挤到很下面 */
.row .link { margin-left: 36rpx; white-space: nowrap; flex-shrink: 0; }
.invite-desc { margin-top: 12rpx; }
/* 权限勾选：两列，不用 flex gap（旧版 iOS 不支持），用外边距 */
.perm-head { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.tpl-chips { margin: 0 -14rpx -14rpx 0; justify-content: flex-end; }
.tpl-chips .chip { padding: 6rpx 22rpx; font-size: 24rpx; }
.perm-grid { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.perm-item { width: 50%; display: flex; align-items: center; padding: 14rpx 0; box-sizing: border-box; }
.perm-item .check { margin-right: 14rpx; width: 36rpx; height: 36rpx; line-height: 36rpx; font-size: 22rpx; }
.perm-name { font-size: 26rpx; color: #333; }

/* 设置弹层：内容区可滚动，取消/保存固定在底部（含安全区） */
.sheet.ed-sheet { display: flex; flex-direction: column; overflow: hidden; padding-bottom: 0; }
.ed-body { flex: 1; min-height: 0; overflow-y: auto; }
.sheet-btns.ed-btns { flex-shrink: 0; margin-top: 0; padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 2rpx solid #f5f5f5; }
