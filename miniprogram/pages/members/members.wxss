.intro { line-height: 1.7; }
.row { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.name { flex: 1; font-size: 30rpx; }
.small { font-size: 22rpx; }
.tag { font-size: 20rpx; color: var(--primary); background: var(--primary-soft); border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx; }
.link.danger { color: #FA5151; font-size: 26rpx; }
.hint { text-align: center; margin: 16rpx 0 32rpx; line-height: 1.6; }
.transfer { margin-top: 16rpx; }
.btn-leave { margin-top: 32rpx; background: #fff; color: #FA5151; font-size: 28rpx; }
.pick-head { display: flex; justify-content: space-between; margin: 24rpx 0 8rpx; }
.link { color: #576B95; font-size: 26rpx; }
.center { text-align: center; }
.cancel { margin-top: 20rpx; }
.book-row { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 8rpx; border-bottom: 2rpx solid #f5f5f5; }
.check {
  width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; border: 2rpx solid #ccc;
  text-align: center; color: #fff; font-size: 24rpx; flex-shrink: 0;
}
.check.on { background: var(--primary); border-color: var(--primary); }
.b-info { flex: 1; }
.stay-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-top: 20rpx; }
.transfer-desc { background: #F7F7F7; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: #555; margin: 20rpx 0; line-height: 1.6; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }
.chip { padding: 8rpx 28rpx; border-radius: 999rpx; background: #f2f3f5; color: #666; font-size: 26rpx; }
.chip.on { background: var(--primary); color: #fff; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, .5); display: flex; align-items: flex-end; z-index: 10; }
.editor { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.ed-title { font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx; }
.ed-list { max-height: 560rpx; margin: 8rpx 0 16rpx; }
.ed-ops { display: flex; gap: 20rpx; margin-top: 20rpx; }
.ed-btn { flex: 1; font-size: 30rpx; }
.ed-btn.ok { background: var(--primary); color: #fff; }
.row .link { margin-left: 16rpx; white-space: nowrap; }
