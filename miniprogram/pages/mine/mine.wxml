<view class="container tab-page" style="{{themeStyle}}">
  <loading show="{{loading && !user}}" rows="3" />
  <!-- 未登录：宾客无需登录，主家登录后开始收礼 -->
  <view class="card center login-card" wx:if="{{!loading && !user}}">
    <image class="avatar big" src="/assets/avatar-default.png" />
    <view class="name">我是主家，开始收礼</view>
    <view class="muted">登录后可创建礼簿、登记礼金、打印回执</view>
    <button class="btn-primary" bindtap="goLogin">登录 / 注册</button>
  </view>

  <block wx:if="{{user}}">
    <!-- 用户信息与身份 -->
    <view class="card user-card">
      <image class="avatar" src="{{user.avatar || '/assets/avatar-default.png'}}" mode="aspectFill" />
      <view class="info">
        <view class="name">{{user.nickname}}</view>
        <view class="muted">{{account ? (role === 'clerk' ? '记账人 · 为「' + account.accountName + '」记账' : (role === 'viewer' ? '家人共享 · 查看「' + account.accountName + '」的礼簿' : '主家：' + account.accountName)) : '尚未完善主家信息'}}</view>
        <view class="plan-tag" wx:if="{{planText}}">{{planText}}</view>
      </view>
      <view class="switch-id" wx:if="{{identities.length > 1 || role === 'clerk' || role === 'viewer'}}" bindtap="onSwitchIdentity">切换身份 ›</view>
    </view>

    <!-- 未完善主家信息 -->
    <view class="card center" wx:if="{{!account}}">
      <view class="section-title">还没有礼簿</view>
      <view class="muted" style="margin-bottom:20rpx">要办事收礼？3 步创建：主家称呼、微信收款码、第一本礼簿</view>
      <button class="btn-primary" bindtap="goSetup">立即创建</button>
    </view>

    <block wx:if="{{role !== 'viewer'}}">
    <view class="group-title">账号与收款</view>
    <view class="card menu">
      <view class="menu-item" bindtap="goAccount" wx:if="{{role !== 'clerk' || pm.info || pm.paycode}}">
        <image class="mi-icon" src="/assets/icons/user-m.svg" /><text class="mi-text">{{role === 'clerk' && !pm.info ? '收款码（申请更换）' : '主家信息与收款码'}}</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMembers" wx:if="{{account}}">
        <image class="mi-icon" src="/assets/icons/people-m.svg" /><text class="mi-text">{{account.orgMode ? '礼台人员' : '记账人'}}</text><text class="arrow"><text class="muted">邀请 / 移交主家</text> ›</text>
      </view>
      <view class="menu-item" wx:if="{{account && orgAllowed && role === 'owner'}}" bindtap="onOrgName">
        <image class="mi-icon" src="/assets/icons/layers-m.svg" />
        <view class="mi-text">
          <view>机构模式</view>
          <view class="muted">{{account.orgMode ? (account.orgName || '点此填写机构名称') : '一个账号办多场，每场单独设主家与收款码'}}</view>
        </view>
        <switch checked="{{account.orgMode}}" catchtap="noop" bindchange="onOrgSwitch" color="{{primary}}" />
      </view>
    </view>

    </block>

    <view class="group-title">样式与设备</view>
    <view class="card menu">
      <view class="menu-item" bindtap="goPrinter">
        <image class="mi-icon" src="/assets/icons/printer-m.svg" /><text class="mi-text">蓝牙打印机</text><text class="arrow"><text class="muted">{{printerName || '未连接'}}</text> ›</text>
      </view>
      <view class="menu-item" bindtap="goStyle" wx:if="{{account && !readonly && pm.style}}">
        <image class="mi-icon" src="/assets/icons/receipt-m.svg" /><text class="mi-text">回执样式</text><text class="arrow"><text class="muted">电子回执 / 打印小票</text> ›</text>
      </view>
      <!-- 主题色：仅主家本人 -->
      <view class="menu-item" bindtap="goAppearance" wx:if="{{account && role === 'owner'}}">
        <image class="mi-icon" src="/assets/icons/palette-m.svg" /><text class="mi-text">主题色</text><text class="arrow">›</text>
      </view>
    </view>

    <block wx:if="{{account && ((role !== 'viewer' && pm.export) || role === 'owner')}}">
      <view class="group-title">数据管理</view>
      <view class="card menu">
        <view class="menu-item" bindtap="goExport" wx:if="{{role !== 'viewer' && pm.export}}">
          <image class="mi-icon" src="/assets/icons/export-m.svg" /><text class="mi-text">导出与备份</text><text class="arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goTrash" wx:if="{{role === 'owner'}}">
          <image class="mi-icon" src="/assets/icons/trash-m.svg" /><text class="mi-text">回收站</text><text class="arrow"><text class="muted">删除的礼簿保留 15 天</text> ›</text>
        </view>
      </view>
    </block>

    <view class="group-title">帮助与隐私</view>
    <view class="card menu">
      <view class="menu-item" bindtap="goGuide">
        <image class="mi-icon" src="/assets/icons/book-m.svg" /><text class="mi-text">使用教程</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onPrivacy">
        <image class="mi-icon" src="/assets/icons/lock-m.svg" /><text class="mi-text">隐私说明</text><text class="arrow">›</text>
      </view>
      <view class="menu-item purge" bindtap="confirmPurge">
        <image class="mi-icon" src="/assets/icons/trash-m.svg" /><text class="mi-text">清除我的全部数据</text><text class="arrow">›</text>
      </view>
    </view>

    <block wx:if="{{isAdmin}}">
      <view class="group-title">管理员</view>
      <view class="card menu">
        <view class="menu-item" bindtap="goAdmin">
          <image class="mi-icon" src="/assets/icons/settings-m.svg" /><text class="mi-text">系统设置</text><text class="arrow"><text class="muted">预热 / 套餐</text> ›</text>
        </view>
      </view>
    </block>

    <view class="card menu">
      <view class="menu-item logout" bindtap="onLogout">退出登录</view>
    </view>
  </block>
  <view class="version muted" bindlongpress="onShowOpenid">{{versionText}}</view>
</view>
