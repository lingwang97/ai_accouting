.page { padding: 24rpx 24rpx 200rpx; }
.head { background: #fff; border-radius: var(--r-m); padding: 24rpx; margin-bottom: 20rpx; }
.sum { font-size: 30rpx; color: var(--text); margin-bottom: 20rpx; }
.sum .num { font-size: 40rpx; font-weight: 700; color: #FF9F1C; }
.head .seg { background: var(--fill); }

.empty { padding: 120rpx 0; color: var(--text); }
.empty-icon { font-size: 96rpx; color: var(--success); }

/* 列表批量 */
.tools { display: flex; align-items: center; margin-bottom: 16rpx; }
.tools .link { margin-left: 20rpx; }
.search { flex: 1; background: #fff; border-radius: var(--r-s); padding: 16rpx 20rpx; }
.item {
  display: flex; flex-wrap: wrap; align-items: center; background: #fff; border-radius: var(--r-m);
  padding: 24rpx; margin-bottom: 16rpx;
}
.item.picked { box-shadow: 0 0 0 3rpx var(--primary) inset; }
.check {
  width: 44rpx; height: 44rpx; line-height: 44rpx; border-radius: 50%; border: 2rpx solid #ccc;
  text-align: center; color: #fff; font-size: 26rpx; margin-right: 20rpx; flex-shrink: 0;
}
.check.on { background: var(--primary); border-color: var(--primary); }
.info { flex: 1; min-width: 0; }
.payer { font-size: 32rpx; font-weight: 600; margin-right: 16rpx; }
/* 姓名过长省略，金额与标签不换行 */
.name-row { display: flex; align-items: center; }
.name-row .payer { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.name-row .amt, .name-row .cash-tag { flex-shrink: 0; white-space: nowrap; }
.amt { font-size: 34rpx; }
.ops { display: flex; align-items: center; margin-left: 20rpx; flex-shrink: 0; }
.ops .btn { margin-left: 20rpx; }
/* 第 2 行：说明在左（过长省略），操作在右 */
.meta-row { display: flex; align-items: center; margin-top: 8rpx; }
.meta { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ok-sm { width: 120rpx; height: 56rpx; line-height: 56rpx; padding: 0; font-size: 26rpx; }
/* 批量确认栏：基于全局 .bottom-bar */
.batch-bar { display: flex; align-items: center; justify-content: space-between; }
.batch-bar .muted { margin: 0 16rpx; }

/* 逐笔大字 */
.remain { text-align: center; color: var(--text-3); font-size: 28rpx; margin: 8rpx 0 20rpx; }
.big-card { background: #fff; border-radius: var(--r-l); padding: 56rpx 32rpx; text-align: center; }
.big-name { font-size: 72rpx; font-weight: 700; color: var(--text); }
.big-amount { font-size: 96rpx; font-weight: 700; color: #FA5151; margin: 20rpx 0 24rpx; }
.big-meta { font-size: 32rpx; color: #555; margin-bottom: 8rpx; word-break: break-all; }
.tip { text-align: center; margin: 28rpx 0 20rpx; }
/* 逐笔大按钮：特大点击区域，颜色取全局 .btn-primary / .btn-danger */
.btn-big { font-size: 40rpx; font-weight: 600; border-radius: var(--r-m); padding: 16rpx 0; margin-bottom: 24rpx; }
.mismatch { font-size: 28rpx; padding: 12rpx 0; }
.center { text-align: center; }
.pad { padding: 40rpx 0; }
.cash-tag { font-size: 22rpx; color: #FF9F1C; background: #FFF7E6; border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx; }
.big-cash { font-size: 32rpx; color: #FF9F1C; font-weight: 600; margin-bottom: 16rpx; }

/* 批次录入 */
/* 批次：整行「查看明细」按钮，点击区域大 */
.batch-more {
  width: 100%; margin-top: 20rpx; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: var(--r-s);
  background: var(--primary-soft); color: var(--primary); font-size: 28rpx; font-weight: 600;
}
.batch-more-hover { opacity: .7; }
.pm-tag { font-size: 22rpx; color: var(--success); background: #E8F8EF; border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx; font-weight: normal; }
.pm-tag.cash { color: #FF9F1C; background: #FFF7E6; }
/* 批次明细底部弹层 */
.sh-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.sh-head .sheet-title { margin-bottom: 0; }
.sh-close { width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; font-size: 36rpx; color: var(--text-3); margin-right: -16rpx; }
.sh-list { max-height: 600rpx; }
.sh-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.sh-info { flex: 1; min-width: 0; }
.sh-name { font-size: 30rpx; color: var(--text); display: flex; align-items: center; }
.sh-nm { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sh-name .pm-tag { flex-shrink: 0; }
.sh-amt { font-size: 32rpx; margin-left: 20rpx; flex-shrink: 0; }
.sh-sum { text-align: right; font-size: 32rpx; margin-top: 20rpx; }
.sh-sub { text-align: right; margin-top: 6rpx; }
.sh-mismatch { font-size: 28rpx; padding: 20rpx 0; }
.batch-rows { margin-top: 12rpx; background: #F7F7F7; border-radius: 10rpx; padding: 8rpx 16rpx; }
.batch-rows.big { margin: 8rpx 0 16rpx; text-align: left; font-size: 30rpx; }
.batch-row { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.batch-rows.big .batch-row { font-size: 30rpx; }
.ed-tip { margin-bottom: 16rpx; }
.ed-list { max-height: 640rpx; }
.ed-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.ed-name { font-size: 30rpx; flex: 1; min-width: 0; margin-right: 20rpx; }
.ed-nm { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.small { font-size: 22rpx; }
.ed-input { width: 220rpx; flex-shrink: 0; border: 2rpx solid var(--border); border-radius: var(--r-s); padding: 12rpx 16rpx; text-align: right; font-size: 32rpx; }
.ed-sum { text-align: right; font-size: 30rpx; margin: 20rpx 0; }
.notify-tip { background: #FFF7E6; color: #D46B08; border-radius: var(--r-s); padding: 18rpx 24rpx; font-size: 26rpx; margin-bottom: 20rpx; }
.nt-go { float: right; color: var(--primary); }

/* 逐笔模式：左右切换 */
.card-nav { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 20rpx; }
.card-nav .remain { flex: 1; margin: 0; }
.nav-arrow { width: 72rpx; height: 72rpx; line-height: 68rpx; text-align: center; font-size: 52rpx; color: var(--primary); border-radius: 50%; background: #fff; flex-shrink: 0; }
.nav-arrow.off { color: var(--text-3); opacity: .4; }
.big-card.slide-l { animation: slideL .26s ease-out; }
.big-card.slide-r { animation: slideR .26s ease-out; }
@keyframes slideL { from { transform: translateX(60rpx); opacity: .3; } to { transform: none; opacity: 1; } }
@keyframes slideR { from { transform: translateX(-60rpx); opacity: .3; } to { transform: none; opacity: 1; } }
