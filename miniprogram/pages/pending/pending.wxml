<view class="page" style="{{themeStyle}}">
  <!-- 汇总 + 模式切换 -->
  <view class="head">
    <view class="sum">
      <text class="num">{{total}}</text> 份待确认礼金 · 共 <text class="money">￥{{sumStr}}</text>
    </view>
    <view class="cur-book" wx:if="{{bookName}}">当前{{unit}}：{{bookName}}（只处理这一{{unit === '场次' ? '场' : '本'}}）</view>
    <view class="other-tip" wx:if="{{otherCount > 0}}" bindtap="goSwitch">
      <text class="other-text">其他{{unit}}还有 {{otherCount}} 份待确认礼金</text>
      <text class="other-go">去切换 ›</text>
    </view>
    <view class="other-tip" wx:if="{{hiddenCount > 0}}">
      <text class="other-text">一次最多显示 100 笔，还有 {{hiddenCount}} 笔待确认，处理后会自动补上</text>
    </view>
    <view class="seg" wx:if="{{canConfirm}}">
      <view class="seg-item {{mode === 'list' ? 'on' : ''}}" data-m="list" bindtap="onMode">列表批量</view>
      <view class="seg-item {{mode === 'card' ? 'on' : ''}}" data-m="card" bindtap="onMode">逐笔确认</view>
    </view>
  </view>

  <view class="notify-tip" wx:if="{{roleReady && !canConfirm}}">你没有「确认收礼」权限，只能查看待确认礼金，由主家或其他记账人确认</view>
  <view class="notify-tip" wx:elif="{{notifyTip}}" bindtap="onSubscribe">🔔 {{notifyTip}} <text class="nt-go">开启 ›</text></view>

  <!-- 宾客登记后没点「我已完成转账」：常见于转完账直接回聊天，主家核对微信到账后可直接入簿 -->
  <view class="card stall" wx:if="{{canConfirm && stalled.length}}">
    <view class="stall-title">宾客未点「我已完成转账」（{{stalled.length}}）</view>
    <view class="muted small">宾客可能转完账就离开了，也可能还在转账（3 分钟内登记的不会出现在这里）。请核对微信是否收到：收到的点「已收到」入簿，确实没收到的点「未收到」</view>
    <view class="stall-row" wx:for="{{stalled}}" wx:key="_id" wx:if="{{stallAll || index < 3}}">
      <view class="stall-info">
        <view class="stall-name"><text class="payer">{{item.nameStr}}</text><text class="money">￥{{item.amountStr}}</text></view>
        <view class="muted small">{{item.timeStr}} 登记 · {{item.auto ? '已自动取消' : '未点完成'}} · {{item.methodText}}</view>
        <view class="muted small others" wx:if="{{item.batch}}">同批：{{item.othersStr}}</view>
        <view class="ops stall-ops">
          <button class="btn btn-sm btn-outline op-btn wide" wx:if="{{item.batch}}" data-id="{{item._id}}" catchtap="onOpenSheet">明细（{{item.records.length}} 人）</button>
          <button class="btn btn-sm btn-danger op-btn" data-id="{{item._id}}" catchtap="onStallReject">未收到</button>
          <button class="btn btn-sm btn-primary op-btn" data-id="{{item._id}}" catchtap="onStallConfirm">已收到</button>
        </view>
      </view>
    </view>
    <view class="link center stall-more" wx:if="{{stalled.length > 3}}" bindtap="onStallAll">{{stallAll ? '收起' : '查看全部 ' + stalled.length + ' 笔'}}</view>
  </view>

  <!-- 最近 24 小时内标记「未收到」的：点错了可撤销 -->
  <view class="card stall" wx:if="{{canConfirm && rejected.length}}">
    <view class="stall-title">最近标记「未收到」（{{rejected.length}}）</view>
    <view class="muted small">24 小时内可撤销，撤销后回到标记前的状态</view>
    <view class="stall-row" wx:for="{{rejected}}" wx:key="_id">
      <view class="stall-info">
        <view class="stall-name"><text class="payer">{{item.nameStr}}</text><text class="money">￥{{item.amountStr}}</text></view>
        <view class="muted small">{{item.timeStr}} 标记未收到</view>
        <view class="ops stall-ops">
          <button class="btn btn-sm btn-outline op-btn" data-id="{{item._id}}" catchtap="onUnreject">撤销未收到</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 首次加载完成前显示加载中，避免空状态闪现 -->
  <block wx:if="{{!loaded}}"><loading show="{{true}}" rows="3" /></block>
  <view class="empty" wx:elif="{{total === 0}}">
    <view class="empty-icon">✓</view>
    <view>全部处理完了</view>
    <view class="muted">新礼金到达时会自动出现在这里</view>
  </view>

  <!-- 列表批量 -->
  <block wx:elif="{{mode === 'list'}}">
    <view class="tools">
      <input class="search" placeholder="搜索宾客姓名" value="{{keyword}}" bindinput="onKeyword" />
      <view class="link" wx:if="{{canConfirm && total > 1}}" bindtap="onToggleSelect">{{selectMode ? '取消' : '批量确认'}}</view>
    </view>

    <view class="item {{item.picked ? 'picked' : ''}}" wx:for="{{shown}}" wx:key="_id" data-id="{{item._id}}" bindtap="onPick">
      <view class="check {{item.picked ? 'on' : ''}}" wx:if="{{selectMode}}">{{item.picked ? '✓' : ''}}</view>
      <view class="info">
        <view class="name-row"><text class="payer">{{item.nameStr}}</text><text class="money amt">￥{{item.amountStr}}</text><text class="cash-tag" wx:if="{{!item.mixed && item.payMethod === 'cash'}}">💵 现金</text></view>
        <!-- 批次：同一批的其余几位 -->
        <view class="muted others" wx:if="{{item.batch}}">同批：{{item.othersStr}}</view>
        <!-- 单笔：说明在左、操作在右；批次：说明独占一行，操作在下一行 -->
        <view class="meta-row">
          <view class="muted meta">{{item.timeStr}} {{item.methodText}}<text wx:if="{{item.relation}}"> · {{item.relation}}</text><text wx:if="{{item.remark}}"> · {{item.remark}}</text></view>
          <view class="ops" wx:if="{{canConfirm && !selectMode && !item.batch}}">
            <button class="btn btn-sm btn-danger op-btn" data-id="{{item._id}}" catchtap="onReject">未收到</button>
            <button class="btn btn-sm btn-primary op-btn" data-id="{{item._id}}" catchtap="onConfirm">确认</button>
          </view>
        </view>
        <view class="ops batch-ops" wx:if="{{item.batch && canConfirm && !selectMode}}">
          <button class="btn btn-sm btn-outline op-btn wide" data-id="{{item._id}}" catchtap="onOpenSheet">明细（{{item.records.length}} 人）</button>
          <button class="btn btn-sm btn-danger op-btn" data-id="{{item._id}}" catchtap="onReject">未收到</button>
          <button class="btn btn-sm btn-primary op-btn" data-id="{{item._id}}" catchtap="onConfirm">确认</button>
        </view>
      </view>
      <!-- 批次（没有确认权限或批量勾选时）：整行查看明细；catchtap 不触发勾选 -->
      <view class="batch-more" wx:if="{{item.batch && (!canConfirm || selectMode)}}" hover-class="batch-more-hover" data-id="{{item._id}}" catchtap="onOpenSheet">查看明细（{{item.records.length}} 人）›</view>
    </view>
    <view class="muted center pad" wx:if="{{keyword && shown.length === 0}}">没有找到「{{keyword}}」</view>

    <view class="bottom-bar batch-bar" wx:if="{{selectMode}}">
      <view class="link" bindtap="onPickAll">全选/全不选</view>
      <view class="muted">已选 {{pickedCount}} 份 · ￥{{pickedSum}}</view>
      <button class="btn btn-primary" disabled="{{pickedCount === 0}}" bindtap="onConfirmPicked">确认收到</button>
    </view>
  </block>

  <!-- 逐笔大字 -->
  <block wx:else>
    <view class="card-mode" wx:if="{{current}}">
      <!-- 左右滑动（或点两侧箭头）切换待确认的账单 -->
      <view class="card-nav">
        <view class="nav-arrow {{cardCount > 1 ? '' : 'off'}}" bindtap="onCardPrev">‹</view>
        <view class="remain">第 {{cardIdx + 1}} / {{cardCount}} 笔 · 共 {{total}} 份</view>
        <view class="nav-arrow {{cardCount > 1 ? '' : 'off'}}" bindtap="onCardNext">›</view>
      </view>
      <view class="big-card {{slide}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
        <view class="big-name">{{current.nameStr}}</view>
        <view class="big-amount {{current.amountStr.length >= 11 ? 'md' : ''}}">￥{{current.amountStr}}</view>
        <view class="big-cash" wx:if="{{current.mixed}}">转账+现金：转账 ￥{{current.wechatSumStr}} · 现金 ￥{{current.cashSumStr}}</view>
        <view class="big-cash" wx:elif="{{current.payMethod === 'cash'}}">💵 现金，请当面清点</view>
        <view class="big-meta" wx:if="{{current.relation}}">{{current.relation}}</view>
        <view class="big-meta" wx:if="{{current.remark}}">礼品/备注：{{current.remark}}</view>
        <view class="batch-rows big" wx:if="{{current.batch}}">
          <view class="batch-row" wx:for="{{current.records}}" wx:for-item="r" wx:key="_id">
            <text>{{r.nameStr}}<text class="muted" wx:if="{{r.relation}}"> · {{r.relation}}</text><text class="pm-tag {{r.payMethod === 'cash' ? 'cash' : ''}}" wx:if="{{current.mixed}}">{{r.payMethod === 'cash' ? '现金' : '转账'}}</text></text>
            <text class="money">￥{{r.amountStr}}</text>
          </view>
        </view>
        <view class="muted">{{current.timeStr}} {{current.mixed ? '转账+现金' : (current.payMethod === 'cash' ? '宾客现金' : '已转账')}}</view>
      </view>
      <view class="tip muted">{{current.mixed ? '请核对微信转账与现金合计与上面的金额一致' : (current.payMethod === 'cash' ? '请清点现金与上面的金额一致' : '请核对微信已收到上面的金额')}}</view>
      <button class="btn-primary btn-big" disabled="{{busy}}" bindtap="onCardOk">确认收到</button>
      <button class="btn-danger btn-big" disabled="{{busy}}" bindtap="onCardNo">没收到</button>
      <view class="link center mismatch" bindtap="onCardMismatch">金额不一致？按实际到账入簿</view>
    </view>
  </block>

  <!-- 批次明细：底部弹层，点遮罩或 ✕ 关闭 -->
  <view class="mask" wx:if="{{sheet}}" bindtap="onCloseSheet">
    <view class="sheet" catchtap="noop">
      <view class="sh-head">
        <view class="sheet-title">批次明细（{{sheet.records.length}} 人）<text class="cash-tag">{{sheet.methodLabel}}</text></view>
        <view class="sh-close" catchtap="onCloseSheet">✕</view>
      </view>
      <scroll-view scroll-y class="sh-list">
        <view class="sh-row" wx:for="{{sheet.records}}" wx:for-item="r" wx:key="_id">
          <view class="sh-info">
            <view class="sh-name"><text class="sh-nm">{{r.nameStr}}</text><text class="pm-tag {{r.payMethod === 'cash' ? 'cash' : ''}}">{{r.payMethod === 'cash' ? '现金' : '转账'}}</text></view>
            <view class="muted small" wx:if="{{r.relation || r.remark}}">{{r.relation}}<text wx:if="{{r.relation && r.remark}}"> · </text>{{r.remark}}</view>
          </view>
          <text class="money sh-amt">￥{{r.amountStr}}</text>
        </view>
      </scroll-view>
      <view class="sh-sum">合计 <text class="money">￥{{sheet.amountStr}}</text></view>
      <view class="muted sh-sub" wx:if="{{sheet.mixed}}">转账 ￥{{sheet.wechatSumStr}} · 现金 ￥{{sheet.cashSumStr}}</view>
      <view class="link center sh-mismatch" wx:if="{{canConfirm}}" bindtap="onSheetMismatch">金额不一致？按实际金额入簿</view>
      <view class="sheet-btns" wx:if="{{canConfirm}}">
        <button class="btn btn-lg btn-danger" disabled="{{busy}}" data-id="{{sheet._id}}" bindtap="onReject">未收到</button>
        <button class="btn btn-lg btn-primary" disabled="{{busy}}" data-id="{{sheet._id}}" bindtap="onConfirm">确认收到</button>
      </view>
    </view>
  </view>

  <!-- 批次：逐人按实际金额入簿 -->
  <view class="mask" wx:if="{{editor}}">
    <view class="sheet">
      <view class="sheet-title">按实际金额入簿</view>
      <view class="muted ed-tip">{{editor.group.nameStr}} · 宾客登记合计 ￥{{editor.group.amountStr}}</view>
      <scroll-view scroll-y class="ed-list">
        <view class="ed-row" wx:for="{{editor.rows}}" wx:key="_id">
          <view class="ed-name"><view class="ed-nm">{{item.name}}</view><view class="muted small">登记 ￥{{item.declared}}</view></view>
          <input class="ed-input" type="digit" maxlength="11" cursor-spacing="120" adjust-position value="{{item.value}}" data-i="{{index}}" bindinput="onEditInput" />
        </view>
      </scroll-view>
      <view class="ed-sum">实际合计 <text class="money">￥{{editor.sumStr}}</text></view>
      <view class="sheet-btns">
        <button class="btn btn-lg btn-plain" bindtap="onEditCancel">取消</button>
        <button class="btn btn-lg btn-primary" disabled="{{busy}}" bindtap="onEditSave">按此入簿</button>
      </view>
    </view>
  </view>
</view>
