<view class="container" style="{{themeStyle}}">
  <view class="card">
    <view class="section-title">导出范围</view>
    <picker range="{{books}}" range-key="name" value="{{bookIdx}}" bindchange="onBook">
      <view class="date-box full">{{books[bookIdx].name}}<text wx:if="{{bookIdx > 0}}" class="muted">（整本）</text> <text class="arrow">▾</text></view>
    </picker>
  </view>

  <view class="card" wx:if="{{bookIdx === 0}}">
    <view class="section-title">日期范围</view>
    <view class="chips presets">
      <view wx:for="{{presets}}" wx:key="key"
            class="chip {{preset === item.key ? 'on' : ''}}" data-k="{{item.key}}" bindtap="onPreset">{{item.label}}</view>
    </view>
    <view class="range">
      <picker mode="date" value="{{startDay}}" end="{{today}}" bindchange="onStart">
        <view class="date-box">{{startDay}}</view>
      </picker>
      <text class="muted">至</text>
      <picker mode="date" value="{{endDay}}" end="{{today}}" bindchange="onEnd">
        <view class="date-box">{{endDay}}</view>
      </picker>
    </view>
  </view>

  <view class="card muted desc">
    仅包含主家已确认入簿的礼金。生成后可在预览页右上角「···」转发给好友或「文件传输助手」存档；云端文件下载后即删除。
  </view>

  <button wx:if="{{bookIdx > 0}}" class="btn-primary" loading="{{exporting === 'book'}}" disabled="{{!!exporting}}" bindtap="onExportBook">传统礼簿 PDF（竖排，适合打印留存）</button>
  <view wx:else class="muted hint">传统礼簿 PDF 需选择一本礼簿整本导出</view>
  <button class="btn-outline" style="margin-top:24rpx" loading="{{exporting === 'pdf'}}" disabled="{{!!exporting}}" bindtap="onExportPdf">表格 PDF（明细 + 合计）</button>
  <button class="btn-outline" style="margin-top:24rpx" loading="{{exporting === 'xlsx'}}" disabled="{{!!exporting}}" bindtap="onExportXlsx">Excel（适合再统计）</button>

  <view class="card backup">
    <view class="section-title">一键备份</view>
    <view class="muted">把全部礼簿、礼金明细和送礼记录导出为一个 Excel，建议定期发到「文件传输助手」保存。</view>
    <button class="btn-outline" style="margin-top:20rpx" loading="{{exporting === 'backup'}}" disabled="{{!!exporting}}" bindtap="onBackup">备份全部数据</button>
  </view>
  <ad-slot slot="exportDone" book-type="{{books[bookIdx].type || ''}}" />
  <loading show="{{pageLoading}}" type="overlay" />
</view>
