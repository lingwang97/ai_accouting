/* 分段切换：同「往来」页 */
.seg { margin-bottom: 24rpx; }
.intro { margin: -8rpx 4rpx 16rpx; line-height: 1.6; }
.small { font-size: 24rpx; }
.sec-title { font-size: 26rpx; color: var(--text-3); margin: 28rpx 8rpx 14rpx; font-weight: 600; }

/* 步骤卡片（不用 gap，用 margin） */
.step { display: flex; align-items: flex-start; background: #fff; border-radius: var(--r-m); padding: 28rpx; margin-bottom: 20rpx; }
.num {
  width: 48rpx; height: 48rpx; line-height: 48rpx; border-radius: 50%; flex-shrink: 0; margin-right: 20rpx;
  text-align: center; background: var(--primary); color: #fff; font-size: 26rpx; font-weight: 600;
}
.body { flex: 1; min-width: 0; }
.title { font-size: 30rpx; font-weight: 600; color: #333; line-height: 48rpx; }
.desc { font-size: 26rpx; color: #888; margin-top: 6rpx; line-height: 1.6; }
.where { font-size: 24rpx; color: var(--primary); margin-top: 8rpx; }
.go { display: inline-block; margin-top: 12rpx; font-size: 26rpx; color: var(--primary); padding: 4rpx 0; }

/* ===== 示意图：简化的界面 ===== */
.mock { margin-top: 16rpx; background: var(--fill); border-radius: 12rpx; padding: 16rpx; font-size: 22rpx; color: var(--text-2); }
.hl { position: relative; border: 3rpx solid var(--primary) !important; color: var(--primary) !important; font-weight: 600; background: #fff; }
.m-tap { display: inline-block; margin-left: 8rpx; font-size: 18rpx; color: #fff; background: var(--primary); border-radius: 6rpx; padding: 0 8rpx; font-weight: normal; }

/* 工作台宫格：三行两列 */
.m-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.m-tile { width: 48.5%; box-sizing: border-box; background: #fff; border: 3rpx solid transparent; border-radius: 10rpx; padding: 14rpx 12rpx; margin-bottom: 10rpx; word-break: break-all; }

/* 「我的」菜单 */
.m-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.m-avatar { width: 40rpx; height: 40rpx; border-radius: 50%; background: #ddd; margin-right: 12rpx; }
.m-nick { flex: 1; }
.m-head-btn { border: 3rpx solid transparent; border-radius: 8rpx; padding: 4rpx 10rpx; }
.m-row { display: flex; justify-content: space-between; align-items: center; background: #fff; border: 3rpx solid transparent; border-radius: 8rpx; padding: 10rpx 14rpx; margin-bottom: 6rpx; }
.m-arrow { color: #ccc; }

/* 底部菜单页 */
.m-bar { display: flex; justify-content: flex-end; margin-bottom: 12rpx; }
.m-btn { background: #fff; border: 3rpx solid transparent; border-radius: 8rpx; padding: 6rpx 14rpx; margin-left: 10rpx; }
.m-line { height: 18rpx; background: #fff; border-radius: 6rpx; margin-bottom: 8rpx; }
.m-line.short { width: 60%; }
.m-rec { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 6rpx; padding: 6rpx 10rpx; margin-bottom: 8rpx; }
.m-rec .m-btn { margin-left: 0; padding: 2rpx 12rpx; }
.m-tabbar { display: flex; background: #fff; border-radius: 8rpx; margin-top: 10rpx; }
.m-tabitem { flex: 1; text-align: center; padding: 8rpx 0; }
.m-tabitem.on { color: var(--primary); font-weight: 600; }

/* 操作顺序 */
.m-flow { display: flex; flex-wrap: wrap; align-items: center; }
.m-node { background: #fff; border: 3rpx solid transparent; border-radius: 8rpx; padding: 6rpx 12rpx; margin: 4rpx 0; }
.m-arrow-r { margin: 0 8rpx; color: #bbb; }
