/* 分段切换：同「往来」页 */
.seg { margin-bottom: 24rpx; }

/* 步骤卡片（不用 gap，用 margin） */
.step { display: flex; align-items: flex-start; background: #fff; border-radius: var(--r-m); padding: 28rpx; margin-bottom: 20rpx; }
.num {
  width: 48rpx; height: 48rpx; line-height: 48rpx; border-radius: 50%; flex-shrink: 0; margin-right: 20rpx;
  text-align: center; background: var(--primary); color: #fff; font-size: 26rpx; font-weight: 600;
}
.body { flex: 1; min-width: 0; }
.title { font-size: 30rpx; font-weight: 600; color: #333; line-height: 48rpx; }
.desc { font-size: 26rpx; color: #888; margin-top: 6rpx; line-height: 1.6; }
.go { display: inline-block; margin-top: 12rpx; font-size: 26rpx; color: var(--primary); padding: 4rpx 0; }
