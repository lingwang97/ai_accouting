.a-head { display: flex; align-items: center; justify-content: space-between; }
.a-title { font-size: 32rpx; font-weight: 600; }
.a-vip { font-size: 22rpx; color: var(--warn); background: var(--warn-bg); border: 2rpx solid var(--warn-border); border-radius: 999rpx; padding: 2rpx 16rpx; }
.a-desc { font-size: 26rpx; line-height: 1.6; margin: 8rpx 0 12rpx; }
.a-opt { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.a-opt:last-of-type { border-bottom: none; }
.a-opt.dis { opacity: .45; }
.a-radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid var(--text-3); margin-right: 20rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.a-opt.on .a-radio { border-color: var(--primary); }
.a-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--primary); }
.a-text { flex: 1; min-width: 0; }
.a-name { font-size: 30rpx; }
.a-sub { font-size: 24rpx; line-height: 1.5; margin-top: 4rpx; }
.a-note { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: var(--warn-bg); color: var(--warn); font-size: 24rpx; line-height: 1.6; }
