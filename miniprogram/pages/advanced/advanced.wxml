<view class="container" style="{{themeStyle}}">
  <view class="muted a-loading" wx:if="{{!ready || (hasAccount && !planReady)}}">加载中…</view>
  <view class="card" wx:if="{{ready && !hasAccount}}">
    <view class="a-title">高级功能</view>
    <view class="muted a-desc">还没有礼簿，创建礼簿后可在这里设置机构模式、工作台刷新频率等</view>
  </view>

  <block wx:if="{{hasAccount && planReady}}">
    <!-- 机构模式 -->
    <view class="card">
      <view class="a-head" bindtap="onOrgTap">
        <view class="a-headtext">
          <view class="a-line"><text class="a-title">机构模式</text><text class="a-vip" wx:if="{{org.vip}}">会员</text></view>
          <view class="muted a-sub">一个账号办多场，每场单独设主家与收款码；记账人称「礼台人员」，礼簿称「场次」。普通模式同一时间只记一本礼簿；同一天办多场、分场次收礼请打开机构模式。</view>
        </view>
        <view catchtap="onOrgTap"><switch checked="{{orgMode}}" disabled="{{!org.enabled}}" bindchange="onOrgSwitch" color="{{primary}}" /></view>
      </view>
      <view class="a-reason" wx:if="{{!org.enabled}}">{{org.reason}}</view>
      <view class="a-orgname" wx:if="{{orgMode}}" bindtap="onOrgName">
        <text class="a-name">机构名称</text>
        <text class="muted a-orgv">{{orgName || '点此填写'}} ›</text>
      </view>
    </view>

    <!-- 工作台刷新频率（默认收起，点标题行展开） -->
    <view class="card">
      <view class="a-head" bindtap="onPollHead">
        <view class="a-headtext">
          <view class="a-line"><text class="a-title">工作台刷新频率</text><text class="a-vip" wx:if="{{poll.vip}}">会员</text></view>
        </view>
        <text class="muted a-cur">{{levelName}}</text>
        <text class="a-arrow {{pollOpen ? 'open' : ''}}">›</text>
      </view>
      <view class="a-reason" wx:if="{{poll.reason}}">{{poll.reason}}</view>
      <block wx:if="{{pollOpen}}">
      <view class="muted a-desc">宾客转账后，工作台、待确认页、礼簿页多久自动刷新一次。更快的档位能更早看到新转账，设置跟随你的账号，换手机也沿用。</view>
      <view class="a-opt {{level === item.key ? 'on' : ''}} {{item.enabled ? '' : 'dis'}}"
            wx:for="{{options}}" wx:key="key" data-key="{{item.key}}" bindtap="onPick">
        <view class="a-radio"><view class="a-dot" wx:if="{{level === item.key}}" /></view>
        <view class="a-text">
          <view class="a-name">{{item.name}}</view>
          <view class="muted a-sub">{{item.desc}}</view>
        </view>
      </view>
      <view class="a-note">高刷新会增加云开发调用量。选了更快的档位后，连续 30 分钟没有新转账会自动退回标准；离开页面或切到后台时停止刷新。家人共享（只读）不受影响。</view>
      </block>
    </view>

    <!-- 新礼金微信提醒（默认关闭，按人开启；不是会员功能） -->
    <view class="card">
      <view class="a-head" bindtap="onGiftTap">
        <view class="a-headtext">
          <view class="a-line"><text class="a-title">新礼金微信提醒</text></view>
          <view class="muted a-sub">宾客点完成转账后，通过微信服务通知提醒你；关闭时请开着工作台或待确认页查看</view>
        </view>
        <view catchtap="onGiftTap"><switch checked="{{giftOn}}" disabled="{{!gift.enabled}}" bindchange="onGiftSwitch" color="{{primary}}" /></view>
      </view>
      <view class="a-reason" wx:if="{{gift.reason}}">{{gift.reason}}</view>
    </view>

    <!-- 办事日高峰模式 -->
    <view class="card">
      <view class="a-head" bindtap="onPeakTap">
        <view class="a-headtext">
          <view class="a-line"><text class="a-title">办事日高峰模式</text><text class="a-vip" wx:if="{{peak.vip}}">会员</text></view>
          <view class="muted a-sub">办事当天一键开启：{{peakHours}} 小时内工作台、待确认、礼簿页每 3 秒刷新，并提前唤醒云端，响应更快；时间到自动恢复，你原来的刷新设置不变。</view>
        </view>
        <view catchtap="onPeakTap"><switch checked="{{peak.on}}" disabled="{{!peak.enabled}}" bindchange="onPeakSwitch" color="{{primary}}" /></view>
      </view>
      <view class="a-reason" wx:if="{{peak.reason}}">{{peak.reason}}</view>
      <view class="a-note" wx:if="{{peak.on}}">已开启，还剩 {{peak.leftText}}。礼台人员（有「确认收礼」权限）也会自动按 3 秒刷新。刷新更频繁会增加云开发调用量，办事结束后可手动关闭。</view>
    </view>

    <!-- 回收站保留时间（默认收起） -->
    <view class="card">
      <view class="a-head" bindtap="onTrashHead">
        <view class="a-headtext">
          <view class="a-line"><text class="a-title">回收站保留时间</text><text class="a-vip" wx:if="{{trash.vip}}">会员</text></view>
        </view>
        <text class="muted a-cur">{{trashDays}} 天</text>
        <text class="a-arrow {{trashOpen ? 'open' : ''}}">›</text>
      </view>
      <view class="a-reason" wx:if="{{trash.reason}}">{{trash.reason}}</view>
      <block wx:if="{{trashOpen}}">
        <view class="muted a-desc">删除的礼簿在回收站保留多久，期间可以恢复，到期自动永久删除。</view>
        <view class="a-opt {{trashDays === item.days ? 'on' : ''}} {{item.enabled ? '' : 'dis'}}"
              wx:for="{{trashOptions}}" wx:key="days" data-days="{{item.days}}" bindtap="onTrashPick">
          <view class="a-radio"><view class="a-dot" wx:if="{{trashDays === item.days}}" /></view>
          <view class="a-text"><view class="a-name">{{item.name}}</view></view>
        </view>
        <view class="a-note">只影响之后删除的礼簿；已经在回收站里的，仍按删除时定下的到期日处理，不会因为改了这里而变长或变短。</view>
      </block>
    </view>

    <!-- 数量额度（只显示，主家侧） -->
    <view class="card" wx:if="{{quota.show}}" bindtap="onQuotaTap">
      <view class="a-line"><text class="a-title">数量额度</text><text class="a-vip" wx:if="{{quota.limited && !ad.member}}">会员可提升</text></view>
      <view class="muted a-sub">{{quota.bookLine}}</view>
      <view class="muted a-sub">{{quota.clerkLine}}</view>
      <view class="a-reason" wx:if="{{quota.full}}">{{quota.reason}}</view>
    </view>

    <!-- 去广告（会员权益，纯展示） -->
    <view class="card" wx:if="{{ad.show}}">
      <view class="a-head" bindtap="onAdTap">
        <view class="a-headtext">
          <view class="a-line"><text class="a-title">去广告</text><text class="a-vip">会员</text></view>
          <view class="muted a-sub">{{ad.text}}</view>
        </view>
        <text class="muted a-cur">{{ad.member ? '已开通' : '未开通'}}</text>
      </view>
    </view>
  </block>
</view>
