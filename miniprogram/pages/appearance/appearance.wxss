/* 预览区域：根节点写入所选颜色的 --primary / --primary-soft */
.preview { background: #F7F7F7; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.pv-book {
  background: var(--primary); color: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .12);
}
.pv-top { display: flex; justify-content: space-between; align-items: center; }
.pv-name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pv-switch {
  flex-shrink: 0; margin-left: 16rpx; height: 56rpx; line-height: 56rpx; padding: 0 22rpx; border-radius: 28rpx; white-space: nowrap;
  background: rgba(255, 255, 255, .22); border: 2rpx solid rgba(255, 255, 255, .6); font-size: 24rpx; font-weight: 600;
}
.pv-label { font-size: 24rpx; opacity: .8; margin-top: 20rpx; }
.pv-sum { font-size: 60rpx; font-weight: 700; margin: 4rpx 0 12rpx; }
.pv-foot { display: flex; justify-content: space-between; font-size: 24rpx; opacity: .9; }
.pv-btn {
  margin-top: 24rpx; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 12rpx;
  background: var(--primary); color: #fff; font-size: 30rpx;
}
.pv-tabs { display: flex; margin-top: 24rpx; background: #fff; border-radius: 12rpx; padding: 12rpx 0; border-top: 1px solid #eee; }
.pv-tab { flex: 1; display: flex; flex-direction: column; align-items: center; }
.pv-icon { width: 24px; height: 24px; }
.pv-text { font-size: 10px; color: #999; margin-top: 2px; }
.pv-text.on { color: var(--primary); }

.colors { display: flex; margin: 8rpx 0 20rpx; }
.color-dot { width: 64rpx; height: 64rpx; border-radius: 50%; border: 4rpx solid transparent; box-sizing: border-box; }
.color-dot:not(:last-child) { margin-right: 28rpx; }
.color-dot.on { border-color: #fff; box-shadow: 0 0 0 4rpx #333; }
.muted { line-height: 1.6; }
