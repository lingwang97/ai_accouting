<wxs module="o" src="/utils/orgtext.wxs"></wxs>
<view class="container wrap" style="{{themeStyle}}">
  <block wx:if="{{book}}">
    <!-- 吸顶：示意图随当前标签切换（封面 / 内页 / 封底），下面只显示该页的设置 -->
    <view class="sticky-pv">
      <view class="pv-head">
        <view class="book-name">{{book.name}}</view>
        <view class="pv-fold" wx:if="{{pv}}" bindtap="onTogglePv">{{pvOpen ? '收起示意图' : '展开示意图'}}</view>
      </view>
      <swiper wx:if="{{pv && pvOpen}}" class="pv-swiper" current="{{cur}}" bindchange="onSwipe" duration="250">
        <!-- 封面 -->
        <swiper-item>
          <view class="pc {{pv.full ? 'full' : ''}}" style="background:{{pv.bg}};border-color:{{pv.border}};color:{{pv.text}}">
            <image class="pc-fullimg" wx:if="{{pv.full}}" src="{{pv.photo}}" mode="{{pv.photoStyle ? 'scaleToFill' : 'aspectFill'}}" style="{{pv.photoStyle}}opacity:{{pv.fade ? 0.5 : 1}}" />
            <view class="pc-scrim-g" wx:if="{{pv.full && pv.scrim === 'gradient'}}" style="background:linear-gradient(to bottom, rgba(0,0,0,0), {{pv.bg}} 45%)"></view>
            <view class="pc-scrim-b" wx:if="{{pv.full && pv.scrim === 'block'}}" style="background:{{pv.bg}}"></view>
            <view class="pc-in" style="border-color:{{pv.border}}"></view>
            <view class="pc-mark" wx:if="{{pv.mark}}" style="color:{{pv.border}};{{pvf.mark}}">{{pv.mark}}</view>
            <block wx:if="{{pv.corners}}">
              <view class="pc-cn pc-tl" style="color:{{pv.border}}">{{pv.corners[0]}}</view>
              <view class="pc-cn pc-tr" style="color:{{pv.border}}">{{pv.corners[1]}}</view>
              <view class="pc-cn pc-bl" style="color:{{pv.border}}">{{pv.corners[2]}}</view>
              <view class="pc-cn pc-br" style="color:{{pv.border}}">{{pv.corners[3]}}</view>
            </block>
            <view class="pc-band pc-band-t" wx:if="{{pv.band}}" style="color:{{pv.border}}">{{pv.band}}</view>
            <view class="pc-band pc-band-b" wx:if="{{pv.band}}" style="color:{{pv.border}}">{{pv.band}}</view>
            <view class="pc-photo {{pv.shape === 'oval' ? 'oval' : ''}}" wx:if="{{pv.left}}" style="border-color:{{pv.border}};opacity:{{pv.fade ? 0.5 : 1}}"><image src="{{pv.photo}}" mode="{{pv.photoStyle ? 'scaleToFill' : 'aspectFill'}}" style="{{pv.photoStyle}}" /></view>
            <view class="pc-deco {{pv.left ? 'has-photo' : ''}}" wx:if="{{pv.decoTxt}}" style="color:{{pv.border}}">{{pv.decoTxt}}</view>
            <view class="pc-mid {{pv.left ? 'has-photo' : ''}} {{pv.full ? 'full' : ''}}">
              <view class="pc-title" style="color:{{pv.border}};{{pvf.main}}">{{pv.title}}</view>
              <view class="pc-line" style="background:{{pv.border}}"></view>
              <view class="pc-sm" wx:for="{{pv.info}}" wx:key="*this" style="{{pvf.sub}}">{{item}}</view>
            </view>
            <view class="pc-foot {{pv.left ? 'has-photo' : ''}}" style="color:{{pv.border}};{{pvf.main}}" wx:if="{{pv.footer}}">{{pv.footer}}</view>
            <view class="pc-brand {{pv.left ? 'has-photo' : ''}}" style="{{pvf.sub}}">慧礼记</view>
          </view>
        </swiper-item>
        <!-- 内页（右起，本礼簿前几位宾客） -->
        <swiper-item>
          <view class="pc pg" style="border-color:{{pg.line}}">
            <view class="pc-mark" wx:if="{{pv.mark}}" style="color:{{pg.line}};opacity:.06;{{pvf.mark}}">{{pv.mark}}</view>
            <view class="pg-gut" wx:if="{{bind !== 'none'}}" style="{{pg.gut}}"><text>装订边</text></view>
            <view class="pg-head" style="color:{{pg.line}};{{pvf.main}}">{{pg.head}}</view>
            <view class="pg-grid" style="{{pg.grid}};border-color:{{pg.line}};color:#222">
              <view class="pg-slot" wx:for="{{pg.slots}}" wx:key="i" style="border-color:{{pg.line}}">
                <view class="pg-nm" style="border-color:{{pg.line}}"><text class="pg-c" style="{{pvf.main}}" wx:for="{{item.name}}" wx:for-item="ch" wx:for-index="ci" wx:key="ci">{{ch}}</text></view>
                <view class="pg-am">
                  <text class="pg-ca" style="{{pvf.sub}}" wx:for="{{item.amt}}" wx:for-item="ch" wx:for-index="ci" wx:key="ci">{{ch}}</text>
                  <text class="pg-yen" style="{{pvf.sub}}" wx:if="{{item.yen}}">{{item.yen}}</text>
                </view>
              </view>
            </view>
          </view>
        </swiper-item>
        <!-- 封底 -->
        <swiper-item>
          <view wx:if="{{!back.on}}" class="pc pc-none">不含封底</view>
          <view wx:else class="pc" style="background:{{pv.bg}};border-color:{{pv.border}};color:{{pv.text}}">
            <view class="pc-in" style="border-color:{{pv.border}}"></view>
            <view class="pc-mark" wx:if="{{pv.mark}}" style="color:{{pv.border}};{{pvf.mark}}">{{pv.mark}}</view>
            <block wx:if="{{pv.corners}}">
              <view class="pc-cn pc-tl" style="color:{{pv.border}}">{{pv.corners[0]}}</view>
              <view class="pc-cn pc-tr" style="color:{{pv.border}}">{{pv.corners[1]}}</view>
              <view class="pc-cn pc-bl" style="color:{{pv.border}}">{{pv.corners[2]}}</view>
              <view class="pc-cn pc-br" style="color:{{pv.border}}">{{pv.corners[3]}}</view>
            </block>
            <view class="pc-mid">
              <view class="pc-title" wx:if="{{bk.foot}}" style="color:{{pv.border}};font-size:36rpx;letter-spacing:6rpx;{{pvf.main}}">{{bk.foot}}</view>
              <view class="pc-line" wx:if="{{bk.foot}}" style="background:{{pv.border}}"></view>
              <view class="pc-sign" wx:if="{{back.sign}}" style="{{pvf.sub}}"><view>{{bk.sign}}</view></view>
            </view>
            <view class="pc-brand" wx:if="{{back.brand}}" style="{{pvf.sub}}">慧礼记</view>
          </view>
        </swiper-item>
      </swiper>
      <view class="pv-tabs" wx:if="{{pv}}">
        <view class="pv-tab {{cur === 0 ? 'on' : ''}}" data-i="0" bindtap="onTab">封面</view>
        <view class="pv-tab {{cur === 1 ? 'on' : ''}}" data-i="1" bindtap="onTab">内页</view>
        <view class="pv-tab {{cur === 2 ? 'on' : ''}}" data-i="2" bindtap="onTab">封底</view>
      </view>
    </view>
    <image class="dim-loader" wx:if="{{coverSet && coverUrl && !photoDim && !isFuneral}}" src="{{coverUrl}}" bindload="onPhotoLoad" binderror="onPhotoErr" />
    <view class="lock-tip" wx:if="{{lockTip}}">{{lockTip}}</view>
    <view class="muted tip">示意图仅供参考，点「预览」看真实效果{{pvSample ? '（内页暂无数据，用示例）' : ''}}{{pvLoading ? ' · 字体加载中…' : (pvNone ? ' · 预览字体未上传，示意图暂用系统字体' : (pvFail ? ' · 字体加载失败，示意图暂用系统字体' : ''))}}</view>

    <!-- ============ 封面标签：样式 → 纹样 → 照片 ============ -->
    <block wx:if="{{cur === 0}}">
    <!-- 喜事：预设 + 自定义 -->
    <view class="card" wx:if="{{!isFuneral}}">
      <view class="section-title">主题</view>
      <view wx:if="{{defTip}}" class="def-tip">{{defTip}}</view>
      <view class="themes">
        <view wx:for="{{presets}}" wx:key="key" class="th {{themeKey === item.key ? 'on' : ''}} {{themeKey === 'custom' && base === item.key ? 'base' : ''}}" data-k="{{item.key}}" bindtap="onPickTheme">
          <view class="th-sw" style="background:{{item.main}};border-color:{{item.accent}}"><view class="th-in" style="background:{{item.accent}}"></view></view>
          <view class="th-name">{{item.name}}</view>
          <view class="th-scene">{{item.scene}}</view>
          <view class="th-vip" wx:if="{{item.locked}}">会员</view>
        </view>
        <view class="th {{themeKey === 'custom' ? 'on' : ''}}" data-k="custom" bindtap="onPickTheme">
          <view class="th-sw th-custom">＋</view>
          <view class="th-name">自定义</view>
          <view class="th-scene">{{base ? '基于预设修改' : '自选配色字体'}}</view>
          <view class="th-vip" wx:if="{{!premiumOk}}">会员</view>
        </view>
      </view>
      <view wx:if="{{themeKey !== 'custom'}}" class="edit-link" bindtap="onEditPreset">在此主题基础上修改 ›{{premiumOk ? '' : '（会员）'}}</view>
    </view>

    <view class="card cust" wx:if="{{!isFuneral && themeKey === 'custom'}}">
      <view class="section-title">自定义</view>
      <view class="cust-lb">主色（封面底色、格线）</view>
      <view class="swatches">
        <view wx:for="{{mainColors}}" wx:key="*this" class="sw {{cust.main === item ? 'on' : ''}}" style="background:{{item}}" data-f="main" data-v="{{item}}" bindtap="onCust"></view>
      </view>
      <input class="input" cursor-spacing="120" adjust-position="{{true}}" bindfocus="onKbOn" bindblur="onKbOff" value="{{cust.main}}" maxlength="7" placeholder="#RRGGBB" data-f="main" bindinput="onCustInput" />
      <view class="cust-lb">辅色（边框、标题）</view>
      <view class="swatches">
        <view wx:for="{{accentColors}}" wx:key="*this" class="sw {{cust.accent === item ? 'on' : ''}}" style="background:{{item}}" data-f="accent" data-v="{{item}}" bindtap="onCust"></view>
      </view>
      <input class="input" cursor-spacing="120" adjust-position="{{true}}" bindfocus="onKbOn" bindblur="onKbOff" value="{{cust.accent}}" maxlength="7" placeholder="#RRGGBB" data-f="accent" bindinput="onCustInput" />
      <view wx:if="{{custErr}}" class="cust-err">{{custErr}}</view>
      <view class="cust-lb">角饰</view>
      <view class="chips"><view wx:for="{{patterns}}" wx:key="k" class="chip {{cust.pattern === item.k ? 'on' : ''}}" data-f="pattern" data-v="{{item.k}}" bindtap="onCust">{{item.n}}</view></view>
      <view class="cust-lb">{{o.t('封面标题（不填用礼簿名）', org)}}</view>
      <input class="input" cursor-spacing="120" adjust-position="{{true}}" bindfocus="onKbOn" bindblur="onKbOff" value="{{cust.title}}" maxlength="20" placeholder="如：李王联姻志喜" data-f="title" bindinput="onCustInput" />
      <view class="cust-lb">封面落款（不填则没有）</view>
      <input class="input" cursor-spacing="120" adjust-position="{{true}}" bindfocus="onKbOn" bindblur="onKbOff" value="{{cust.footer}}" maxlength="8" placeholder="如：百年好合" data-f="footer" bindinput="onCustInput" />
    </view>

    <!-- 白事：颜色固定素灰，封面只能改角饰、水印、标题、落款（字体在「内页」标签） -->
    <view class="card cust" wx:if="{{isFuneral}}">
      <view class="section-title">白事封面样式</view>
      <view class="muted">白事颜色固定素灰</view>
      <view wx:if="{{defTip}}" class="def-tip">{{defTip}}</view>
      <view class="cust-lb">角饰</view>
      <view class="chips"><view wx:for="{{fPatterns}}" wx:key="k" class="chip {{fun.pattern === item.k ? 'on' : ''}}" data-f="pattern" data-v="{{item.k}}" bindtap="onFun">{{item.n}}</view></view>
      <view class="cust-lb">{{o.t('封面标题（不填用礼簿名）', org)}}</view>
      <input class="input" cursor-spacing="120" adjust-position="{{true}}" bindfocus="onKbOn" bindblur="onKbOff" value="{{fun.title}}" maxlength="20" placeholder="如：某某先生奠仪簿" data-f="title" bindinput="onFunInput" />
      <view class="cust-lb">封面落款</view>
      <view class="chips">
        <view class="chip {{fun.footer === '' ? 'on' : ''}}" data-f="footer" data-v="" bindtap="onFun">无</view>
        <view wx:for="{{fFooters}}" wx:key="*this" class="chip {{fun.footer === item ? 'on' : ''}}" data-f="footer" data-v="{{item}}" bindtap="onFun">{{item}}</view>
      </view>
      <input class="input" cursor-spacing="120" adjust-position="{{true}}" bindfocus="onKbOn" bindblur="onKbOff" value="{{fun.footer}}" maxlength="8" placeholder="也可以自己写（8 字以内）" data-f="footer" bindinput="onFunInput" />
    </view>

      <view class="muted tip font-hint">字体：{{fontName}}　水印：{{markName}} · 在「内页」标签修改</view>
    <!-- 封面纹样（v3.79.0）：矢量图案，导出时画在封面上；按事由有默认 -->
    <view class="card cust">
      <view class="section-title">封面纹样</view>
      <view class="chips"><view wx:for="{{decos}}" wx:key="k" class="chip {{deco === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="onDeco">{{item.n}}</view></view>
      <view class="muted tip" wx:if="{{isFuneral}}">白事封面只提供素雅的松枝、白菊线条</view>
      <view class="muted tip" wx:else>「按事由」：喜事用囍字、寿宴用团寿、满月用月星、乔迁用方胜、其他用回纹带</view>
    </view>

    <!-- 封面照片（白事不使用）：上传 / 移除立即生效；形状、版式、托底、焦点为草稿，随预览 / 导出 / 只保存样式一起提交 -->
    <view class="card cust" wx:if="{{!isFuneral && canSave}}">
      <view class="section-title">封面照片{{photoOk ? '' : '（会员功能）'}}</view>
      <view class="photo-row">
        <view class="photo-th {{coverShape === 'oval' ? 'oval' : ''}}">
          <image wx:if="{{coverSet && coverUrl}}" src="{{coverUrl}}" mode="aspectFill" />
          <text wx:else>{{coverSet ? '已设置' : '无'}}</text>
        </view>
        <view class="photo-btns">
          <button class="btn-outline photo-btn" disabled="{{photoBusy}}" bindtap="onPickPhoto">{{coverSet ? '更换照片' : '选择照片'}}</button>
          <button class="btn-outline photo-btn" wx:if="{{coverSet}}" disabled="{{photoBusy}}" bindtap="onRemovePhoto">移除</button>
        </view>
      </view>
      <view class="muted tip" wx:if="{{photoQ}}">{{photoQ}}</view>
      <block wx:if="{{coverSet}}">
        <view class="cust-lb">封面版式</view>
        <view class="chips"><view wx:for="{{layouts}}" wx:key="k" class="chip {{coverLayout === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="onLayout">{{item.n}}</view></view>
        <block wx:if="{{coverLayout === 'left'}}">
          <view class="cust-lb">相框形状</view>
          <view class="chips"><view wx:for="{{shapes}}" wx:key="k" class="chip {{coverShape === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="onShape">{{item.n}}</view></view>
        </block>
        <block wx:else>
          <view class="cust-lb">文字托底（让字在照片上看得清）</view>
          <view class="chips"><view wx:for="{{scrims}}" wx:key="k" class="chip {{coverScrim === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="onScrim">{{item.n}}</view></view>
        </block>
        <view class="cust-lb">裁剪</view>
        <button class="btn-outline crop-btn" disabled="{{photoBusy}}" bindtap="onOpenCrop">调整裁剪{{cropAdj ? '（已调整）' : ''}}</button>
      </block>
      <view class="muted tip">照片会印在导出 PDF 的封面上（左图右文或整页），默认居中裁剪，可点「调整裁剪」拖动、缩放照片；照片上传和移除立即生效，其余设置在导出或点「保存样式」时保存。PDF 转发后他人可见，请先征得照片里的人同意。</view>
    </view>
    <view class="muted tip" wx:if="{{isFuneral}}">{{o.t('白事礼簿封面不使用照片', org)}}</view>

    </block>

    <!-- ============ 内页标签：字体、装订 ============ -->
    <block wx:if="{{cur === 1}}">
      <view class="card cust">
        <view class="section-title">字体</view>
        <view class="chips"><view wx:for="{{fonts}}" wx:key="k" class="chip {{effFont === item.k ? 'on' : ''}} {{tryFont === item.k ? 'try' : ''}}" data-v="{{item.k}}" bindtap="onFontPick">{{item.n}}{{item.locked ? " · 会员" : ""}}</view></view>
        <view class="muted tip" wx:if="{{tryFont}}">试看中：示意图暂按该字体显示，并未选中（会员功能）；点其他字体或切换标签即恢复</view>
        <view class="muted tip" wx:if="{{!isFuneral && themeKey !== 'custom'}}">选择字体会把当前主题转为「在预设基础上修改」{{premiumOk ? '' : '（会员功能）'}}</view>
        <view class="muted tip">字体用于封面标题和全部内页</view>
      </view>
      <view class="card cust">
        <view class="section-title">水印字</view>
        <view class="chips"><view wx:for="{{isFuneral ? fMarks : marks}}" wx:key="k" class="chip {{effMark === item.k ? 'on' : ''}}" data-v="{{item.k}}" bindtap="onMarkPick">{{item.n}}</view></view>
        <view class="muted tip">水印字会淡淡地印在内页、封面和封底上（整页照片封面除外）</view>
        <view class="muted tip" wx:if="{{!isFuneral && themeKey !== 'custom'}}">选择水印会把当前主题转为「在预设基础上修改」{{premiumOk ? '' : '（会员功能）'}}</view>
      </view>
      <view class="card cust">
        <view class="section-title">装订</view>
      <view class="chips"><view wx:for="{{binds}}" wx:key="k" class="chip {{bind === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="onBind">{{item.n}}</view></view>
      <view class="muted tip">{{bindTip}}</view>
      <view class="muted tip">已生成的存档不会更新，之后新归档的按此设置</view>
    
      </view>
      <view class="muted tip">内页的格线颜色跟随主题主色；内页示意为{{o.t('本礼簿', org)}}前几位宾客</view>
    </block>

    <!-- ============ 封底标签：尾页 ============ -->
    <block wx:if="{{cur === 2}}">
    <!-- 封底：尾页设置（会员功能） -->
    <view class="card cust">
      <view class="section-title">封底尾页{{premiumOk ? "" : "（会员功能）"}}</view>
      <view class="opt" bindtap="onBackLocked"><text>封底尾页</text><switch disabled="{{!premiumOk}}" checked="{{back.on}}" color="{{themePrimary || '#C8161D'}}" data-f="on" bindchange="onBackSwitch" /></view>
      <block wx:if="{{back.on}}">
        <view class="cust-lb">尾页落款</view>
        <view class="chips">
          <view class="chip {{back.footer === '' ? 'on' : ''}}" data-v="" bindtap="onBackFooter">自动</view>
          <view class="chip {{back.footer === '-' ? 'on' : ''}}" data-v="-" bindtap="onBackFooter">无</view>
          <block wx:if="{{isFuneral}}">
            <view wx:for="{{fFooters}}" wx:key="*this" class="chip {{back.footer === item ? 'on' : ''}}" data-v="{{item}}" bindtap="onBackFooter">{{item}}</view>
          </block>
        </view>
        <input class="input" cursor-spacing="120" adjust-position="{{true}}" bindfocus="onKbOn" bindblur="onKbOff" disabled="{{!premiumOk}}" value="{{back.footer === '-' ? '' : back.footer}}" maxlength="8" placeholder="自动：沿用封面落款或默认" data-f="footer" bindinput="onBackInput" />
        <view class="opt" bindtap="onBackLocked"><text>{{o.t('记账人签名栏', org)}}</text><switch disabled="{{!premiumOk}}" checked="{{back.sign}}" color="{{themePrimary || '#C8161D'}}" data-f="sign" bindchange="onBackSwitch" /></view>
        <view class="opt" bindtap="onBackLocked"><text>显示「慧礼记」小字</text><switch disabled="{{!premiumOk}}" checked="{{back.brand}}" color="{{themePrimary || '#C8161D'}}" data-f="brand" bindchange="onBackSwitch" /></view>
      </block>
    </view>
    </block>

    <view class="muted tip" wx:if="{{!canSave}}">{{o.t('你没有管理礼簿权限，本次选择只用于这次预览和导出，不会保存', org)}}</view>
    <view class="muted tip" wx:else>主题、纹样、尾页、装订和照片版式在导出或点「保存样式」时保存到{{o.t('本礼簿', org)}}；照片上传和移除立即生效</view>
  </block>

  <view class="bottom-bar" wx:if="{{book && !kb}}">
    <view class="bb-row">
      <button class="btn-outline pv-btn" disabled="{{exporting || previewing || pvLock || saving}}" bindtap="onPreview">预览</button>
      <button class="btn-outline sv-btn" wx:if="{{canSave}}" loading="{{saving}}" disabled="{{exporting || previewing || saving}}" bindtap="onSaveStyle">{{saving ? '保存中' : (dirty ? '保存样式' : '已保存')}}</button>
      <button class="btn-primary ok-btn" loading="{{exporting}}" disabled="{{exporting || previewing || saving}}" bindtap="onExport">导出</button>
    </view>
  </view>

  <!-- 导出 / 预览确认面板：打印方式只用于本次，不保存 -->
  <view class="mask" wx:if="{{sheet}}" bindtap="onSheetClose" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{sheet === 'export' ? '导出传统礼簿' : '预览'}}</view>
      <block wx:if="{{coverSet && !isFuneral}}">
        <view class="cust-lb">封面照片打印方式（只用于本次，不保存）</view>
        <view class="chips"><view wx:for="{{prints}}" wx:key="k" class="chip {{coverPrint === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="onPrint">{{item.n}}</view></view>
        <view class="muted tip">淡化：照片叠一层白色，约省六成墨；去照片：封面只留底色和纹样</view>
      </block>
      <view class="muted tip" wx:if="{{sheet === 'export'}}">{{canSave ? o.t('样式将保存到本礼簿', org) : '仅本次（没有管理权限，样式不会保存）'}}</view>
      <view class="sheet-btns">
        <button class="btn btn-lg btn-plain" bindtap="onSheetClose">取消</button>
        <button class="btn btn-lg btn-primary" bindtap="onSheetOk">{{sheet === 'export' ? '开始导出' : '开始预览'}}</button>
      </view>
    </view>
  </view>
  <!-- 裁剪编辑器：单指拖动照片、双指缩放；框的比例与 PDF 一致 -->
  <view class="mask" wx:if="{{cropOpen}}" catchtouchmove="noop">
    <view class="sheet crop-sheet" catchtap="noop">
      <view class="sheet-title">调整裁剪</view>
      <view class="muted tip crop-tip">拖动照片调整位置，双指或滑块缩放{{coverShape === 'oval' && coverLayout === 'left' ? '；椭圆外的部分不会显示' : ''}}{{coverLayout === 'full' ? '；下方深色带是文字区，会被渐变 / 色块遮住' : ''}}</view>
      <view class="crop-frame" style="width:{{cropFrame.w}}rpx;height:{{cropFrame.h}}rpx" catchtouchstart="onCropStart" catchtouchmove="onCropMove" catchtouchend="onCropEnd" catchtouchcancel="onCropEnd">
        <image src="{{coverUrl}}" mode="scaleToFill" style="{{cropImg}}" />
        <view class="crop-oval" wx:if="{{coverShape === 'oval' && coverLayout === 'left'}}"></view>
        <view class="crop-band" wx:if="{{coverLayout === 'full'}}" style="top:{{bandTop}}%"><text>文字区</text></view>
      </view>
      <view class="crop-zoom">
        <view class="crop-zb" bindtap="onCropMinus">－</view>
        <slider class="crop-slider" min="100" max="300" step="5" value="{{cropZ}}" block-size="20" activeColor="{{themePrimary || '#C8161D'}}" bindchanging="onCropZ" bindchange="onCropZ" />
        <view class="crop-zb" bindtap="onCropPlus">＋</view>
      </view>
      <view class="fgrid"><view wx:for="{{focusCells}}" wx:key="n" class="fcell" data-x="{{item.x}}" data-y="{{item.y}}" bindtap="onCropCell">{{item.n}}</view></view>
      <view class="muted tip">九宫格：快速把照片靠到某个位置，再拖动微调</view>
      <view class="sheet-btns">
        <button class="btn btn-lg btn-plain" bindtap="onCropCancel">取消</button>
        <button class="btn btn-lg btn-plain" bindtap="onCropReset">复位</button>
        <button class="btn btn-lg btn-primary" bindtap="onCropDone">完成</button>
      </view>
    </view>
  </view>
  <loading show="{{loading}}" type="overlay" />
</view>
<privacy-popup />
