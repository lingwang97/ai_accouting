<wxs module="o" src="/utils/orgtext.wxs"></wxs>
<view class="container" style="{{themeStyle}}">
  <loading show="{{loading}}" rows="2" />
  <block wx:if="{{!loading}}">
    <view class="card">
      <view class="section-title">移交给主家</view>
      <view class="muted intro">把你替别人建的{{orgMode ? '场次' : '礼簿'}}移交给真正的主家，没选的留在你这里。全选则主家信息、收款码、已印礼簿码一并转给对方。</view>

      <view class="pick-head">
        <text class="muted">{{orgMode ? '选择场次' : '选择礼簿'}}</text>
        <text class="link" bindtap="onPickAll" wx:if="{{books.length}}">全选 / 全不选</text>
      </view>
      <view class="muted small empty" wx:if="{{!books.length}}">还没有可移交的{{orgMode ? '场次' : '礼簿'}}</view>
      <view class="book-row {{item.on ? 'on' : ''}}" wx:for="{{books}}" wx:key="_id" data-i="{{index}}" bindtap="onToggleBook">
        <view class="check {{item.on ? 'on' : ''}}">{{item.on ? '✓' : ''}}</view>
        <view class="b-info">
          <view>{{item.name}}<text class="muted small"> · {{item.typeLabel}}<text wx:if="{{item.archived}}"> · 已归档</text></text></view>
          <view class="muted small">{{item.count}} 份 · ￥{{item.sumStr}}</view>
        </view>
      </view>
      <view class="stay-row">
        <view>
          <view>移交后继续为对方记账</view>
          <view class="muted small">你会成为对方的{{orgMode ? '礼台人员' : '记账人'}}，可随时退出</view>
        </view>
        <switch checked="{{stayClerk}}" bindchange="onStayClerk" color="{{primary}}" />
      </view>

      <view class="transfer-warn">移交卡只发给接收人本人！拿到的人点开即可接收所选全部{{orgMode ? '场次' : '礼簿'}}，请勿转发到群。</view>
      <!-- 先生成移交卡片，再出现发送按钮（同礼簿共享，v3.78.2）：未生成时转发只会是普通首页卡片 -->
      <button wx:if="{{!transferToken}}" class="btn-primary" style="margin-top:20rpx" bindtap="onMakeTransfer">生成移交卡片</button>
      <block wx:else>
        <view class="transfer-desc">{{transferDesc}}</view>
        <button class="btn-primary" open-type="share" data-type="transfer">发给主家本人</button>
      </block>
    </view>
  </block>
</view>
