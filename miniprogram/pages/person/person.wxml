<view class="container" style="{{themeStyle}}">
  <view class="card summary">
    <view class="s-col">
      <view class="muted">收到 TA 的礼</view>
      <view class="s-num">￥{{receivedSum}}</view>
    </view>
    <view class="s-col">
      <view class="muted">我送给 TA</view>
      <view class="s-num">￥{{givenSum}}</view>
    </view>
  </view>
  <view class="card same-tip" wx:if="{{same.length}}">
    <view class="same-txt">还有 {{same.length}} 位同名：{{sameStr}}</view>
    <view class="btn btn-sm btn-outline" bindtap="onMerge">合并为同一人</view>
  </view>
  <view class="card same-tip" wx:if="{{merged.length}}">
    <view class="same-txt">已合并 {{merged.length}} 位同名</view>
    <view class="link" bindtap="onUnmerge">取消合并</view>
  </view>
  <view class="card dup-tip" wx:if="{{dup && !same.length}}">有同名的往来人，这里只显示{{byWx ? '这一位（按微信身份区分）' : '仅按姓名登记的记录'}}</view>
  <view class="card advice {{balance > 0 ? 'owe' : ''}}">
    <text wx:if="{{balance > 0}}">收多于送 ￥{{balanceStr}}，TA 家有事时宜回礼</text>
    <text wx:elif="{{balance < 0}}">已多送 ￥{{balanceStr}}</text>
    <text wx:else>往来已持平</text>
  </view>

  <view class="section-title">TA 随给我的（{{received.length}}）</view>
  <view class="card item" wx:for="{{received}}" wx:key="_id">
    <view class="i-top"><text class="i-name">{{item.event || item.typeLabel}}</text><text class="money i-amt">￥{{item.amountStr}}</text></view>
    <view class="muted">{{item.date}}<text wx:if="{{item.relation}}"> · {{item.relation}}</text></view>
    <view class="move-row" wx:if="{{item.movable}}"><text class="link" data-side="received" data-idx="{{index}}" catchtap="onMove">不是TA ›</text></view>
  </view>
  <view class="muted empty" wx:if="{{!loading && received.length === 0}}">暂无</view>

  <view class="section-title" style="margin-top:28rpx">我送给 TA 的（{{given.length}}）</view>
  <view class="card item" wx:for="{{given}}" wx:key="_id" data-idx="{{index}}" bindtap="onEditGift">
    <view class="i-top"><text class="i-name">{{item.event || item.typeLabel}}</text><text class="money i-amt">￥{{item.amountStr}}</text></view>
    <view class="muted">{{item.date}} · {{item.typeLabel}}<text wx:if="{{item.auto}}" class="auto"> · 扫码随礼</text><text wx:if="{{item.remark}}"> · {{item.remark}}</text></view>
    <view class="move-row" wx:if="{{item.movable}}"><text class="link" data-side="given" data-idx="{{index}}" catchtap="onMove">不是TA ›</text></view>
  </view>
  <view class="muted empty" wx:if="{{!loading && given.length === 0}}">暂无</view>

  <button class="btn-primary" style="margin-top:32rpx" bindtap="onAddGift">给 TA 记一笔送礼</button>
  <button class="btn-outline" style="margin-top:20rpx" bindtap="onAddRemind">TA 家办事时提醒我</button>
</view>
