<view class="container tab-page" style="{{themeStyle}}">
  <view class="card center login-tip" wx:if="{{!loggedIn}}">
    <view class="muted">登录后查看礼簿</view>
    <button class="btn-primary" style="margin-top:24rpx" bindtap="goLogin">去登录</button>
  </view>
  <block wx:else>
  <view class="net-bar" wx:if="{{netBad && !loadErr}}" bindtap="onRetryLoad">网络不稳定，数据可能不是最新 · 点此刷新</view>
  <view class="card sum-card">
    <view class="sum-row">
      <view class="sum-left">
        <picker range="{{books}}" range-key="name" value="{{bookIdx}}" bindchange="onBook">
          <view class="book-pick">{{books[bookIdx].name}} ▾</view>
        </picker>
        <view class="muted">礼金合计</view>
        <view class="sum money {{sum.length >= 12 ? 'long' : ''}}">￥{{sum}}</view>
        <view class="muted">{{total}} 份<text wx:if="{{pendingCount > 0}}" class="pending-hint"> · {{pendingCount}} 份待确认</text></view>
        <view class="muted small" wx:if="{{stIdx === 4}}">合计与份数仍是整本已入簿的口径，下面是近 30 天有改动的记录</view>
      </view>
    </view>
    <view class="search-row">
      <input class="search" placeholder="搜索姓名" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
      <picker range="{{relations}}" value="{{relIdx}}" bindchange="onRelation">
        <view class="rel-btn ft-btn {{relIdx > 0 ? 'on' : ''}}"><image class="ft-ic" src="/assets/icons/filter-{{relIdx > 0 ? (themeIcon || 'r') : 'g'}}.svg" /><text>{{relIdx > 0 ? relations[relIdx] : '关系'}} ▾</text></view>
      </picker>
      <view class="rel-btn ft-btn {{dupOn ? 'on' : ''}}" bindtap="onDup"><image class="ft-ic" src="/assets/icons/filter-{{dupOn ? (themeIcon || 'r') : 'g'}}.svg" /><text>重名</text></view>
      <view class="btn btn-sm btn-primary search-btn" bindtap="onSearch">搜索</view>
    </view>
    <view class="filter-row">
      <view class="st-wrap">
        <scroll-view class="st-seg" scroll-x enable-flex show-scrollbar="{{false}}" scroll-into-view="{{'st' + stIdx}}" scroll-with-animation bindscroll="onStScroll">
          <view id="{{'st' + index}}" class="seg-item {{stIdx === index ? 'on' : ''}}" wx:for="{{statuses}}" wx:key="*this" data-i="{{index}}" bindtap="onStatus"><text class="st-pill">{{item}}</text></view>
        </scroll-view>
        <view class="st-fade" wx:if="{{stFade}}"><text>›</text></view>
      </view>
      <picker range="{{sorts}}" value="{{sortIdx}}" bindchange="onSort" disabled="{{dupOn}}">
        <view class="rel-btn ft-btn {{dupOn ? 'dis' : (sortIdx > 0 ? 'on' : '')}}"><image class="ft-ic" src="/assets/icons/sort-{{!dupOn && sortIdx > 0 ? (themeIcon || 'r') : 'g'}}.svg" /><text>{{dupOn ? '按姓名排列' : sorts[sortIdx] + ' ▾'}}</text></view>
      </picker>
    </view>
  </view>

  <!-- 首次加载骨架 -->
  <block wx:if="{{loading && list.length === 0}}">
    <view class="card sk-rec" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
      <view class="sk sk-l1"></view>
      <view class="sk sk-l2"></view>
    </view>
  </block>

  <view class="card record {{item.status}}" wx:for="{{list}}" wx:key="_id">
    <view class="r-top">
      <text class="payer">{{item.nameStr}}<text class="dup-n" wx:if="{{item.dupN}}"> · 同名 {{item.dupN}} 条</text></text>
      <text class="r-right"><text class="cash-tag" wx:if="{{item.payMethod === 'cash'}}">现金</text><text class="xfer-tag" wx:elif="{{item.status === 'transferred' || item.status === 'paid'}}">转账</text><text class="money r-amount">￥{{item.amountStr}}</text></text>
    </view>
    <view class="chg-row" wx:if="{{stIdx === 4 && item.chg}}" data-idx="{{index}}" bindtap="onChgLog"><text class="chg-tag {{item.chg.cls}}">{{item.chg.tag}}</text><text class="chg-text">{{item.chg.text}}</text><text class="chg-more"> 经过 ›</text></view>
    <view class="muted">{{item.timeStr}}<text wx:if="{{item.relation}}"> · {{item.relation}}</text><text wx:if="{{item.batchId}}"> · 批次录入</text><text wx:if="{{item.remark}}"> · {{item.remark}}</text></view>
    <!-- 状态类小标签单独一行（v3.86.1）：宾客登记 / 已修改 / 申诉 / 修改倒计时 / 更正申请，放不下自动换行，不再和备注挤成 3-4 行 -->
    <view class="r-tags" wx:if="{{item.declaredStr || item.amendN || item.appealStatus === 'accepted' || (!readonly && item.editHint) || item.corrStr}}">
      <text wx:if="{{item.declaredStr}}" class="r-tg declared">宾客登记 ￥{{item.declaredStr}}，按实收入簿</text>
      <text wx:if="{{item.amendN}}" class="r-tg amended" data-idx="{{index}}" catchtap="onAmendLog">已修改 ›</text>
      <text wx:if="{{item.appealStatus === 'accepted'}}" class="r-tg amended" data-idx="{{index}}" catchtap="onTrail">宾客申诉后入簿 ›</text>
      <text wx:if="{{!readonly && item.editHint}}" class="r-tg declared">{{item.editHint}}</text>
      <text wx:if="{{item.corrStr}}" class="r-tg amended" data-idx="{{index}}" catchtap="onCorrect">{{item.corrStr}} ›</text>
    </view>

    <!-- 待确认：宾客已点"我已完成转账" -->
    <view class="r-actions" wx:if="{{item.status === 'transferred'}}">
      <text class="badge warn">{{item.statusText}}</text>
      <view class="flex1"></view>
      <block wx:if="{{!readonly && pm.confirm}}">
        <!-- 非当前礼簿：确认只能在当前礼簿进行，提示切换（旧数据无 bookId 的照常可确认） -->
        <text class="muted" wx:if="{{curBook !== null && item.bookId && item.bookId !== curBook}}">切换{{unit}}后处理</text>
        <block wx:else>
          <button class="btn btn-sm btn-danger r-op" data-idx="{{index}}" catchtap="onReject">未收到</button>
          <button class="btn btn-sm btn-primary r-op" data-idx="{{index}}" catchtap="onConfirm">确认收到</button>
        </block>
      </block>
    </view>

    <!-- 未转账：宾客已登记但尚未转账 -->
    <view class="r-actions" wx:elif="{{item.status === 'pending'}}">
      <text class="badge gray">{{item.statusText}}</text>
      <text class="muted">宾客尚未完成转账</text>
    </view>

    <!-- 未收到（v3.77.2）：时间、原因、申诉状态、处理经过；24 小时内可撤销；宾客已申诉的去待确认页核对 -->
    <view class="r-actions rej-box" wx:elif="{{item.status === 'rejected'}}">
      <text class="badge bad">{{item.statusText}}</text>
      <view class="muted rej-info">{{item.rejTimeStr}} 标记{{item.reasonStr ? ' · ' + item.reasonStr : ''}}<text wx:if="{{item.appealStatus === 'open'}}" class="rej-ap"> · 宾客已申诉，待核对</text><text wx:elif="{{item.appealStatus === 'kept'}}"> · 已维持未收到</text></view>
      <view class="rej-ops" wx:if="{{!readonly}}">
        <view class="link" data-idx="{{index}}" bindtap="onTrail">处理经过</view>
        <block wx:if="{{pm.confirm}}">
          <view class="link" wx:if="{{item.appealStatus === 'open'}}" bindtap="onGoAppeal">去核对</view>
          <block wx:elif="{{item.canUnreject}}">
            <text class="muted" wx:if="{{curBook !== null && item.bookId && item.bookId !== curBook}}">切换{{unit}}后可撤销</text>
            <view class="link" wx:else data-idx="{{index}}" bindtap="onUnreject">撤销未收到</view>
          </block>
        </block>
      </view>
    </view>

    <!-- 已入簿 -->
    <view class="r-actions" wx:elif="{{item.status === 'paid'}}">
      <text class="badge ok">{{item.statusText}}</text>
      <text class="badge {{item.printed ? 'ok' : 'warn'}}" wx:if="{{!readonly && pm.show}}">{{item.printed ? '已打印' : '待打印'}}</text>
      <view class="flex1"></view>
      <!-- 常用操作直接显示；区分备注、作废收进「更多」（窄屏不挤、作废不易误触） -->
      <view class="link" data-id="{{item._id}}" bindtap="onReceipt">回执</view>
      <view class="link" wx:if="{{!readonly && pm.show}}" data-idx="{{index}}" bindtap="onPrint">{{item.printed ? '补打' : '打印'}}</view>
      <view class="link" wx:if="{{!readonly && pm.amend && item.editOpen}}" data-idx="{{index}}" bindtap="onAmend">修改</view>
      <view class="link" wx:if="{{!readonly && pm.amend && !item.editOpen && item.canCorrect && item.corrState !== 'pending'}}" data-idx="{{index}}" bindtap="onCorrect">申请更正</view>
      <view class="link" wx:if="{{!readonly && (pm.tag || pm.void || isOwner)}}" data-idx="{{index}}" bindtap="onMore">更多</view>
    </view>
  </view>

  <view class="muted center pad" wx:if="{{dupOn && dupTruncated}}">仅显示部分，可用搜索缩小范围</view>
  <view class="net-err" wx:if="{{!loading && list.length === 0 && loadErr}}" bindtap="onRetryLoad">
    <view class="ne-title">礼簿没加载出来</view>
    <view class="ne-sub">{{loadErr}}，请检查网络后重试</view>
    <view class="ne-btn">点此重试</view>
  </view>
  <view class="card center pad" wx:elif="{{!loading && list.length === 0 && noBook && !keyword}}">
    <view class="muted">{{canCreate ? '还没有' + unit + '，去创建' : '还没有' + unit + '，请联系主家创建'}}</view>
    <button wx:if="{{canCreate}}" class="btn-primary" style="margin-top:24rpx" bindtap="goCreate">创建{{unit}}</button>
  </view>
  <view class="muted center pad" wx:elif="{{!loading && list.length === 0}}">{{dupOn ? '没有重名的记录' : (keyword || relIdx > 0 || stIdx > 0 ? '没有符合条件的记录' : '暂无礼金记录')}}</view>
    <view class="muted center small long-tip" wx:if="{{!loading && list.length >= 200}}">已加载 {{list.length}} 条，可用搜索或筛选缩小范围</view>
  <view class="muted center pad" wx:if="{{loading && list.length > 0}}">加载中…</view>
  <view class="to-top" wx:if="{{showTop}}" bindtap="onTop">↑ 顶部</view>
  </block>

  <!-- 超期更正申请（v3.85.0） -->
  <view class="mask tab-mask" wx:if="{{corr}}" catchtap="onCorrClose" catchtouchmove="noop">
    <view class="sheet tab-sheet" catchtap="noop">
      <view class="sheet-title">申请更正</view>
      <view class="muted small amend-tip">已超过 72 小时，不能直接修改。申请会发给{{corr.who}}，对方在「我的随礼记录」同意后才生效；7 天没处理自动失效，期间原记录不变。</view>
      <view class="muted small amend-tip">{{corr.name}} ￥{{corr.amountStr}}</view>
      <view class="seg corr-seg">
        <view class="seg-item {{corr.kind === 'amount' ? 'on' : ''}}" data-k="amount" bindtap="onCorrKind">改金额</view>
        <view class="seg-item {{corr.kind === 'name' ? 'on' : ''}}" data-k="name" bindtap="onCorrKind">改姓名</view>
        <view class="seg-item {{corr.kind === 'void' ? 'on' : ''}}" data-k="void" bindtap="onCorrKind">作废</view>
      </view>
      <view class="field" wx:if="{{corr.kind === 'amount'}}"><view class="muted small">更正后的金额（元）</view><input class="input" type="digit" maxlength="11" value="{{corr.newAmount}}" data-k="newAmount" bindinput="onCorrInput" /></view>
      <view class="field" wx:if="{{corr.kind === 'name'}}"><view class="muted small">更正后的姓名</view><input class="input" maxlength="20" value="{{corr.newName}}" data-k="newName" bindinput="onCorrInput" /></view>
      <view class="field"><view class="muted small">更正理由（必填，对方可见）</view><input class="input" maxlength="30" placeholder="如：录入时多写了一个零" value="{{corr.reason}}" data-k="reason" bindinput="onCorrInput" /></view>
      <view class="sheet-btns">
        <button class="btn btn-outline" bindtap="onCorrClose">取消</button>
        <button class="btn btn-primary" loading="{{busy}}" bindtap="onCorrSubmit">发出申请</button>
      </view>
    </view>
  </view>

  <!-- 修改已入簿礼金 -->
  <view class="mask tab-mask" wx:if="{{amend}}" catchtap="onAmendClose" catchtouchmove="noop">
    <view class="sheet tab-sheet" catchtap="noop">
      <view class="sheet-title">修改礼金记录</view>
      <view class="muted small amend-tip">改金额会同步更新合计，并留有修改记录</view>
      <view class="field"><view class="muted small">姓名</view><input class="input" maxlength="20" value="{{amend.name}}" data-k="name" bindinput="onAmendInput" /></view>
      <view class="field"><view class="muted small">金额（元）</view><input class="input" type="digit" maxlength="11" value="{{amend.amount}}" data-k="amount" bindinput="onAmendInput" /></view>
      <view class="field"><view class="muted small">关系</view><picker range="{{amendRels}}" value="{{amend.relIdx}}" bindchange="onAmendRel"><view class="input">{{amendRels[amend.relIdx]}} ▾</view></picker></view>
      <view class="field"><view class="muted small">备注</view><input class="input" maxlength="50" placeholder="选填" value="{{amend.remark}}" data-k="remark" bindinput="onAmendInput" /></view>
      <view class="declared small" wx:if="{{amend.hint}}">{{amend.hint}}</view>
      <view class="sheet-btns">
        <button class="btn btn-outline" bindtap="onAmendClose">取消</button>
        <button class="btn btn-primary" bindtap="onAmendSave">保存</button>
      </view>
    </view>
  </view>
</view>
