<view class="container tab-page" style="{{themeStyle}}">
  <view class="card center login-tip" wx:if="{{!loggedIn}}">
    <view class="muted">登录后查看礼簿</view>
    <button class="btn-primary" style="margin-top:24rpx" bindtap="goLogin">去登录</button>
  </view>
  <block wx:else>
  <view class="card sum-card">
    <view class="sum-row">
      <view class="sum-left">
        <picker range="{{books}}" range-key="name" value="{{bookIdx}}" bindchange="onBook">
          <view class="book-pick">{{books[bookIdx].name}} ▾</view>
        </picker>
        <text class="book-manage" bindtap="goBooks">管理礼簿 ›</text>
        <view class="muted">礼金合计</view>
        <view class="sum money">￥{{sum}}</view>
        <view class="muted">{{total}} 份<text wx:if="{{pendingCount > 0}}" class="pending-hint"> · {{pendingCount}} 份待确认</text></view>
      </view>
      <view class="filters">
        <view class="filter {{filterDay === 'today' ? 'on' : ''}}" data-v="today" bindtap="onFilterChange">今日</view>
        <view class="filter {{filterDay === 'all' ? 'on' : ''}}" data-v="all" bindtap="onFilterChange">全部</view>
      </view>
    </view>
    <view class="search-row">
      <input class="search" placeholder="搜索宾客姓名" value="{{keyword}}" bindconfirm="onSearch" confirm-type="search" />
      <picker range="{{relations}}" value="{{relIdx}}" bindchange="onRelation">
        <view class="rel-btn {{relIdx > 0 ? 'on' : ''}}">{{relIdx > 0 ? relations[relIdx] : '关系'}} ▾</view>
      </picker>
      <view class="export-btn" wx:if="{{pm.export || readonly}}" bindtap="goExport">导出</view>
    </view>
    <view class="cash-entry" wx:if="{{!readonly && pm.desk}}" bindtap="goCash">＋ 礼台记账（现金 / 微信）
    </view>
  </view>

  <!-- 首次加载骨架 -->
  <block wx:if="{{loading && list.length === 0}}">
    <view class="card sk-rec" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
      <view class="sk sk-l1"></view>
      <view class="sk sk-l2"></view>
    </view>
  </block>

  <view class="card record {{item.status}}" wx:for="{{list}}" wx:key="_id">
    <view class="r-top">
      <text class="payer">{{item.payerName}}</text>
      <text class="r-right"><text class="cash-tag" wx:if="{{item.payMethod === 'cash'}}">现金</text><text class="money r-amount">￥{{item.amountStr}}</text></text>
    </view>
    <view class="muted">{{item.timeStr}}<text wx:if="{{item.relation}}"> · {{item.relation}}</text><text wx:if="{{item.proxyStr}}"> · 代 {{item.proxyStr}}</text><text wx:if="{{item.batchId}}"> · 批次录入</text><text wx:if="{{item.remark}}"> · {{item.remark}}</text><text wx:if="{{item.declaredStr}}" class="declared"> · 宾客登记 ￥{{item.declaredStr}}，按实收入簿</text></view>

    <!-- 待确认：宾客已点"我已完成转账" -->
    <view class="r-actions" wx:if="{{item.status === 'transferred'}}">
      <text class="badge warn">{{item.statusText}}</text>
      <view class="flex1"></view>
      <block wx:if="{{!readonly && pm.confirm}}">
        <view class="link danger" data-idx="{{index}}" bindtap="onReject">未收到</view>
        <button class="btn-confirm" data-idx="{{index}}" bindtap="onConfirm">确认收到</button>
      </block>
    </view>

    <!-- 未转账：宾客已登记但尚未转账 -->
    <view class="r-actions" wx:elif="{{item.status === 'pending'}}">
      <text class="badge gray">{{item.statusText}}</text>
      <text class="muted">宾客尚未完成转账</text>
    </view>

    <!-- 已入簿 -->
    <view class="r-actions" wx:elif="{{item.status === 'paid'}}">
      <text class="badge ok">{{item.statusText}}</text>
      <text class="badge {{item.printed ? 'ok' : 'warn'}}" wx:if="{{!readonly && pm.show}}">{{item.printed ? '已打印' : '待打印'}}</text>
      <view class="flex1"></view>
      <view class="link" data-id="{{item._id}}" bindtap="onReceipt">回执</view>
      <view class="link" wx:if="{{!readonly && pm.show}}" data-idx="{{index}}" bindtap="onPrint">{{item.printed ? '补打' : '打印'}}</view>
      <view class="link danger" wx:if="{{!readonly && pm.void}}" data-idx="{{index}}" bindtap="onVoid">作废</view>
    </view>
  </view>

  <view class="muted center pad" wx:if="{{!loading && list.length === 0}}">暂无礼金记录</view>
  <view class="muted center pad" wx:if="{{loading}}">加载中…</view>
  </block>
</view>
