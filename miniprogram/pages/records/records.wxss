.sum-row { display: flex; justify-content: space-between; align-items: flex-start; }
.sum { font-size: 60rpx; margin: 8rpx 0; }
.pending-hint { color: #FF9F1C; }
.filters { display: flex; }
.filters .filter:not(:last-child) { margin-right: 12rpx; }
.filter {
  padding: 8rpx 24rpx; border-radius: 999rpx;
  background: #f2f3f5; color: #666; font-size: 26rpx;
}
.filter.on { background: var(--primary); color: #fff; }
.search-row { display: flex; align-items: center; margin-top: 20rpx; }
.search-row .rel-btn, .search-row .export-btn { margin-left: 16rpx; }
.search {
  flex: 1; background: #f2f3f5;
  border-radius: 999rpx; padding: 16rpx 28rpx;
}
.export-btn {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  border: 2rpx solid var(--primary); color: var(--primary); font-size: 26rpx;
}
.record.transferred { border-left: 8rpx solid #FF9F1C; }
.record.pending { opacity: .7; }
.r-top { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.payer { font-weight: 600; flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 姓名过长省略，金额不换行 */
.r-right { flex-shrink: 0; white-space: nowrap; margin-left: 16rpx; }
.sum-left { flex: 1; min-width: 0; }
.filters { flex-shrink: 0; margin-left: 16rpx; }
.r-amount { font-size: 34rpx; }
.r-actions {
  display: flex; align-items: center;
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}
.r-actions .flex1, .r-actions .link, .r-actions .btn-confirm, .r-actions .muted, .r-actions .badge:not(:first-child) { margin-left: 24rpx; }
.flex1 { flex: 1; }
.badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
.badge.ok { background: #07C16022; color: #07C160; }
.badge.warn { background: #FF9F1C22; color: #FF9F1C; }
.badge.gray { background: #eee; color: #999; }
.link { color: #2B7FFF; font-size: 26rpx; }
.link.danger { color: #FA5151; }
.btn-confirm {
  margin: 0; padding: 0 28rpx; line-height: 60rpx; height: 60rpx;
  font-size: 26rpx; background: #07C160; color: #fff; border-radius: 8rpx;
}
.pad { padding: 40rpx 0; }

.book-pick { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rel-btn { padding: 0 20rpx; line-height: 64rpx; border-radius: 12rpx; background: #f2f3f5; color: #666; font-size: 26rpx; white-space: nowrap; }
.rel-btn.on { background: var(--primary-soft); color: var(--primary); }
.declared { color: #FF9F1C; }
.cash-tag { font-size: 22rpx; color: #FF9F1C; background: #FFF7E6; border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 12rpx; }
.cash-entry { margin-top: 20rpx; text-align: center; padding: 18rpx 0; border-radius: 12rpx; border: 2rpx dashed #FF9F1C; color: #FF9F1C; font-size: 28rpx; }
.book-manage { font-size: 24rpx; color: #576B95; }

/* 骨架屏 */
.sk { background: linear-gradient(90deg, #ECECEC 25%, #F5F5F5 50%, #ECECEC 75%); background-size: 400% 100%; animation: sk 1.4s ease infinite; border-radius: 10rpx; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
.sk-l1 { height: 34rpx; width: 55%; margin-bottom: 18rpx; }
.sk-l2 { height: 24rpx; width: 80%; }
