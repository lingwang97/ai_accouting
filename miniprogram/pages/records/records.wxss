.sum-row { display: flex; justify-content: space-between; align-items: flex-start; }
.sum { font-size: 60rpx; margin: 8rpx 0; }
.sum.long { font-size: 44rpx; }
.pending-hint { color: var(--warn); }
.search-row { display: flex; align-items: center; margin-top: 20rpx; }
.search-row .rel-btn, .search-row .search-btn { margin-left: 12rpx; }
.search {
  flex: 1; min-width: 0; background: var(--fill);
  border-radius: 999rpx; padding: 16rpx 20rpx;
}
.search-btn { border-radius: 999rpx; flex-shrink: 0; white-space: nowrap; }
.dup-n { font-size: 22rpx; color: var(--warn); font-weight: normal; }
.filter-row { display: flex; align-items: center; margin-top: 16rpx; }
/* 五个状态按钮（v3.85.2）：屏宽够就平分，320 宽 / 大字体放不下时可横向滑动，文字不换行不截断（样式同「我的随礼记录」标签条） */
/* v3.86.1：scroll-view 横滑 + 右侧渐变箭头 */
.filter-row .st-wrap { position: relative; flex: 1; min-width: 0; border-radius: var(--r-s); background: var(--fill); overflow: hidden; }
.filter-row .st-seg { display: flex; flex-direction: row; width: 100%; padding: 6rpx; box-sizing: border-box; white-space: nowrap; }
.filter-row .st-seg .seg-item { flex: 1 0 auto; padding: 8rpx 16rpx; font-size: 24rpx; white-space: nowrap; border-radius: 10rpx; text-align: center; }
.filter-row .st-seg .seg-item.on { background: var(--primary); color: #fff; font-weight: 600; }
.st-fade { position: absolute; right: 0; top: 0; bottom: 0; width: 56rpx; display: flex; align-items: center; justify-content: flex-end; padding-right: 8rpx; box-sizing: border-box; background: linear-gradient(to right, rgba(240, 240, 240, 0), var(--fill) 70%); color: #888; font-size: 28rpx; pointer-events: none; }
.filter-row .rel-btn { margin-left: 16rpx; }
.record.transferred { border-left: 8rpx solid var(--warn); }
.record.pending { opacity: .7; }
.r-top { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.payer { font-weight: 600; flex: 1; min-width: 3em; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 姓名过长省略，金额不换行 */
.r-right { flex-shrink: 0; white-space: nowrap; margin-left: 16rpx; }
.sum-left { flex: 1; min-width: 0; }
.r-amount { font-size: 34rpx; }
.r-actions {
  display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end;
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}
.r-actions .flex1, .r-actions .link, .r-actions .btn, .r-actions .muted, .r-actions .badge:not(:first-child) { margin-left: 24rpx; }
.r-actions .link { margin-left: 0; }
/* 窄屏换行：保持右对齐，换行后行间留 12rpx；左侧状态徽章与 flex1 占位撑开（flex1 min-width 0 可收缩） */
.r-actions .badge { margin-top: 6rpx; margin-bottom: 6rpx; white-space: nowrap; }
/* 操作链接：触控区高 72rpx、左右各 16rpx 内边距（间距由内边距提供，相邻链接不易误触） */
.r-actions .link { margin-left: 0; padding: 0 16rpx; line-height: 72rpx; white-space: nowrap; }
.r-actions .badge:first-child { margin-right: auto; }
.r-actions .flex1 { min-width: 0; }
.flex1 { flex: 1; }
.badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
/* 已入簿 / 已打印：语义成功色 */
.badge.ok { background: #07C16022; color: var(--success); }
.badge.warn { background: var(--warn-soft); color: var(--warn); }
.badge.gray { background: #eee; color: var(--text-3); }
.badge.bad { background: #FA515122; color: var(--danger, #FA5151); }
.r-actions.rej-box { flex-wrap: wrap; }
.rej-info { flex: 1; min-width: 0; font-size: 24rpx; }
.rej-ap { color: var(--warn); }
.rej-ops { width: 100%; display: flex; justify-content: flex-end; margin-top: 8rpx; }
.rej-ops .link, .rej-ops .muted { margin-left: 28rpx; }
.record.rejected { border-left: 8rpx solid var(--danger, #FA5151); }
.pad { padding: 40rpx 0; }

.book-pick { font-size: 30rpx; font-weight: 600; color: var(--text); margin-bottom: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rel-btn { padding: 0 20rpx; line-height: 64rpx; border-radius: var(--r-s); background: var(--fill); color: var(--text-2); font-size: 26rpx; white-space: nowrap; }
.rel-btn.on { background: var(--primary-soft); color: var(--primary); }
/* 筛选 / 排序按钮前的小图标（v3.77.3）：与文字垂直居中；320 宽屏下搜索行收紧内边距 */
.ft-btn { display: flex; align-items: center; flex-shrink: 0; padding: 0 14rpx; font-size: 24rpx; }
.ft-ic { width: 26rpx; height: 26rpx; margin-right: 6rpx; flex-shrink: 0; }
.rel-btn.dis { color: var(--text-3, #999); opacity: .8; }
.declared { color: var(--warn); }
.xfer-tag { font-size: 22rpx; color: #1677FF; background: #E6F4FF; border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 12rpx; }
.cash-tag { font-size: 22rpx; color: var(--warn); background: var(--warn-bg); border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 12rpx; }

/* 骨架屏（.sk 基类在 app.wxss） */
.sk-l1 { height: 34rpx; width: 55%; margin-bottom: 18rpx; }
.sk-l2 { height: 24rpx; width: 80%; }
/* 「未收到」「确认收到」两个按钮大小一致 */
button.r-op:not([size=mini]) { width: 160rpx; padding: 0; margin-left: 24rpx; }

.long-tip { padding: 0 0 24rpx; }
/* 回到顶部：浮在右下，避开底部菜单与安全区 */
.to-top { position: fixed; right: 24rpx; bottom: calc(50px + env(safe-area-inset-bottom) + 24rpx); z-index: 4; padding: 0 28rpx; line-height: 72rpx; border-radius: 36rpx; background: #fff; color: var(--primary); font-size: 26rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .18); }
.amended { color: var(--primary); }
.r-tags { display: flex; flex-wrap: wrap; font-size: 24rpx; line-height: 1.5; margin-top: 4rpx; }
.r-tg { margin-right: 20rpx; padding: 4rpx 0; }
.amend-tip { margin-bottom: 16rpx; }
.small { font-size: 24rpx; }

/* 修改弹层：本页是 tab 页，自定义底部菜单盖在弹层之上，遮罩止于菜单上沿，「取消 / 保存」不再被挡住（同往来页） */
.mask.tab-mask { bottom: calc(50px + env(safe-area-inset-bottom)); }
.sheet.tab-sheet { max-height: 86vh; padding-bottom: 32rpx; }
.corr-seg { margin: 12rpx 0 16rpx; background: var(--fill, #f5f5f5); }
/* 「有改动」：改动类型标签与改动前后的值 */
.chg-row { display: flex; align-items: baseline; margin-bottom: 8rpx; font-size: 24rpx; line-height: 1.5; }
.chg-tag { flex-shrink: 0; margin-right: 12rpx; padding: 2rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; color: #fff; background: var(--primary); white-space: nowrap; }
.chg-tag.warn { background: var(--warn, #C25E00); }
.chg-tag.bad { background: var(--danger, #FA5151); }
.chg-tag.gray { background: #999; }
.chg-text { flex: 1; min-width: 0; color: #444; word-break: break-all; }
.chg-more { flex-shrink: 0; color: #888; white-space: nowrap; }
