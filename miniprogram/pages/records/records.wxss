.sum-row { display: flex; justify-content: space-between; align-items: flex-start; }
.sum { font-size: 60rpx; margin: 8rpx 0; }
.pending-hint { color: #FF9F1C; }
.filters { display: flex; gap: 12rpx; }
.filter {
  padding: 8rpx 24rpx; border-radius: 999rpx;
  background: #f2f3f5; color: #666; font-size: 26rpx;
}
.filter.on { background: #07C160; color: #fff; }
.search-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.search {
  flex: 1; background: #f2f3f5;
  border-radius: 999rpx; padding: 16rpx 28rpx;
}
.export-btn {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  border: 2rpx solid #07C160; color: #07C160; font-size: 26rpx;
}
.record.transferred { border-left: 8rpx solid #FF9F1C; }
.record.pending { opacity: .7; }
.r-top { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.payer { font-weight: 600; }
.r-amount { font-size: 34rpx; }
.r-actions {
  display: flex; align-items: center; gap: 24rpx;
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}
.flex1 { flex: 1; }
.badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
.badge.ok { background: #07C16022; color: #07C160; }
.badge.warn { background: #FF9F1C22; color: #FF9F1C; }
.badge.gray { background: #eee; color: #999; }
.link { color: #2B7FFF; font-size: 26rpx; }
.link.danger { color: #FA5151; }
.btn-confirm {
  margin: 0; padding: 0 28rpx; line-height: 60rpx; height: 60rpx;
  font-size: 26rpx; background: #07C160; color: #fff; border-radius: 8rpx;
}
.pad { padding: 40rpx 0; }
