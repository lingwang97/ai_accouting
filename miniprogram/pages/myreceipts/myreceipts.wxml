<view class="container">
  <view class="card item" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOpen">
    <view class="top">
      <text class="shop">{{item.accountName || '主家'}}<text class="muted" wx:if="{{item.themeName}}"> · {{item.themeName}}</text></text>
      <text class="money">￥{{item.amountStr}}</text>
    </view>
    <view class="muted">{{item.timeStr}} · 随礼人 {{item.payerName}}<text wx:if="{{item.proxyStr}}">（代 {{item.proxyStr}}）</text></view>
    <view class="link">查看回执 ›</view>
  </view>
  <view class="muted center pad" wx:if="{{!loading && list.length === 0}}">暂无随礼记录，主家确认收到后自动生成回执</view>
  <view class="muted center pad" wx:if="{{loading}}">加载中…</view>
</view>
