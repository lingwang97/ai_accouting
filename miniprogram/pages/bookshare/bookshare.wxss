.intro { line-height: 1.7; }
.em { color: #333; font-weight: 600; }
.book-row { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 8rpx; border-bottom: 2rpx solid #f5f5f5; }
.book-row:last-child { border-bottom: none; }
.check {
  width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; border: 2rpx solid #ccc;
  text-align: center; color: #fff; font-size: 24rpx; flex-shrink: 0;
}
.check.on { background: var(--primary); border-color: var(--primary); }
.b-info { flex: 1; }
.small { font-size: 22rpx; }
.center { text-align: center; }
.share-desc { background: #fff; border-radius: 12rpx; padding: 18rpx 22rpx; font-size: 26rpx; color: #555; margin-bottom: 20rpx; line-height: 1.6; }
.hint { text-align: center; margin: 16rpx 0; line-height: 1.6; }
.v-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.v-row:last-child { border-bottom: none; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.v-info { flex: 1; min-width: 0; }
.link { color: #576B95; font-size: 26rpx; white-space: nowrap; }
.link.danger { color: #FA5151; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, .5); display: flex; align-items: flex-end; z-index: 10; }
.editor { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.ed-title { font-size: 32rpx; font-weight: 700; margin-bottom: 12rpx; }
.ed-list { max-height: 600rpx; }
.ed-ops { display: flex; gap: 20rpx; margin-top: 20rpx; }
.ed-btn { flex: 1; font-size: 30rpx; }
.ed-btn.ok { background: var(--primary); color: #fff; }
