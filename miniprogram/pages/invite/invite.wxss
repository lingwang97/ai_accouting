.box { padding: 56rpx 36rpx; margin-top: 60rpx; }
.seal {
  width: 120rpx; height: 120rpx; margin: 0 auto 32rpx;
  border: 5rpx solid #3A3A3A; border-radius: 14rpx; padding: 7rpx; box-sizing: border-box;
  transform: rotate(-6deg);
}
.seal-inner {
  width: 100%; height: 100%; box-sizing: border-box; border: 2rpx solid #3A3A3A; border-radius: 7rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 66rpx; font-weight: 700; color: #3A3A3A; font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.title { font-size: 36rpx; font-weight: 700; color: #333; margin-bottom: 12rpx; }
.from { margin-bottom: 24rpx; }
.desc { text-align: left; line-height: 1.7; margin-bottom: 36rpx; }
.err { color: var(--danger); margin: 24rpx 0; }
.books { text-align: left; background: #F7F7F7; border-radius: 12rpx; padding: 8rpx 20rpx; margin-bottom: 20rpx; }
.bk { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 28rpx; }
.dn { text-align: left; margin-bottom: 28rpx; }
.dn-label { color: var(--text-2); font-size: 26rpx; margin-bottom: 10rpx; }
/* 记账人邀请：授予的权限（不用 flex gap，用外边距） */
.perm-label { text-align: left; font-size: 24rpx; margin-bottom: 10rpx; }
.perms { display: flex; flex-wrap: wrap; margin: 0 -12rpx 12rpx 0; text-align: left; }
.perm { font-size: 24rpx; color: #555; background: var(--fill); border-radius: 999rpx; padding: 6rpx 20rpx; margin: 0 12rpx 12rpx 0; }
.req { color: var(--danger); }
