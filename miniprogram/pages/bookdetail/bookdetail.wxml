<!-- 加载中 / 加载失败（点击重试） -->
<view class="state-box" wx:if="{{!book}}" style="{{themeStyle}}">
  <view class="muted" wx:if="{{!loadError}}">加载中…</view>
  <view wx:else bindtap="onRetry">
    <view class="muted">礼簿加载失败</view>
    <view class="retry">点击重试</view>
  </view>
</view>
<view class="container" wx:if="{{book}}" style="{{themeStyle}}">
  <view class="card head">
    <view class="muted">{{typeLabel}} · {{book.date || '未设日期'}}<text wx:if="{{book.location}}"> · {{book.location}}</text></view>
    <view class="sum money">￥{{sum}}</view>
    <view class="kpis">
      <view class="kpi"><view class="k-num">{{count}}</view><view class="muted">份</view></view>
      <view class="kpi"><view class="k-num">{{avg}}</view><view class="muted">平均（元）</view></view>
      <view class="kpi"><view class="k-num">{{maxAmount}}</view><view class="muted">单份最高（元）</view></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">按方式统计 <text class="muted">（便于与现金点数核对）</text></view>
    <view class="rel-top"><text>微信转账</text><text><text class="muted">{{wechatCount}} 份 · </text>￥{{wechatSum}}</text></view>
    <view class="rel-top"><text>💵 现金</text><text><text class="muted">{{cashCount}} 份 · </text>￥{{cashSum}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">按关系统计</view>
    <view class="rel" wx:for="{{byRelation}}" wx:key="relation">
      <view class="rel-top">
        <text>{{item.relation}}</text>
        <text><text class="muted">{{item.count}} 份 · </text>￥{{item.sumStr}}</text>
      </view>
      <view class="bar-bg"><view class="bar" style="width:{{item.pct}}%"></view></view>
    </view>
    <view class="muted" wx:if="{{byRelation.length === 0}}">暂无已入簿的礼金</view>
  </view>

  <button wx:if="{{orgMode && pm.show}}" class="btn-primary" style="margin-bottom:24rpx" bindtap="goBookQr">本场礼簿码（双码展示 / 台卡）</button>
  <button class="btn-primary" bindtap="goRecords">查看礼金明细</button>
  <button class="btn-plain" style="margin-top:24rpx" wx:if="{{canExport}}" bindtap="goExport">导出本礼簿</button>
  <button class="btn-plain" style="margin-top:24rpx" wx:if="{{book.archivePdf || (!readonly && pm.books)}}" bindtap="onArchivePdf">{{book.archivePdf ? '查看存档 PDF' : '生成存档 PDF（长期保留）'}}</button>
</view>
