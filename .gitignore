# 依赖：云函数由部署时（--r）在云端安装，本地不需要
node_modules/
# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.bak
*.orig
# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
